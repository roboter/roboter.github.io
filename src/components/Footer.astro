---
import config from '@config/config.json';
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-screen-lg px-4 sm:px-6 lg:px-8 mt-8">
  <div class="border-t border-zinc-200/80 dark:border-zinc-800/80 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-400">
    <div class="flex flex-col sm:flex-row items-center gap-2 text-center sm:text-left">
      <span class="font-semibold text-zinc-700 dark:text-zinc-300">{config.site.title}</span>
      <span class="hidden sm:inline text-zinc-300 dark:text-zinc-700">·</span>
      <span>&copy; {year} Robby roboter. Hardware, Embedded &amp; Open Source.</span>
    </div>

    <nav aria-label="Footer navigation" class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
      <a href="/blog/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Blog
      </a>
      <a href="/videos/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Videos
      </a>
      <a href="/software/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Software
      </a>
      <a href="/tools/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Tools
      </a>
      <a href="/categories/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        Categories
      </a>
      <a href="/about/" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        About
      </a>
      <a href="/rss.xml" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        RSS
      </a>
    </nav>
  </div>
</footer>
