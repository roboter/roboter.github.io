---
import { Image } from 'astro:assets';
import menu from '@config/menu.json';
import config from '@config/config.json';
import HamburgerIcon from '@icons/HamburgerIcon.astro';
import CloseIcon from '@icons/CloseIcon.astro';
import HomeIcon from '@icons/HomeIcon.astro';
import ThemeIcon from '@components/ThemeIcon.astro';
import robotFaceLogo from '../assets/robot_face_logo.png';

export interface NavigationLink {
  name: string;
  url: string;
}

const { main }: { main: NavigationLink[] } = menu;
---

<header class="sticky top-0 z-40 bg-zinc-50/80 dark:bg-zinc-900/80 backdrop-blur-xl backdrop-saturate-150 border-b border-zinc-200/50 dark:border-zinc-800/50 transition-colors duration-200">
  <div class="mx-auto max-w-screen-lg px-4 py-3 sm:px-6 sm:py-3.5 lg:px-8">
    <div class="flex items-center justify-between gap-3 sm:gap-4">
      <a
        href="/"
        class="flex items-center gap-2.5 font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight active:scale-95 transition-transform"
        aria-label="Home"
      >
        <Image
          src={robotFaceLogo}
          alt="Logo"
          width={32}
          height={32}
          class="h-8 w-8 rounded-full shadow-sm ring-1 ring-zinc-900/10 dark:ring-white/10"
        />
        <span class="font-bold text-base hidden sm:inline-block tracking-tight">{config.site.title}</span>
      </a>

      <div class="flex items-center gap-2 md:gap-3 ml-auto">
        <ul class="hidden items-center gap-1 md:flex">
          {main?.map((item) => (
            <li>
              <a
                href={item?.url}
                class="inline-flex items-center rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-600 hover:text-zinc-900 hover:bg-zinc-200/50 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/50 transition-all active:scale-95"
              >
                {item?.name === 'Home' ? <HomeIcon /> : item?.name}
              </a>
            </li>
          ))}
        </ul>

        {config.features.dark_mode && <ThemeIcon />}

        <!-- navbar toggler for mobile -->
        <div class="relative flex md:hidden">
          <input id="nav-toggle" type="checkbox" class="hidden" />
          <label
            id="show-button"
            for="nav-toggle"
            class="flex cursor-pointer items-center justify-center h-9 w-9 rounded-full text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/50 dark:hover:bg-zinc-800/50 active:scale-95 transition-all md:hidden"
            aria-label="Open menu"
          >
            <HamburgerIcon />
          </label>
          <label
            id="hide-button"
            for="nav-toggle"
            class="hidden cursor-pointer items-center justify-center h-9 w-9 rounded-full text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/50 dark:hover:bg-zinc-800/50 active:scale-95 transition-all"
            aria-label="Close menu"
          >
            <CloseIcon />
          </label>
          <div
            id="nav-menu"
            class="absolute right-0 top-11 z-50 mt-1 hidden w-48 rounded-2xl border border-zinc-200/70 bg-white/90 p-2 shadow-xl backdrop-blur-xl backdrop-saturate-150 dark:border-zinc-800/80 dark:bg-zinc-900/90"
          >
            <ul class="space-y-1 py-1 text-sm text-zinc-700 dark:text-zinc-200">
              {main?.map((item) => (
                <li>
                  <a
                    href={item?.url}
                    class="block rounded-xl px-3.5 py-2 text-sm font-medium text-zinc-600 hover:bg-zinc-100/80 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/80 dark:hover:text-zinc-100 transition-colors active:scale-95"
                  >
                    {item?.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
