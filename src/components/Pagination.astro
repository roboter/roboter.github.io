---
import NextIcon from '@icons/NextIcon.astro';
import PrevIcon from '@icons/PrevIcon.astro';

const { length, currentPage, firstUrl, prevUrl, nextUrl } = Astro.props;
const paginationList = Array.from({ length }, (_, i) => i + 1);
---

<nav class="mt-12" aria-label="Pagination">
  <ol class="flex justify-center items-center gap-2 text-sm font-medium">
    {prevUrl ? (
      <li>
        <a
          href={prevUrl}
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200/80 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 text-zinc-700 hover:text-zinc-900 hover:border-zinc-300 dark:text-zinc-300 dark:hover:text-white dark:hover:border-zinc-700 rtl:rotate-180 transition-all active:scale-95 shadow-sm"
        >
          <span class="sr-only">Prev Page</span>
          <PrevIcon />
        </a>
      </li>
    ) : null}
    {paginationList?.map((num) => {
      const active = currentPage == num;
      return (
        <li>
          <a
            href={`${firstUrl}${num == 1 ? '' : '' + num}`}
            aria-current={active ? 'page' : undefined}
            class={`inline-flex h-10 min-w-[2.5rem] px-3 items-center justify-center rounded-xl border transition-all active:scale-95 ${
              active
                ? 'border-emerald-600 bg-emerald-600 text-white font-semibold shadow-sm'
                : 'border-zinc-200/80 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 text-zinc-700 hover:text-zinc-900 hover:border-zinc-300 dark:text-zinc-300 dark:hover:text-white dark:hover:border-zinc-700 shadow-sm'
            }`}
          >
            {num}
          </a>
        </li>
      );
    })}
    {nextUrl ? (
      <li>
        <a
          href={nextUrl}
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200/80 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 text-zinc-700 hover:text-zinc-900 hover:border-zinc-300 dark:text-zinc-300 dark:hover:text-white dark:hover:border-zinc-700 rtl:rotate-180 transition-all active:scale-95 shadow-sm"
        >
          <span class="sr-only">Next Page</span>
          <NextIcon />
        </a>
      </li>
    ) : null}
  </ol>
</nav>
