---
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import FeaturedVideos from "@components/FeaturedVideos.astro";
import Footer from "@components/Footer.astro";
import config from "@config/config.json";

import "@styles/global.css";

import { ClientRouter } from "astro:transitions";

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  blogpost?: boolean;
  hideHero?: boolean;
  hideVideos?: boolean;
  fullWidth?: boolean;
  filterTag?: string;
}

const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  blogpost,
  hideHero = false,
  hideVideos = false,
  fullWidth = false,
  filterTag,
} = Astro.props;

const siteUrl = config.site.base_url.replace(/\/+$/, "");
const cleanPath = Astro.url.pathname.replace(/^\/+/, "");
const canonicalUrl = canonical
  ? canonical
  : cleanPath
  ? `${siteUrl}/${cleanPath}`
  : `${siteUrl}/`;

const siteTitle = config.site.title || "Robby roboter Blog";
const rawTitle = meta_title || title || siteTitle;
const displayTitle =
  rawTitle === siteTitle || rawTitle.includes("Robby roboter")
    ? rawTitle
    : `${rawTitle} · Robby roboter`;

const metaDescription = description || config.metadata.meta_description;

const resolvedOgImage = image
  ? image.startsWith("http")
    ? image
    : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`
  : `${siteUrl}/blog-placeholder.jpg`;
---

<!doctype html>
<html lang={config.site.lang || "en"}>
  <head>
    <meta name="google-adsense-account" content="ca-pub-6551517940732120" />
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="bookworm-light-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <title>{displayTitle}</title>
    <meta name="title" content={displayTitle} />
    <link rel="canonical" href={canonicalUrl} item-prop="url" />

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <meta name="description" content={metaDescription} />
    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={blogpost ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content={siteTitle} />
    {blogpost && <meta property="article:author" content={config.author.name} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Telegram & Social -->
    <meta name="telegram:username" content="@robby_roboter" />
    <meta name="telegram:contact" content="https://t.me/robby_roboter" />

    <!-- RSS auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.site.title}
      href="/rss.xml"
    />

    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": `${siteUrl}/#website`,
            "url": `${siteUrl}/`,
            "name": "Robby roboter",
            "description": config.metadata.meta_description,
            "publisher": {
              "@id": `${siteUrl}/#person`
            },
            "inLanguage": config.site.lang || "en"
          },
          {
            "@type": "Person",
            "@id": `${siteUrl}/#person`,
            "name": "Robby roboter",
            "url": `${siteUrl}/`,
            "image": config.author.avatar,
            "sameAs": [
              "https://www.youtube.com/@robby.roboter",
              "https://github.com/roboter/",
              "https://x.com/robby_roboter",
              "https://www.linkedin.com/in/roboter/",
              "https://t.me/robby_roboter"
            ],
            "jobTitle": "Maker, Electronics Engineer & YouTuber",
            "description": config.author.bio
          }
        ]
      })}
    />

    <ClientRouter />
  </head>
  <body class="bg-white dark:bg-zinc-900/95">
    <Header />
    {!blogpost && !hideHero && <Hero />}
    <main class={fullWidth ? "w-full" : "mx-auto max-w-screen-lg px-4 py-8 sm:px-6 sm:py-12 lg:px-8"}>
      <slot />
    </main>
    {!blogpost && !hideVideos && config.features.youtube && (
      <FeaturedVideos filterTag={filterTag} limit={3} showAllButton={true} />
    )}
    <Footer />
    <script>
      // This is a hack to get vite-plugin-pwa to generate a sw.js file.
      // Do not remove this script tag.
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4C208KCFYB"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4C208KCFYB');
    </script>
  </body>
</html>
