---
import Base from '@layouts/Base.astro';
import config from '@config/config.json';
import { tagToSlug } from '@utils/taxonomy';
import { allVideos, getSimilarVideos, type YouTubeVideo } from '../../utils/videos';
import { Play, ArrowLeft, Clock, Eye, Calendar, Sparkles, ExternalLink, Tag, Youtube } from 'lucide-react';

export async function getStaticPaths() {
  return allVideos.map((video) => {
    const similarVideos = getSimilarVideos(video, allVideos, 3);
    return {
      params: { id: video.videoId },
      props: { video, similarVideos },
    };
  });
}

interface Props {
  video: YouTubeVideo;
  similarVideos: YouTubeVideo[];
}

const { video, similarVideos } = Astro.props;

const pageTitle = `${video.title} — Video Tutorial`;
const pageDescription =
  video.description ||
  `Watch ${video.title} directly on Robby roboter. Hands-on hardware tutorial and embedded engineering guide.`;
const ogImage = `https://i.ytimg.com/vi/${video.videoId}/hqdefault.jpg`;
const currentUrl = `https://begemotik.ee/videos/${video.videoId}/`;
---

<Base
  title={pageTitle}
  meta_title={pageTitle}
  description={pageDescription}
  image={ogImage}
  hideHero={true}
  hideVideos={true}
>
  <!-- Schema.org VideoObject Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: video.title,
      description: pageDescription,
      thumbnailUrl: [ogImage],
      uploadDate: video.published || '2024-01-01',
      duration: video.duration ? `PT${video.duration.replace(':', 'M')}S` : undefined,
      embedUrl: `https://www.youtube.com/embed/${video.videoId}`,
      contentUrl: currentUrl,
      author: {
        '@type': 'Person',
        name: config.author.name,
        url: 'https://begemotik.ee/',
      },
      publisher: {
        '@type': 'Person',
        name: config.author.name,
      },
    })}
  ></script>
  <div class="py-4 max-w-5xl mx-auto">
    <!-- TOP BAR: BREADCRUMBS & BACK LINK -->
    <div class="flex items-center justify-between gap-4 mb-6">
      <a
        href="/videos"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white bg-zinc-100 hover:bg-zinc-200/80 dark:bg-zinc-800 dark:hover:bg-zinc-700 transition-all active:scale-95"
      >
        <ArrowLeft className="w-3.5 h-3.5" />
        <span>All Videos</span>
      </a>

      <div class="flex items-center gap-2">
        <a
          href={`https://www.youtube.com/watch?v=${video.videoId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-red-600 dark:text-red-400 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 transition-all"
        >
          <span>Watch on YouTube</span>
          <ExternalLink className="w-3 h-3" />
        </a>
      </div>
    </div>

    <!-- MAIN VIDEO CARD BLOCK (TITLE, VIDEO PLAYER, META & TOPICS) -->
    <div class="rounded-3xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xl p-6 sm:p-8 mb-12 shadow-sm">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight mb-6">
        {video.title}
      </h1>

      <!-- EMBEDDED VIDEO PLAYER INSIDE BLOCK (DIRECTLY AFTER TITLE) -->
      <div
        class="video-wrapper relative w-full aspect-video rounded-2xl overflow-hidden bg-black shadow-xl ring-1 ring-zinc-900/10 dark:ring-white/10 mb-6"
        style="aspect-ratio: 16 / 9; min-height: 240px;"
      >
        <iframe
          src={`https://www.youtube.com/embed/${video.videoId}?rel=0`}
          title={video.title}
          width="100%"
          height="100%"
          class="absolute inset-0 w-full h-full border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="eager"
        ></iframe>
      </div>

      <!-- Stats Bar (Under the Video: Views, Length / Duration, Published Date) -->
      <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 pb-5 mb-5 border-b border-zinc-100 dark:border-zinc-800/80">
        {video.views && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 font-medium text-zinc-700 dark:text-zinc-300">
            <Eye className="w-3.5 h-3.5 text-zinc-400" />
            <span>{video.views}</span>
          </span>
        )}

        {video.duration && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 font-mono text-zinc-700 dark:text-zinc-300">
            <Clock className="w-3.5 h-3.5 text-zinc-400" />
            <span>{video.duration}</span>
          </span>
        )}

        {video.published && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
            <Calendar className="w-3.5 h-3.5 text-zinc-400" />
            <span>{video.published}</span>
          </span>
        )}
      </div>

      <!-- Topic Tags -->
      {video.tags && video.tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-mono text-zinc-400 flex items-center gap-1">
            <Tag className="w-3 h-3" />
            <span>Topics:</span>
          </span>
          {video.tags.map((rawTag) => (
            <a
              href={`/categories?tag=${tagToSlug(rawTag)}`}
              class="inline-flex items-center rounded-lg bg-zinc-100 hover:bg-zinc-200/80 dark:bg-zinc-800 dark:hover:bg-zinc-700 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:text-zinc-300 transition-colors"
            >
              #{rawTag}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- SIMILAR VIDEOS SECTION (3 VIDEOS DIRECTLY BELOW) -->
    <section class="mt-8 pt-8 border-t border-zinc-200/80 dark:border-zinc-800/80">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-red-500/10 text-red-600 dark:text-red-400">
            <Sparkles className="w-4 h-4" />
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              Similar Videos
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Recommended next watches based on related hardware &amp; topic tags
            </p>
          </div>
        </div>

        <a
          href="/videos"
          class="text-xs font-semibold text-zinc-600 hover:text-red-600 dark:text-zinc-400 dark:hover:text-red-400 transition-colors"
        >
          View all {allVideos.length} videos →
        </a>
      </div>

      <!-- 3 Video Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {similarVideos.map((item) => (
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 hover:border-red-500/50 dark:hover:border-red-500/40 shadow-sm hover:shadow-xl hover:shadow-red-500/5 transition-all duration-300 hover:-translate-y-1">
            <div>
              <!-- Clickable Thumbnail -->
              <a
                href={`/videos/${item.videoId}/`}
                class="relative aspect-video w-full overflow-hidden bg-zinc-950 rounded-t-2xl block cursor-pointer"
                aria-label={`Play: ${item.title}`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${item.videoId}/hqdefault.jpg`}
                  alt={item.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                  <div class="w-11 h-11 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-lg opacity-85 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300">
                    <Play className="w-4 h-4 fill-current ml-0.5" />
                  </div>
                </div>
                {item.duration && (
                  <span class="absolute bottom-2 right-2 px-2 py-0.5 text-[10px] font-mono font-medium text-white bg-black/85 backdrop-blur-md rounded">
                    {item.duration}
                  </span>
                )}
              </a>

              <!-- Title -->
              <div class="p-4">
                <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors line-clamp-2 leading-snug">
                  <a href={`/videos/${item.videoId}/`} class="hover:underline">
                    {item.title}
                  </a>
                </h3>

                {item.tags && item.tags.length > 0 && (
                  <div class="relative z-20 mt-2.5 flex flex-wrap gap-1">
                    {item.tags.slice(0, 3).map((t) => (
                      <a
                        href={`/categories?tag=${tagToSlug(t)}`}
                        class="inline-block px-1.5 py-0.5 rounded text-[10px] font-medium bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-600 hover:text-red-600 dark:text-zinc-400 dark:hover:text-red-400 transition-colors"
                      >
                        #{t}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>

            <!-- Card Footer -->
            <div class="px-4 pb-4 pt-2 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
              <span>{item.views}</span>
              <a
                href={`/videos/${item.videoId}/`}
                class="text-red-600 dark:text-red-400 font-semibold hover:underline flex items-center gap-1"
              >
                <span>Play</span>
                <Play className="w-2.5 h-2.5 fill-current" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>
