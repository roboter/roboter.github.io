---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Posts from '@layouts/Posts.astro';
import Pagination from '@components/Pagination.astro';
import config from '@config/config.json';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totalPages = Math.ceil(posts.length / config.site.pageSize);
---

<Base
  meta_title="Robby roboter — Hardware, Electronics & Embedded Engineering"
  description="Explore hardware deep-dives, microcontroller tutorials (Arduino, STM32, ESP32, WCH), desktop engineering software, and interactive web tools by Robby roboter."
>
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3 border-b border-zinc-200/80 dark:border-zinc-800/80 pb-5">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 mb-2.5">
        <span>Articles &amp; Notes • {posts.length} Published</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Latest Articles</h2>
    </div>
    <a
      href="/categories/"
      class="text-sm font-medium text-zinc-600 hover:text-emerald-600 dark:text-zinc-400 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1"
    >
      <span>Browse all topics</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
  <Posts posts={posts} />
  {totalPages > 1 && (
    <Pagination
      length={totalPages}
      currentPage={1}
      firstUrl="/blog/"
      prevUrl={null}
      nextUrl={totalPages > 1 ? '/blog/2' : null}
    />
  )}
</Base>
