                    <a
                      href={tool.toolUrl}
                      class="aspect-video w-full overflow-hidden bg-zinc-950 relative block cursor-pointer"
                      aria-label={tool.title}
                    >
                      <img
                        src={tool.previewImage}
                        alt={tool.title}
                        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                      <span class="absolute top-2.5 right-2.5 px-2 py-0.5 text-[10px] font-mono font-medium rounded-full bg-zinc-900/80 text-white backdrop-blur-md border border-white/10">
                        {tool.statusBadge}
                      </span>
                    </a>
                  )}
                  <div class="p-5 pb-0">
                    <div class="flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1.5">
                      <Wrench className="w-3.5 h-3.5" />
                      <span>{tool.category}</span>
                    </div>
                    <h3 class="text-base sm:text-lg font-semibold leading-snug tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                      <a href={tool.toolUrl} class="hover:underline">
                        {tool.title}
                      </a>
                    </h3>
                    <p class="mt-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">{tool.tagline}</p>
                    <p class="mt-2 line-clamp-2 text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                      {tool.shortDescription}
                    </p>
                  </div>
                </div>

                <div class="p-5 pt-4 flex flex-col gap-3">
                  {tool.tags && tool.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {tool.tags.slice(0, 3).map((rawTag: string) => (
                        <button
                          type="button"
                          data-tag-trigger={tagToSlug(rawTag)}
                          class="tag-trigger-btn rounded-lg bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-[11px] font-medium text-zinc-600 dark:text-zinc-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-500/10 transition-colors cursor-pointer"
                        >
                          #{rawTag}
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="pt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs">
                    <span class="text-zinc-400 dark:text-zinc-500 font-mono">Web Tool</span>
                    <a
                      href={tool.toolUrl}
                      class="inline-flex items-center gap-1 font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
                    >
                      <span>Launch</span>
                      <span class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>

      <!-- Tag Empty State -->
      <div
        id="tag-no-items-state"
        class="hidden rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/70 dark:bg-zinc-900/50 text-center py-12 px-6"
      >
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4">
          No articles, videos, software, or tools found for this topic tag.
        </p>
        <button
          type="button"
          id="empty-clear-filter-btn"
          class="inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-xs font-semibold bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 hover:opacity-90 transition-opacity cursor-pointer"
        >
          <RotateCcw className="w-3.5 h-3.5" />
          <span>Show all topics</span>
        </button>
      </div>
    </div>
  </div>
</Base>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  @media (prefers-reduced-transparency: reduce) {
    nav[aria-label='Category filter'],
    section[data-enter],
    #topic-explorer {
      backdrop-filter: none;
      background-color: rgb(255 255 255 / 0.98);
    }
    :global(.dark) nav[aria-label='Category filter'],
    :global(.dark) section[data-enter],
    :global(.dark) #topic-explorer {
      background-color: rgb(24 24 27 / 0.98);
    }
  }
</style>

<script>
  function setupCategoriesAndTags() {
    const INITIAL_VISIBLE_TAGS = 16;

    const categoryPills = document.querySelectorAll<HTMLElement>('.category-pill');
    const categorySections = document.querySelectorAll<HTMLElement>('.category-section');
    const categoriesContainer = document.getElementById('categories-container');
    const tagResultsContainer = document.getElementById('tag-results-container');
    const activeFilterBar = document.getElementById('active-filter-bar');
    const activeFilterLabel = document.getElementById('active-filter-label');
    const activeFilterCounts = document.getElementById('active-filter-counts');
    const clearFilterBtn = document.getElementById('clear-filter-btn');
    const emptyClearFilterBtn = document.getElementById('empty-clear-filter-btn');

    // Tag Cloud Elements
    const topicExplorer = document.getElementById('topic-explorer');
    const tagSearchInput = document.getElementById('tag-search-input') as HTMLInputElement | null;
    const tagSearchClear = document.getElementById('tag-search-clear');
    const tagSearchKbd = document.getElementById('tag-search-kbd');
    const resetTagSearchBtn = document.getElementById('reset-tag-search-btn');
    const tagFilterBtns = document.querySelectorAll<HTMLElement>('.tag-filter-btn');
    const statFilterCards = document.querySelectorAll<HTMLElement>('.stat-filter-card');
    const tagCloudChips = document.querySelectorAll<HTMLElement>('.tag-cloud-chip');
    const tagActiveCountEl = document.getElementById('tag-active-count');
    const tagEmptyState = document.getElementById('tag-empty-state');
    const tagsToggleWrap = document.getElementById('tags-toggle-wrap');
    const toggleAllTagsBtn = document.getElementById('toggle-all-tags-btn');
    const toggleAllTagsLabel = document.getElementById('toggle-all-tags-label');
    const toggleAllTagsIcon = document.getElementById('toggle-all-tags-icon');

    // Tag Results Elements
    const tagResultsTitle = document.getElementById('tag-results-title');
    const tagArticleCountBadge = document.getElementById('tag-article-count-badge');
    const tagVideoCountBadge = document.getElementById('tag-video-count-badge');
    const tagSoftwareCountBadge = document.getElementById('tag-software-count-badge');
    const tagToolCountBadge = document.getElementById('tag-tool-count-badge');
    const tagArticlesSection = document.getElementById('tag-articles-section');
    const tagVideosSection = document.getElementById('tag-videos-section');
    const tagSoftwareSection = document.getElementById('tag-software-section');
    const tagToolsSection = document.getElementById('tag-tools-section');
    const tagNoItemsState = document.getElementById('tag-no-items-state');
    const tagPostCards = document.querySelectorAll<HTMLElement>('.tag-post-card');
    const tagVideoCards = document.querySelectorAll<HTMLElement>('.tag-video-card');
    const tagSoftwareCards = document.querySelectorAll<HTMLElement>('.tag-software-card');
    const tagToolCards = document.querySelectorAll<HTMLElement>('.tag-tool-card');

    let currentTagTypeFilter = 'all';
    let showAllTags = false;

    const ACTIVE_PILL_CLASSES = ['bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900', 'shadow-sm'];
    const INACTIVE_PILL_CLASSES = [
      'bg-zinc-100/90',
      'text-zinc-700',
      'dark:bg-zinc-800/80',
      'dark:text-zinc-300',
    ];
    const ACTIVE_TYPE_CLASSES = ['active', 'bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900'];
    const INACTIVE_TYPE_CLASSES = ['bg-white', 'dark:bg-zinc-800/60', 'text-zinc-600', 'dark:text-zinc-400'];
    const ACTIVE_CHIP_CLASSES = [
      'ring-2',
      'ring-emerald-500',
      'bg-emerald-500/10',
      'dark:bg-emerald-500/15',
      'border-emerald-500',
    ];

    function setActiveTypeFilter(type: string) {
      currentTagTypeFilter = type;

      tagFilterBtns.forEach((b) => {
        const isMatch = (b.getAttribute('data-filter') || 'all') === type;
        b.setAttribute('aria-pressed', String(isMatch));
        b.classList.remove(...(isMatch ? INACTIVE_TYPE_CLASSES : ACTIVE_TYPE_CLASSES));
        b.classList.add(...(isMatch ? ACTIVE_TYPE_CLASSES : INACTIVE_TYPE_CLASSES));
      });

      updateTagCloud();
    }

    // 1. Tag Cloud Search, Type Filter & Expand/Collapse
    function updateTagCloud() {
      const query = (tagSearchInput?.value || '').toLowerCase().trim();
      const hasQueryOrType = query.length > 0 || currentTagTypeFilter !== 'all';

      if (tagSearchClear) {
        tagSearchClear.classList.toggle('hidden', query.length === 0);
        tagSearchClear.classList.toggle('inline-flex', query.length > 0);
      }
      if (tagSearchKbd) {
        tagSearchKbd.classList.toggle('hidden', query.length > 0);
      }

      let visibleCount = 0;

      tagCloudChips.forEach((chip, idx) => {
        const name = chip.getAttribute('data-tag-name') || '';
        const slug = chip.getAttribute('data-tag-slug') || '';

        const matchesQuery = !query || name.includes(query) || slug.includes(query);

        let matchesType = true;
        if (currentTagTypeFilter === 'article') {
          matchesType = chip.getAttribute('data-has-article') === 'true';
        } else if (currentTagTypeFilter === 'video') {
          matchesType = chip.getAttribute('data-has-video') === 'true';
        } else if (currentTagTypeFilter === 'software') {
          matchesType = chip.getAttribute('data-has-software') === 'true';
        } else if (currentTagTypeFilter === 'tool') {
          matchesType = chip.getAttribute('data-has-tool') === 'true';
        }

        const withinInitialLimit = hasQueryOrType || showAllTags || idx < INITIAL_VISIBLE_TAGS;
        const isVisible = matchesQuery && matchesType && withinInitialLimit;

        chip.classList.toggle('hidden', !isVisible);
        chip.classList.toggle('inline-flex', isVisible);
        if (isVisible) visibleCount++;
      });

      if (tagsToggleWrap) {
        tagsToggleWrap.classList.toggle('hidden', hasQueryOrType);
      }
      if (toggleAllTagsBtn) {
        toggleAllTagsBtn.setAttribute('aria-expanded', String(showAllTags));
      }
      if (toggleAllTagsLabel) {
        toggleAllTagsLabel.textContent = showAllTags
          ? 'Show fewer tags'
          : `Show all ${tagCloudChips.length} tags`;
      }
      if (toggleAllTagsIcon) {
        toggleAllTagsIcon.classList.toggle('rotate-180', showAllTags);
      }

      if (tagActiveCountEl) tagActiveCountEl.textContent = String(visibleCount);
      if (tagEmptyState) {
        tagEmptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    if (tagSearchInput) {
      tagSearchInput.addEventListener('input', updateTagCloud);
    }

    if (tagSearchClear && tagSearchInput) {
      tagSearchClear.addEventListener('click', () => {
        tagSearchInput.value = '';
        updateTagCloud();
        tagSearchInput.focus();
      });
    }

    if (resetTagSearchBtn && tagSearchInput) {
      resetTagSearchBtn.addEventListener('click', () => {
        tagSearchInput.value = '';
        setActiveTypeFilter('all');
      });
    }

    if (toggleAllTagsBtn) {
      toggleAllTagsBtn.addEventListener('click', () => {
        showAllTags = !showAllTags;
        updateTagCloud();
      });
    }

    tagFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActiveTypeFilter(btn.getAttribute('data-filter') || 'all');
      });
    });

    statFilterCards.forEach((card) => {
      card.addEventListener('click', () => {
        const type = card.getAttribute('data-stat-filter') || 'all';
        setActiveTypeFilter(type);
        topicExplorer?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    // 2. Set Active Category Filter
    function setCategoryFilter(slug: string, updateUrl = true) {
      tagCloudChips.forEach((chip) => {
        chip.classList.remove(...ACTIVE_CHIP_CLASSES);
        chip.setAttribute('aria-pressed', 'false');
      });

      if (categoriesContainer) categoriesContainer.style.display = 'block';
      if (tagResultsContainer) tagResultsContainer.style.display = 'none';

      categoryPills.forEach((p) => {
        const isActive = p.getAttribute('data-category') === slug;
        p.setAttribute('aria-pressed', String(isActive));
        p.classList.remove(...(isActive ? INACTIVE_PILL_CLASSES : ACTIVE_PILL_CLASSES));
        p.classList.add(...(isActive ? ACTIVE_PILL_CLASSES : INACTIVE_PILL_CLASSES));
      });

      if (slug === 'all') {
        categorySections.forEach((sec) => (sec.style.display = 'block'));
        if (activeFilterBar) {
          activeFilterBar.classList.add('hidden');
          activeFilterBar.classList.remove('flex');
        }
        if (updateUrl) {
          history.replaceState(null, '', window.location.pathname);
        }
      } else {
        categorySections.forEach((sec) => {
          const isMatch = sec.getAttribute('data-category-section') === slug;
          sec.style.display = isMatch ? 'block' : 'none';
        });

        const activePill = document.querySelector(`.category-pill[data-category="${slug}"]`);
        const catName = activePill?.querySelector('span')?.textContent || slug;

        if (activeFilterBar && activeFilterLabel) {
          activeFilterBar.classList.remove('hidden');
          activeFilterBar.classList.add('flex');
          activeFilterLabel.textContent = `Category: ${catName}`;
          if (activeFilterCounts) activeFilterCounts.textContent = '';
        }

        if (updateUrl) {
          history.replaceState(null, '', `?category=${slug}`);
        }
      }
    }

    // 3. Set Active Tag Filter
    function setTagFilter(slug: string, updateUrl = true) {
      if (!slug) return;

      categoryPills.forEach((p) => {
        p.setAttribute('aria-pressed', 'false');
        p.classList.remove(...ACTIVE_PILL_CLASSES);
        p.classList.add(...INACTIVE_PILL_CLASSES);
      });

      tagCloudChips.forEach((chip) => {
        const isMatch = chip.getAttribute('data-tag-slug') === slug;
        chip.setAttribute('aria-pressed', String(isMatch));
        chip.classList.toggle('ring-2', isMatch);
        chip.classList.toggle('ring-emerald-500', isMatch);
        chip.classList.toggle('bg-emerald-500/10', isMatch);
        chip.classList.toggle('dark:bg-emerald-500/15', isMatch);
        chip.classList.toggle('border-emerald-500', isMatch);
      });

      if (categoriesContainer) categoriesContainer.style.display = 'none';
      if (tagResultsContainer) tagResultsContainer.style.display = 'block';

      const matchingChip = document.querySelector(`.tag-cloud-chip[data-tag-slug="${slug}"]`);
      const tagName = matchingChip?.querySelector('.tag-chip-label')?.textContent || slug;

      if (tagResultsTitle) {
        tagResultsTitle.textContent = `#${tagName}`;
      }

      const filterCards = (cards: NodeListOf<HTMLElement>) => {
        let count = 0;
        cards.forEach((card) => {
          const tags = (card.getAttribute('data-item-tags') || '').split(',');
          const isMatch = tags.includes(slug);
          card.style.display = isMatch ? 'flex' : 'none';
          if (isMatch) count++;
        });
        return count;
      };

      const articleCount = filterCards(tagPostCards);
      const videoCount = filterCards(tagVideoCards);
      const softwareCount = filterCards(tagSoftwareCards);
      const toolCount = filterCards(tagToolCards);

      const updateBadge = (el: HTMLElement | null, count: number, singular: string, plural: string) => {
        if (!el) return;
        el.textContent = `${count} ${count === 1 ? singular : plural}`;
        el.style.display = count > 0 ? 'inline-block' : 'none';
      };

      updateBadge(tagArticleCountBadge, articleCount, 'article', 'articles');
      updateBadge(tagVideoCountBadge, videoCount, 'video', 'videos');
      updateBadge(tagSoftwareCountBadge, softwareCount, 'software', 'software');
      updateBadge(tagToolCountBadge, toolCount, 'tool', 'tools');

      if (tagArticlesSection) tagArticlesSection.style.display = articleCount > 0 ? 'block' : 'none';
      if (tagVideosSection) tagVideosSection.style.display = videoCount > 0 ? 'block' : 'none';
      if (tagSoftwareSection) tagSoftwareSection.style.display = softwareCount > 0 ? 'block' : 'none';
      if (tagToolsSection) tagToolsSection.style.display = toolCount > 0 ? 'block' : 'none';

      const totalItemsCount = articleCount + videoCount + softwareCount + toolCount;
      if (tagNoItemsState) {
        tagNoItemsState.classList.toggle('hidden', totalItemsCount > 0);
      }

      if (activeFilterBar && activeFilterLabel) {
        activeFilterBar.classList.remove('hidden');
        activeFilterBar.classList.add('flex');
        activeFilterLabel.textContent = `Topic: #${tagName}`;
        if (activeFilterCounts) {
          const countParts: string[] = [];
          if (articleCount > 0) countParts.push(`${articleCount} article${articleCount !== 1 ? 's' : ''}`);
          if (videoCount > 0) countParts.push(`${videoCount} video${videoCount !== 1 ? 's' : ''}`);
          if (softwareCount > 0) countParts.push(`${softwareCount} software`);
          if (toolCount > 0) countParts.push(`${toolCount} tool${toolCount !== 1 ? 's' : ''}`);
          activeFilterCounts.textContent = countParts.length > 0 ? `(${countParts.join(', ')})` : '';
        }
      }

      if (updateUrl) {
        history.replaceState(null, '', `?tag=${slug}`);
      }
    }

    // 4. Attach Click & Keyboard Events
    categoryPills.forEach((p) => {
      p.addEventListener('click', (e) => {
        e.preventDefault();
        setCategoryFilter(p.getAttribute('data-category') || 'all');
      });
    });

    tagCloudChips.forEach((chip) => {
      chip.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = chip.getAttribute('data-tag-slug') || '';
        if (slug) setTagFilter(slug);
      });
    });

    document.querySelectorAll<HTMLElement>('.tag-trigger-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-tag-trigger') || '';
        if (slug) setTagFilter(slug);
      });
    });

    clearFilterBtn?.addEventListener('click', () => setCategoryFilter('all'));
    emptyClearFilterBtn?.addEventListener('click', () => setCategoryFilter('all'));

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && tagSearchInput && document.activeElement !== tagSearchInput) {
        const tag = (document.activeElement as HTMLElement)?.tagName;
        if (tag !== 'INPUT' && tag !== 'TEXTAREA') {
          e.preventDefault();
          tagSearchInput.focus();
        }
      } else if (e.key === 'Escape') {
        if (document.activeElement === tagSearchInput && tagSearchInput?.value) {
          tagSearchInput.value = '';
          updateTagCloud();
        } else if (activeFilterBar && !activeFilterBar.classList.contains('hidden')) {
          setCategoryFilter('all');
        }
      }
    });

    // 5. Initial URL Parameter and Hash handling
    const urlParams = new URLSearchParams(window.location.search);
    const tagParam = urlParams.get('tag')?.toLowerCase();
    const catParam = urlParams.get('category')?.toLowerCase();
    const initialHash = window.location.hash.replace('#', '').toLowerCase();

    if (tagParam) {
      setTagFilter(tagParam, false);
    } else if (catParam) {
      setCategoryFilter(catParam, false);
    } else if (initialHash.startsWith('tag-')) {
      setTagFilter(initialHash.replace('tag-', ''), false);
    } else if (initialHash && initialHash !== 'all') {
      const isCat = document.querySelector(`.category-pill[data-category="${initialHash}"]`);
      if (isCat) {
        setCategoryFilter(initialHash, false);
      } else {
        const isTag = document.querySelector(`.tag-cloud-chip[data-tag-slug="${initialHash}"]`);
        if (isTag) {
          setTagFilter(initialHash, false);
        }
      }
    }

    updateTagCloud();
  }

  setupCategoriesAndTags();
  document.addEventListener('astro:page-load', setupCategoriesAndTags);
  document.addEventListener('astro:after-swap', setupCategoriesAndTags);
</script>
