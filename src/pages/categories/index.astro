</Base>

<script>
  function setupCategoriesAndTags() {
    const categoryPills = document.querySelectorAll<HTMLElement>('.category-pill');
    const categorySections = document.querySelectorAll<HTMLElement>('.category-section');
    const categoriesContainer = document.getElementById('categories-container');
    const tagResultsContainer = document.getElementById('tag-results-container');
    const activeFilterBar = document.getElementById('active-filter-bar');
    const activeFilterLabel = document.getElementById('active-filter-label');
    const activeFilterCounts = document.getElementById('active-filter-counts');
    const clearFilterBtn = document.getElementById('clear-filter-btn');

    // Tag Cloud Elements
    const tagSearchInput = document.getElementById('tag-search-input') as HTMLInputElement | null;
    const tagFilterBtns = document.querySelectorAll<HTMLElement>('.tag-filter-btn');
    const tagCloudChips = document.querySelectorAll<HTMLElement>('.tag-cloud-chip');
    const tagActiveCountEl = document.getElementById('tag-active-count');
    const tagEmptyState = document.getElementById('tag-empty-state');

    // Tag Results Elements
    const tagResultsTitle = document.getElementById('tag-results-title');
    const tagArticleCountBadge = document.getElementById('tag-article-count-badge');
    const tagVideoCountBadge = document.getElementById('tag-video-count-badge');
    const tagSoftwareCountBadge = document.getElementById('tag-software-count-badge');
    const tagToolCountBadge = document.getElementById('tag-tool-count-badge');
    const tagArticlesSection = document.getElementById('tag-articles-section');
    const tagVideosSection = document.getElementById('tag-videos-section');
    const tagSoftwareSection = document.getElementById('tag-software-section');
    const tagToolsSection = document.getElementById('tag-tools-section');
    const tagNoItemsState = document.getElementById('tag-no-items-state');
    const tagPostCards = document.querySelectorAll<HTMLElement>('.tag-post-card');
    const tagVideoCards = document.querySelectorAll<HTMLElement>('.tag-video-card');
    const tagSoftwareCards = document.querySelectorAll<HTMLElement>('.tag-software-card');
    const tagToolCards = document.querySelectorAll<HTMLElement>('.tag-tool-card');

    let currentTagTypeFilter = 'all';

    // 1. Tag Cloud Search & Type Filter
    function updateTagCloud() {
      const query = (tagSearchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      tagCloudChips.forEach((chip) => {
        const name = chip.getAttribute('data-tag-name') || '';
        const slug = chip.getAttribute('data-tag-slug') || '';

        const matchesQuery = !query || name.includes(query) || slug.includes(query);

        let matchesType = true;
        if (currentTagTypeFilter === 'article') {
          matchesType = chip.getAttribute('data-has-article') === 'true';
        } else if (currentTagTypeFilter === 'video') {
          matchesType = chip.getAttribute('data-has-video') === 'true';
        } else if (currentTagTypeFilter === 'software') {
          matchesType = chip.getAttribute('data-has-software') === 'true';
        } else if (currentTagTypeFilter === 'tool') {
          matchesType = chip.getAttribute('data-has-tool') === 'true';
        }

        const isVisible = matchesQuery && matchesType;
        chip.style.display = isVisible ? 'inline-flex' : 'none';
        if (isVisible) visibleCount++;
      });

      if (tagActiveCountEl) tagActiveCountEl.textContent = String(visibleCount);
      if (tagEmptyState) {
        tagEmptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    if (tagSearchInput) {
      tagSearchInput.addEventListener('input', updateTagCloud);
    }

    tagFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-filter') || 'all';
        currentTagTypeFilter = type;

        tagFilterBtns.forEach((b) => {
          b.classList.remove('active', 'bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900');
          b.classList.add('bg-white', 'dark:bg-zinc-800/60', 'text-zinc-600', 'dark:text-zinc-400');
        });

        btn.classList.add('active', 'bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900');
        btn.classList.remove('bg-white', 'dark:bg-zinc-800/60', 'text-zinc-600', 'dark:text-zinc-400');

        updateTagCloud();
      });
    });

    // 2. Set Active Category Filter (NO SCROLL!)
    function setCategoryFilter(slug: string, updateUrl = true) {
      // Clear tag active chip
      tagCloudChips.forEach((chip) => {
        chip.classList.remove('ring-2', 'ring-cyan-500', 'bg-cyan-50', 'dark:bg-cyan-900/40', 'border-cyan-500');
      });

      // Show categories container, hide tag container
      if (categoriesContainer) categoriesContainer.style.display = 'block';
      if (tagResultsContainer) tagResultsContainer.style.display = 'none';

      // Update category pill styles
      categoryPills.forEach((p) => {
        const cat = p.getAttribute('data-category');
        const isActive = cat === slug;
        if (isActive) {
          p.classList.remove('bg-zinc-100', 'text-zinc-700', 'dark:bg-zinc-800', 'dark:text-zinc-300');
          p.classList.add('bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900', 'shadow-sm');
        } else {
          p.classList.add('bg-zinc-100', 'text-zinc-700', 'dark:bg-zinc-800', 'dark:text-zinc-300');
          p.classList.remove('bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900', 'shadow-sm');
        }
      });

      if (slug === 'all') {
        categorySections.forEach((sec) => (sec.style.display = 'block'));
        if (activeFilterBar) activeFilterBar.classList.add('hidden');
        if (activeFilterBar) activeFilterBar.classList.remove('flex');

        if (updateUrl) {
          history.replaceState(null, '', window.location.pathname);
        }
      } else {
        let matchedSectionCount = 0;
        categorySections.forEach((sec) => {
          const isMatch = sec.getAttribute('data-category-section') === slug;
          sec.style.display = isMatch ? 'block' : 'none';
          if (isMatch) matchedSectionCount++;
        });

        const activePill = document.querySelector(`.category-pill[data-category="${slug}"]`);
        const catName = activePill?.querySelector('span')?.textContent || slug;

        if (activeFilterBar && activeFilterLabel) {
          activeFilterBar.classList.remove('hidden');
          activeFilterBar.classList.add('flex');
          activeFilterLabel.textContent = `Category: ${catName}`;
          if (activeFilterCounts) activeFilterCounts.textContent = '';
        }

        if (updateUrl) {
          history.replaceState(null, '', `?category=${slug}`);
        }
      }
    }

    // 3. Set Active Tag Filter (NO SCROLL!)
    function setTagFilter(slug: string, updateUrl = true) {
      if (!slug) return;

      // Deselect category pills
      categoryPills.forEach((p) => {
        p.classList.add('bg-zinc-100', 'text-zinc-700', 'dark:bg-zinc-800', 'dark:text-zinc-300');
        p.classList.remove('bg-zinc-900', 'text-white', 'dark:bg-white', 'dark:text-zinc-900', 'shadow-sm');
      });

      // Highlight active tag chip in tag cloud
      tagCloudChips.forEach((chip) => {
        const isMatch = chip.getAttribute('data-tag-slug') === slug;
        if (isMatch) {
          chip.classList.add('ring-2', 'ring-cyan-500', 'bg-cyan-50', 'dark:bg-cyan-900/40', 'border-cyan-500');
        } else {
          chip.classList.remove('ring-2', 'ring-cyan-500', 'bg-cyan-50', 'dark:bg-cyan-900/40', 'border-cyan-500');
        }
      });

      // Hide category container, show tag results container
      if (categoriesContainer) categoriesContainer.style.display = 'none';
      if (tagResultsContainer) tagResultsContainer.style.display = 'block';

      // Find matching tag chip to get formatted display name
      const matchingChip = document.querySelector(`.tag-cloud-chip[data-tag-slug="${slug}"]`);
      const tagName = matchingChip?.querySelector('.font-medium')?.textContent || slug;

      if (tagResultsTitle) {
        tagResultsTitle.textContent = `#${tagName}`;
      }

      // Filter articles
      let articleCount = 0;
      tagPostCards.forEach((card) => {
        const tags = (card.getAttribute('data-item-tags') || '').split(',');
        const isMatch = tags.includes(slug);
        card.style.display = isMatch ? 'flex' : 'none';
        if (isMatch) articleCount++;
      });

      // Filter videos
      let videoCount = 0;
      tagVideoCards.forEach((card) => {
        const tags = (card.getAttribute('data-item-tags') || '').split(',');
        const isMatch = tags.includes(slug);
        card.style.display = isMatch ? 'flex' : 'none';
        if (isMatch) videoCount++;
      });

      // Filter software
      let softwareCount = 0;
      tagSoftwareCards.forEach((card) => {
        const tags = (card.getAttribute('data-item-tags') || '').split(',');
        const isMatch = tags.includes(slug);
        card.style.display = isMatch ? 'flex' : 'none';
        if (isMatch) softwareCount++;
      });

      // Filter tools
      let toolCount = 0;
      tagToolCards.forEach((card) => {
        const tags = (card.getAttribute('data-item-tags') || '').split(',');
        const isMatch = tags.includes(slug);
        card.style.display = isMatch ? 'flex' : 'none';
        if (isMatch) toolCount++;
      });

      // Update counters
      if (tagArticleCountBadge) {
        tagArticleCountBadge.textContent = `${articleCount} article${articleCount !== 1 ? 's' : ''}`;
        tagArticleCountBadge.style.display = articleCount > 0 ? 'inline-block' : 'none';
      }
      if (tagVideoCountBadge) {
        tagVideoCountBadge.textContent = `${videoCount} video${videoCount !== 1 ? 's' : ''}`;
        tagVideoCountBadge.style.display = videoCount > 0 ? 'inline-block' : 'none';
      }
      if (tagSoftwareCountBadge) {
        tagSoftwareCountBadge.textContent = `${softwareCount} software`;
        tagSoftwareCountBadge.style.display = softwareCount > 0 ? 'inline-block' : 'none';
      }
      if (tagToolCountBadge) {
        tagToolCountBadge.textContent = `${toolCount} tool${toolCount !== 1 ? 's' : ''}`;
        tagToolCountBadge.style.display = toolCount > 0 ? 'inline-block' : 'none';
      }

      if (tagArticlesSection) {
        tagArticlesSection.style.display = articleCount > 0 ? 'block' : 'none';
      }
      if (tagVideosSection) {
        tagVideosSection.style.display = videoCount > 0 ? 'block' : 'none';
      }
      if (tagSoftwareSection) {
        tagSoftwareSection.style.display = softwareCount > 0 ? 'block' : 'none';
      }
      if (tagToolsSection) {
        tagToolsSection.style.display = toolCount > 0 ? 'block' : 'none';
      }

      const totalItemsCount = articleCount + videoCount + softwareCount + toolCount;
      if (tagNoItemsState) {
        tagNoItemsState.classList.toggle('hidden', totalItemsCount > 0);
      }

      // Update active filter banner
      if (activeFilterBar && activeFilterLabel) {
        activeFilterBar.classList.remove('hidden');
        activeFilterBar.classList.add('flex');
        activeFilterLabel.textContent = `Topic: #${tagName}`;
        if (activeFilterCounts) {
          const countParts: string[] = [];
          if (articleCount > 0) countParts.push(`${articleCount} article${articleCount !== 1 ? 's' : ''}`);
          if (videoCount > 0) countParts.push(`${videoCount} video${videoCount !== 1 ? 's' : ''}`);
          if (softwareCount > 0) countParts.push(`${softwareCount} software`);
          if (toolCount > 0) countParts.push(`${toolCount} tool${toolCount !== 1 ? 's' : ''}`);
          activeFilterCounts.textContent = countParts.length > 0 ? `(${countParts.join(', ')})` : '';
        }
      }

      if (updateUrl) {
        history.replaceState(null, '', `?tag=${slug}`);
      }
    }

    // 4. Attach Click Events
    categoryPills.forEach((p) => {
      p.addEventListener('click', (e) => {
        e.preventDefault();
        const cat = p.getAttribute('data-category') || 'all';
        setCategoryFilter(cat);
      });
    });

    tagCloudChips.forEach((chip) => {
      chip.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = chip.getAttribute('data-tag-slug') || '';
        if (slug) setTagFilter(slug);
      });
    });

    // Tag triggers on article/video cards
    const tagTriggerBtns = document.querySelectorAll<HTMLElement>('.tag-trigger-btn');
    tagTriggerBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-tag-trigger') || '';
        if (slug) setTagFilter(slug);
      });
    });

    if (clearFilterBtn) {
      clearFilterBtn.addEventListener('click', () => {
        setCategoryFilter('all');
      });
    }

    // 5. Initial URL Parameter and Hash handling
    const urlParams = new URLSearchParams(window.location.search);
    const tagParam = urlParams.get('tag')?.toLowerCase();
    const catParam = urlParams.get('category')?.toLowerCase();
    const initialHash = window.location.hash.replace('#', '').toLowerCase();

    if (tagParam) {
      setTagFilter(tagParam, false);
    } else if (catParam) {
      setCategoryFilter(catParam, false);
    } else if (initialHash.startsWith('tag-')) {
      setTagFilter(initialHash.replace('tag-', ''), false);
    } else if (initialHash && initialHash !== 'all') {
      // Check if hash matches category or tag
      const isCat = document.querySelector(`.category-pill[data-category="${initialHash}"]`);
      if (isCat) {
        setCategoryFilter(initialHash, false);
      } else {
        const isTag = document.querySelector(`.tag-cloud-chip[data-tag-slug="${initialHash}"]`);
        if (isTag) {
          setTagFilter(initialHash, false);
        }
      }
    }
  }

  setupCategoriesAndTags();
  document.addEventListener('astro:page-load', setupCategoriesAndTags);
  document.addEventListener('astro:after-swap', setupCategoriesAndTags);
</script>
