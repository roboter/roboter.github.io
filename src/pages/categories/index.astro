                    {tool.tagline}
                  </p>
                  <p class="mt-2 line-clamp-2 text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                    {tool.shortDescription}
                  </p>
                </div>

                {tool.tags && tool.tags.length > 0 && (
                  <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/60 flex flex-wrap gap-1.5 relative z-10">
                    {tool.tags.slice(0, 4).map((rawTag: string) => (
                      <button
                        type="button"
                        data-tag-trigger={tagToSlug(rawTag)}
                        class="tag-trigger-btn rounded-md bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-[11px] font-medium text-zinc-600 dark:text-zinc-400 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors cursor-pointer"
                      >
