---
import Base from "@layouts/Base.astro";
import CategoryIcon from "@icons/CategoryIcon.astro";
import CalendarIcon from "@icons/CalendarIcon.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { slugify } from "@utils/slug";
import youtubeData from "@config/youtube.json";
import { getAllUnifiedTags, tagToSlug, type UnifiedTag } from "@utils/taxonomy";
import { softwareProjects } from "../../data/software";
import { tools } from "../../data/tools";
import {
  Tag,
  Search,
  BookOpen,
  Play,
  Cpu,
  Wrench,
  Layers,
  ExternalLink,
  X,
  Sparkles,
} from "lucide-react";

// 1. Fetch Blog Posts
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// 2. Load YouTube Videos
interface YouTubeVideo {
  videoId: string;
  title: string;
  description?: string;
  duration?: string;
  published?: string;
  views?: string;
  tags?: string[];
}
const allVideos: YouTubeVideo[] = Array.isArray(youtubeData) ? (youtubeData as YouTubeVideo[]) : [];

// 3. Load Unified Tags
const allTags = await getAllUnifiedTags();
const totalTagsCount = allTags.length;
const withArticlesCount = allTags.filter((t) => t.articleCount > 0).length;
const withVideosCount = allTags.filter((t) => t.videoCount > 0).length;
const withSoftwareCount = allTags.filter((t) => t.softwareCount > 0).length;
const withToolsCount = allTags.filter((t) => t.toolCount > 0).length;

// 4. Category Aliases for Video Matching
const categoryVideoAliases: Record<string, string[]> = {
  arduino: ["arduino"],
  stm32: ["stm32"],
  wch: ["wch", "ch32", "ch32v003", "ch32v103", "ch32v203", "ch32v307", "ch32x035"],
  pcb: ["pcb", "pcbx", "gerber", "kicad"],
  esp32: ["esp32", "esp8266"],
  gigadevice: ["gigadevice", "gd32", "gd32vf103"],
  geehy: ["geehy", "apm32"],
  embedded: ["embedded", "dev boards", "mcu", "microcontroller", "arm", "risc-v", "sbc"],
  electronics: ["electronics", "diy electronics", "soldering", "sensor", "hardware", "diy"],
  "rabbit-2000": ["rabbit", "rabbit-2000"],
};

const displayNames: Record<string, string> = {
  arduino: "Arduino",
  stm32: "STM32",
  wch: "WCH",
  pcb: "PCB",
  esp32: "ESP32",
  gigadevice: "GigaDevice",
  geehy: "Geehy",
  embedded: "Embedded",
  electronics: "Electronics",
  "rabbit-2000": "Rabbit 2000",
};

interface CategoryGroup {
  name: string;
  slug: string;
  posts: typeof allPosts;
  videos: typeof allVideos;
}

const categoryMap = new Map<string, CategoryGroup>();

// Populate blog posts into categories
for (const post of allPosts) {
  const postCategories: string[] = post.data.categories || [];
  for (const rawCat of postCategories) {
    if (!rawCat) continue;
    const slug = slugify(rawCat).toLowerCase();
    if (!categoryMap.has(slug)) {
      categoryMap.set(slug, {
        name: displayNames[slug] || rawCat.charAt(0).toUpperCase() + rawCat.slice(1),
        slug,
        posts: [],
        videos: [],
      });
    }
    const group = categoryMap.get(slug)!;
    if (!group.posts.some((p) => (p.id || p.slug) === (post.id || post.slug))) {
      group.posts.push(post);
    }
  }
}

// Populate matching videos into categories
for (const [slug, group] of categoryMap.entries()) {
  const aliases = categoryVideoAliases[slug] || [slug];
  group.videos = allVideos.filter((v) => {
    const vTags = (v.tags || []).map((t) => t.toLowerCase());
    const vTitle = (v.title || "").toLowerCase();
    return aliases.some(
      (a) => vTags.some((t) => t.includes(a)) || vTitle.includes(a)
    );
  });
}

// Sort categories by total content count (posts + videos) descending
const categories = Array.from(categoryMap.values()).sort((a, b) => {
  const countA = a.posts.length + a.videos.length;
  const countB = b.posts.length + b.videos.length;
  if (countB !== countA) {
    return countB - countA;
  }
  return a.name.localeCompare(b.name);
});

// Unique software and tools for tag filtering
const softwareItems = allTags.flatMap((t) => t.items.filter((i) => i.type === "software"));
const uniqueSoftware = Array.from(new Map(softwareItems.map((s) => [s.id, s])).values());

const toolItems = allTags.flatMap((t) => t.items.filter((i) => i.type === "tool"));
const uniqueTools = Array.from(new Map(toolItems.map((tool) => [tool.id, tool])).values());

const pageTitle = "Categories & Topics — Robby roboter";
const pageDescription = "Explore hardware deep-dives, video tutorials, and interactive projects categorized across engineering disciplines.";
---

<Base
  title={pageTitle}
  meta_title={pageTitle}
  description={pageDescription}
  hideHero={true}
  hideVideos={true}
>
  <div class="max-w-6xl mx-auto py-4 px-2 sm:px-4">
    <!-- PAGE HEADER -->
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400 mb-3 border border-emerald-500/20">
        <CategoryIcon />
        <span>Browse Topics &amp; Media</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight">
        Categories &amp; Topics
      </h1>
      <p class="mt-2 text-base text-zinc-600 dark:text-zinc-400 max-w-3xl">
        Explore {allPosts.length} articles, {allVideos.length} video tutorials, and interactive engineering tools grouped across {categories.length} categories and {totalTagsCount} topic tags.
      </p>
    </div>

    <!-- CATEGORY FILTER PILLS BAR -->
    <div class="sticky top-16 z-30 mb-8 -mx-4 px-4 sm:mx-0 sm:px-0 py-3 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-xl border-y sm:border sm:rounded-2xl border-zinc-200/60 dark:border-zinc-800/60 shadow-sm">
      <div class="flex flex-wrap items-center gap-2" id="category-pills">
        <button
          type="button"
          data-category="all"
          class="category-pill active inline-flex items-center gap-1.5 shrink-0 rounded-full px-4 py-1.5 text-xs sm:text-sm font-medium transition-all active:scale-95 bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shadow-sm cursor-pointer"
        >
          <span>All Topics</span>
          <span class="rounded-full bg-white/20 dark:bg-black/10 px-1.5 py-0.2 text-[11px] font-semibold">
            {allPosts.length}
          </span>
        </button>

        {
          categories.map((cat) => (
            <button
              type="button"
              data-category={cat.slug}
              class="category-pill inline-flex items-center gap-1.5 shrink-0 rounded-full px-3.5 py-1.5 text-xs sm:text-sm font-medium transition-all active:scale-95 bg-zinc-100 hover:bg-zinc-200/80 text-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700 dark:text-zinc-300 cursor-pointer"
            >
              <span>{cat.name}</span>
              <span class="rounded-full bg-zinc-200 dark:bg-zinc-700 px-1.5 py-0.2 text-[11px] font-semibold text-zinc-700 dark:text-zinc-300">
                {cat.posts.length + (cat.videos.length > 0 ? ` + ${cat.videos.length}v` : "")}
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- TAG CLOUD CARD -->
    <div class="rounded-3xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/50 backdrop-blur-sm p-5 sm:p-7 mb-10 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <div class="flex items-center gap-2">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-600 dark:text-cyan-400">
            <Tag className="w-4 h-4" />
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100">
              Filter by Topic Tags
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Click any tag to instantly filter articles and videos
            </p>
          </div>
        </div>

        <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 self-end sm:self-center">
          Showing <span id="tag-active-count" class="font-bold text-zinc-900 dark:text-white">{totalTagsCount}</span> of {totalTagsCount} tags
        </div>
      </div>

      <!-- Tag Search & Type Pills -->
      <div class="space-y-3 mb-5">
        <div class="relative w-full">
          <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 pointer-events-none">
            <Search className="w-4 h-4" />
          </div>
          <input
            id="tag-search-input"
            type="text"
            placeholder="Search tags (e.g. Arduino, STM32, CAD, PCB, Tools, ESP32, DS1302)..."
            class="w-full pl-10 pr-4 py-2.5 text-xs sm:text-sm rounded-xl bg-white dark:bg-zinc-800/90 border border-zinc-200 dark:border-zinc-700/80 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/40 focus:border-cyan-500 transition-all shadow-sm"
          />
        </div>

        <!-- Tag Type Filters -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs font-medium">
          <button
            type="button"
            data-filter="all"
            class="tag-filter-btn active inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 transition-all cursor-pointer shadow-sm text-xs"
          >
            <Layers className="w-3 h-3" />
            <span>All</span>
            <span class="px-1 py-0.2 rounded-full text-[9px] bg-white/20 dark:bg-black/10 font-mono">
              {totalTagsCount}
            </span>
          </button>

          <button
            type="button"
            data-filter="article"
            class="tag-filter-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700/60 bg-white dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer text-xs"
          >
            <BookOpen className="w-3 h-3 text-blue-500" />
            <span>Articles</span>
            <span class="px-1 py-0.2 rounded-full text-[9px] bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono">
              {withArticlesCount}
            </span>
          </button>

          <button
            type="button"
            data-filter="video"
            class="tag-filter-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700/60 bg-white dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer text-xs"
          >
            <Play className="w-3 h-3 text-red-500" />
            <span>Videos</span>
            <span class="px-1 py-0.2 rounded-full text-[9px] bg-red-500/10 text-red-600 dark:text-red-400 font-mono">
              {withVideosCount}
            </span>
          </button>

          <button
            type="button"
            data-filter="software"
            class="tag-filter-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700/60 bg-white dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer text-xs"
          >
            <Cpu className="w-3 h-3 text-indigo-500" />
            <span>Software</span>
            <span class="px-1 py-0.2 rounded-full text-[9px] bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-mono">
              {withSoftwareCount}
            </span>
          </button>

          <button
            type="button"
            data-filter="tool"
            class="tag-filter-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-zinc-200 dark:border-zinc-700/60 bg-white dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer text-xs"
          >
            <Wrench className="w-3 h-3 text-emerald-500" />
            <span>Tools</span>
            <span class="px-1 py-0.2 rounded-full text-[9px] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono">
              {withToolsCount}
            </span>
          </button>
        </div>
      </div>

      <!-- TAGS GRID -->
      <div
        id="tags-container"
        class="flex flex-wrap gap-2"
      >
        {
          allTags.map((tag) => (
            <button
              type="button"
              class="tag-cloud-chip group relative flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-zinc-200/90 dark:border-zinc-800 bg-white dark:bg-zinc-800/80 hover:bg-zinc-100 dark:hover:bg-zinc-700 hover:border-cyan-500/50 dark:hover:border-cyan-500/40 shadow-xs transition-all duration-150 active:scale-95 cursor-pointer text-left"
              data-tag-slug={tag.slug}
              data-tag-name={tag.name.toLowerCase()}
              data-has-article={tag.articleCount > 0 ? "true" : "false"}
              data-has-video={tag.videoCount > 0 ? "true" : "false"}
              data-has-software={tag.softwareCount > 0 ? "true" : "false"}
              data-has-tool={tag.toolCount > 0 ? "true" : "false"}
              title={`${tag.totalCount} items in #${tag.name}`}
            >
              <span class="text-xs font-mono text-cyan-600 dark:text-cyan-400 group-hover:text-cyan-500">
                #
              </span>

              <span class="text-xs font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-cyan-600 dark:group-hover:text-cyan-300 transition-colors">
                {tag.name}
              </span>

              <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-medium bg-zinc-100 dark:bg-zinc-700/80 text-zinc-600 dark:text-zinc-400 group-hover:bg-cyan-500/10 group-hover:text-cyan-600 dark:group-hover:text-cyan-300 transition-colors">
                {tag.totalCount}
              </span>

              <!-- Type dots -->
              <span class="flex items-center gap-0.5 opacity-60 group-hover:opacity-100 transition-opacity">
                {tag.articleCount > 0 && (
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-500" title={`${tag.articleCount} articles`} />
                )}
                {tag.videoCount > 0 && (
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500" title={`${tag.videoCount} videos`} />
                )}
                {tag.softwareCount > 0 && (
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-500" title={`${tag.softwareCount} software`} />
                )}
                {tag.toolCount > 0 && (
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" title={`${tag.toolCount} tools`} />
                )}
              </span>
            </button>
          ))
        }
      </div>

      <div
        id="tag-empty-state"
        class="hidden text-center py-6"
      >
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          No matching topics found. Try typing a different keyword.
        </p>
      </div>
    </div>

    <!-- ACTIVE FILTER NOTIFICATION / RESET BAR -->
    <div
      id="active-filter-bar"
      class="hidden items-center justify-between p-3.5 mb-8 rounded-2xl bg-cyan-500/10 dark:bg-cyan-500/15 border border-cyan-500/20 text-xs sm:text-sm text-cyan-900 dark:text-cyan-200 shadow-sm"
    >
      <div class="flex items-center gap-2">
        <Sparkles className="w-4 h-4 text-cyan-600 dark:text-cyan-400 shrink-0" />
        <span>
          Filtered by: <strong id="active-filter-label" class="font-bold underline decoration-cyan-500 underline-offset-2"></strong>
        </span>
        <span id="active-filter-counts" class="hidden sm:inline font-mono text-xs opacity-75"></span>
      </div>

      <button
        type="button"
        id="clear-filter-btn"
        class="inline-flex items-center gap-1 px-3 py-1 rounded-xl bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 font-semibold shadow-xs hover:bg-zinc-50 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-all cursor-pointer text-xs"
      >
        <X className="w-3.5 h-3.5" />
        <span>Clear Filter</span>
      </button>
    </div>

    <!-- 1. CATEGORY SECTIONS CONTAINER (Default View) -->
    <div class="space-y-16" id="categories-container">
      {
        categories.map((cat) => (
          <section
            id={cat.slug}
            data-category-section={cat.slug}
            class="category-section transition-all duration-300"
          >
            <!-- Category Title Header -->
            <div class="flex items-center justify-between pb-4 border-b border-zinc-200/70 dark:border-zinc-800 mb-6">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                  <CategoryIcon />
                </div>
                <div>
                  <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                    {cat.name}
                  </h2>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-3 py-1 text-xs font-semibold text-zinc-600 dark:text-zinc-400 ring-1 ring-zinc-900/5 dark:ring-white/10">
                  {cat.posts.length} {cat.posts.length === 1 ? "article" : "articles"}
                </span>
                {cat.videos.length > 0 && (
                  <span class="rounded-full bg-red-500/10 px-3 py-1 text-xs font-semibold text-red-600 dark:text-red-400 ring-1 ring-red-500/20">
                    {cat.videos.length} {cat.videos.length === 1 ? "video" : "videos"}
                  </span>
                )}
              </div>
            </div>

            <!-- Articles Grid -->
            {cat.posts.length > 0 && (
              <div class="mb-8">
                <div class="flex items-center gap-1.5 mb-4 text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                  <BookOpen className="w-3.5 h-3.5 text-blue-500" />
                  <span>Articles &amp; Project Guides</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {cat.posts.map((post) => (
                    <article class="group relative flex flex-col justify-between rounded-2xl border border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-zinc-800/40 p-5 shadow-sm hover:shadow-md hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-200 active:scale-[0.99]">
                      <div>
                        {post.data.heroImage && (
                          <div class="aspect-video w-full rounded-xl overflow-hidden mb-4 bg-zinc-100 dark:bg-zinc-800">
                            <Image
                              src={post.data.heroImage}
                              alt={post.data.title}
                              width={600}
                              height={338}
                              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                              decoding="async"
                              loading="lazy"
                            />
                          </div>
                        )}
                        <div class="flex items-center gap-2 text-xs font-medium text-zinc-500 dark:text-zinc-400 mb-2">
                          <CalendarIcon />
                          <FormattedDate date={post.data.pubDate} />
                        </div>
                        <h3 class="text-base sm:text-lg font-semibold leading-snug tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                          <a href={`/blog/${post.id || post.slug}/`}>
                            <span class="absolute inset-0 rounded-2xl" />
                            {post.data.title}
                          </a>
                        </h3>
                        <p class="mt-2 line-clamp-2 text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                          {post.data.description}
                        </p>
                      </div>

                      {post.data.tags && post.data.tags.length > 0 && (
                        <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/60 flex flex-wrap gap-1.5 relative z-10">
                          {post.data.tags.slice(0, 4).map((rawTag: string) => (
                            <button
                              type="button"
                              data-tag-trigger={tagToSlug(rawTag)}
                              class="tag-trigger-btn rounded-md bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-[11px] font-medium text-zinc-600 dark:text-zinc-400 hover:text-cyan-600 dark:hover:text-cyan-400 hover:bg-cyan-50 dark:hover:bg-cyan-900/30 transition-colors cursor-pointer"
                            >
                              #{rawTag}
                            </button>
                          ))}
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            )}

            <!-- Videos Grid (YouTube) -->
            {cat.videos.length > 0 && (
              <div>
                <div class="flex items-center gap-1.5 mb-4 text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                  <Play className="w-3.5 h-3.5 text-red-500" />
                  <span>YouTube Videos &amp; Tutorials</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                  {cat.videos.map((video) => (
                    <article class="flex flex-col overflow-hidden rounded-2xl bg-white dark:bg-zinc-800/40 border border-zinc-200/70 dark:border-zinc-800 hover:border-red-500/50 dark:hover:border-red-500/40 shadow-sm hover:shadow-md transition-all duration-200 group">
                      <a
                        href={`/videos/${video.videoId}/`}
                        class="relative aspect-video w-full overflow-hidden bg-zinc-950 block cursor-pointer"
                        aria-label={`Play: ${video.title}`}
                      >
                        <img
                          src={`https://i.ytimg.com/vi/${video.videoId}/hqdefault.jpg`}
                          alt={video.title}
                          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                          loading="lazy"
                        />
                        <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                          <div class="w-10 h-10 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-lg opacity-85 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300">
                            <Play className="w-4 h-4 fill-current ml-0.5" />
                          </div>
                        </div>
                        {video.duration && (
                          <span class="absolute bottom-2 right-2 px-2 py-0.5 text-[10px] font-mono font-medium text-white bg-black/85 backdrop-blur-md rounded">
                            {video.duration}
                          </span>
                        )}
                      </a>

                      <div class="p-4 flex-1 flex flex-col justify-between">
                        <div>
                          <h3 class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors line-clamp-2 leading-snug">
                            <a href={`/videos/${video.videoId}/`}>
                              {video.title}
                            </a>
                          </h3>

