---
import Base from '@layouts/Base.astro';
import CategoryIcon from '@icons/CategoryIcon.astro';
import CalendarIcon from '@icons/CalendarIcon.astro';
import FormattedDate from '@components/FormattedDate.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { slugify } from '@utils/slug';
import youtubeData from '@config/youtube.json';
import { getAllUnifiedTags, tagToSlug } from '@utils/taxonomy';
import { softwareProjects } from '../../data/software';
import { tools } from '../../data/tools';
import {
  Tag,
  Search,
  BookOpen,
  Play,
  Cpu,
  Wrench,
  Layers,
  X,
  Sparkles,
  ChevronDown,
  RotateCcw,
} from 'lucide-react';

// 1. Fetch Blog Posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// 2. Load YouTube Videos
interface YouTubeVideo {
  videoId: string;
  title: string;
  description?: string;
  duration?: string;
  published?: string;
  views?: string;
  tags?: string[];
}
const allVideos: YouTubeVideo[] = Array.isArray(youtubeData) ? (youtubeData as YouTubeVideo[]) : [];

// 3. Load Unified Tags
const allTags = await getAllUnifiedTags();
const totalTagsCount = allTags.length;
const INITIAL_VISIBLE_TAGS = 16;
const withArticlesCount = allTags.filter((t) => t.articleCount > 0).length;
const withVideosCount = allTags.filter((t) => t.videoCount > 0).length;
const withSoftwareCount = allTags.filter((t) => t.softwareCount > 0).length;
const withToolsCount = allTags.filter((t) => t.toolCount > 0).length;

// 4. Category Aliases for Video Matching
const categoryVideoAliases: Record<string, string[]> = {
  arduino: ['arduino'],
  stm32: ['stm32'],
  wch: ['wch', 'ch32', 'ch32v003', 'ch32v103', 'ch32v203', 'ch32v307', 'ch32x035'],
  pcb: ['pcb', 'pcbx', 'gerber', 'kicad'],
  esp32: ['esp32', 'esp8266'],
  gigadevice: ['gigadevice', 'gd32', 'gd32vf103'],
  geehy: ['geehy', 'apm32'],
  embedded: ['embedded', 'dev boards', 'mcu', 'microcontroller', 'arm', 'risc-v', 'sbc'],
  electronics: ['electronics', 'diy electronics', 'soldering', 'sensor', 'hardware', 'diy'],
  'rabbit-2000': ['rabbit', 'rabbit-2000'],
};

const displayNames: Record<string, string> = {
  arduino: 'Arduino',
  stm32: 'STM32',
  wch: 'WCH',
  pcb: 'PCB',
  esp32: 'ESP32',
  gigadevice: 'GigaDevice',
  geehy: 'Geehy',
  embedded: 'Embedded',
  electronics: 'Electronics',
  'rabbit-2000': 'Rabbit 2000',
};

interface CategoryGroup {
  name: string;
  slug: string;
  posts: typeof allPosts;
  videos: typeof allVideos;
}

const categoryMap = new Map<string, CategoryGroup>();

// Populate blog posts into categories
for (const post of allPosts) {
  const postCategories: string[] = post.data.categories || [];
  for (const rawCat of postCategories) {
    if (!rawCat) continue;
    const slug = slugify(rawCat).toLowerCase();
    if (!categoryMap.has(slug)) {
      categoryMap.set(slug, {
        name: displayNames[slug] || rawCat.charAt(0).toUpperCase() + rawCat.slice(1),
        slug,
        posts: [],
        videos: [],
      });
    }
    const group = categoryMap.get(slug)!;
    if (!group.posts.some((p) => (p.id || p.slug) === (post.id || post.slug))) {
      group.posts.push(post);
    }
  }
}

// Populate matching videos into categories
for (const [slug, group] of categoryMap.entries()) {
  const aliases = categoryVideoAliases[slug] || [slug];
  group.videos = allVideos.filter((v) => {
    const vTags = (v.tags || []).map((t) => t.toLowerCase());
    const vTitle = (v.title || '').toLowerCase();
    return aliases.some((a) => vTags.some((t) => t.includes(a)) || vTitle.includes(a));
  });
}

// Sort categories by total content count (posts + videos) descending
const categories = Array.from(categoryMap.values()).sort((a, b) => {
  const countA = a.posts.length + a.videos.length;
  const countB = b.posts.length + b.videos.length;
  if (countB !== countA) {
    return countB - countA;
  }
  return a.name.localeCompare(b.name);
});

// Unique software and tools for counts
const softwareItems = allTags.flatMap((t) => t.items.filter((i) => i.type === 'software'));
const uniqueSoftware = Array.from(new Map(softwareItems.map((s) => [s.id, s])).values());

const toolItems = allTags.flatMap((t) => t.items.filter((i) => i.type === 'tool'));
const uniqueTools = Array.from(new Map(toolItems.map((tool) => [tool.id, tool])).values());

const pageTitle = 'Categories & Topics — Robby roboter';
const pageDescription =
  'Explore hardware deep-dives, video tutorials, and interactive projects categorized across engineering disciplines.';
---

<Base title={pageTitle} meta_title={pageTitle} description={pageDescription} hideHero={true} hideVideos={true}>
  <div class="w-full">
    <!-- BENTO PAGE HEADER -->
    <section
      data-enter
      class="relative overflow-hidden rounded-3xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/75 backdrop-blur-xl p-6 sm:p-8 mb-6 shadow-sm"
    >
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400 mb-3.5 border border-emerald-500/20">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span>Browse Topics &amp; Media</span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-900 dark:text-white leading-tight">
            Categories &amp; Topics
          </h1>
          <p class="mt-2.5 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Explore {allPosts.length} articles, {allVideos.length} video tutorials, {uniqueSoftware.length} desktop
            apps, and {uniqueTools.length} interactive tools across {categories.length} disciplines and {totalTagsCount}{' '}
            tags.
          </p>
        </div>

        <!-- Bento Quick Stats (Interactive jump-to-type) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 shrink-0">
          <button
            type="button"
            data-stat-filter="article"
            class="stat-filter-card group rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/80 dark:bg-zinc-800/50 hover:bg-white dark:hover:bg-zinc-800 hover:border-blue-500/40 px-3.5 py-2.5 text-left transition-all duration-200 hover:-translate-y-0.5 active:scale-95 cursor-pointer"
          >
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400">Articles</span>
              <BookOpen className="w-3.5 h-3.5 text-blue-500 opacity-80 group-hover:opacity-100" />
            </div>
            <div class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white font-mono tabular-nums">
              {allPosts.length}
            </div>
          </button>

          <button
            type="button"
            data-stat-filter="video"
            class="stat-filter-card group rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/80 dark:bg-zinc-800/50 hover:bg-white dark:hover:bg-zinc-800 hover:border-red-500/40 px-3.5 py-2.5 text-left transition-all duration-200 hover:-translate-y-0.5 active:scale-95 cursor-pointer"
          >
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400">Videos</span>
              <Play className="w-3.5 h-3.5 text-red-500 opacity-80 group-hover:opacity-100" />
            </div>
            <div class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white font-mono tabular-nums">
              {allVideos.length}
            </div>
          </button>

          <button
            type="button"
            data-stat-filter="software"
            class="stat-filter-card group rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/80 dark:bg-zinc-800/50 hover:bg-white dark:hover:bg-zinc-800 hover:border-indigo-500/40 px-3.5 py-2.5 text-left transition-all duration-200 hover:-translate-y-0.5 active:scale-95 cursor-pointer"
          >
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400">Apps</span>
              <Cpu className="w-3.5 h-3.5 text-indigo-500 opacity-80 group-hover:opacity-100" />
            </div>
            <div class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white font-mono tabular-nums">
              {uniqueSoftware.length}
            </div>
          </button>

          <button
            type="button"
            data-stat-filter="tool"
            class="stat-filter-card group rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/80 dark:bg-zinc-800/50 hover:bg-white dark:hover:bg-zinc-800 hover:border-emerald-500/40 px-3.5 py-2.5 text-left transition-all duration-200 hover:-translate-y-0.5 active:scale-95 cursor-pointer"
          >
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-[11px] font-medium text-zinc-500 dark:text-zinc-400">Tools</span>
              <Wrench className="w-3.5 h-3.5 text-emerald-500 opacity-80 group-hover:opacity-100" />
            </div>
            <div class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white font-mono tabular-nums">
              {uniqueTools.length}
            </div>
          </button>
        </div>
      </div>
    </section>

    <!-- STICKY CATEGORY FILTER RAIL -->
    <nav
      aria-label="Category filter"
      class="sticky top-[61px] sm:top-[65px] z-30 mb-6 px-3 py-2.5 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-xl backdrop-saturate-150 border rounded-2xl border-zinc-200/70 dark:border-zinc-800/70 shadow-sm"
    >
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar" id="category-pills">
        <button
          type="button"
          data-category="all"
          aria-pressed="true"
          class="category-pill active inline-flex items-center gap-1.5 shrink-0 rounded-xl px-3.5 py-1.5 text-xs sm:text-sm font-medium transition-all active:scale-95 bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shadow-sm cursor-pointer"
        >
          <span>All Topics</span>
          <span class="rounded-full bg-white/20 dark:bg-black/10 px-1.5 py-0.5 text-[11px] font-mono tabular-nums font-semibold leading-none">
            {allPosts.length + allVideos.length}
          </span>
        </button>

        {categories.map((cat) => (
          <button
            type="button"
            data-category={cat.slug}
            aria-pressed="false"
            class="category-pill inline-flex items-center gap-1.5 shrink-0 rounded-xl px-3 py-1.5 text-xs sm:text-sm font-medium transition-all active:scale-95 bg-zinc-100/90 hover:bg-zinc-200/80 text-zinc-700 dark:bg-zinc-800/80 dark:hover:bg-zinc-700/80 dark:text-zinc-300 cursor-pointer"
          >
            <span>{cat.name}</span>
            <span class="rounded-full bg-zinc-200/80 dark:bg-zinc-700 px-1.5 py-0.5 text-[11px] font-mono tabular-nums font-semibold text-zinc-700 dark:text-zinc-300 leading-none">
              {cat.posts.length + cat.videos.length}
            </span>
          </button>
        ))}
      </div>
    </nav>

    <!-- TOPIC TAGS EXPLORER CARD -->
    <section
      id="topic-explorer"
      aria-label="Filter by topic tags"
      class="rounded-3xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/75 backdrop-blur-xl p-5 sm:p-6 mb-8 shadow-sm"
    >
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
            <Tag className="w-4 h-4" />
          </div>
          <div>
            <h2 class="text-sm sm:text-base font-bold text-zinc-900 dark:text-zinc-100 leading-tight">
              Topic Tags
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Filter articles, videos, apps, and tools by keyword
            </p>
          </div>
        </div>

        <div class="text-xs font-mono tabular-nums text-zinc-500 dark:text-zinc-400 self-start sm:self-center">
          Showing{' '}
          <span id="tag-active-count" class="font-semibold text-zinc-900 dark:text-white">
            {Math.min(INITIAL_VISIBLE_TAGS, totalTagsCount)}
          </span>{' '}
          of {totalTagsCount} tags
        </div>
      </div>

      <!-- Search + Type Filter Controls -->
      <div class="flex flex-col md:flex-row md:items-center gap-3 mb-4">
        <div class="relative flex-1">
          <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 pointer-events-none">
            <Search className="w-4 h-4" />
          </div>
          <input
            id="tag-search-input"
            type="text"
            aria-label="Search topic tags"
            placeholder="Search tags (e.g. Arduino, STM32, PCB, ESP32, DS1302)..."
            class="w-full pl-10 pr-16 py-2 text-xs sm:text-sm rounded-xl bg-zinc-50/80 dark:bg-zinc-800/80 border border-zinc-200/90 dark:border-zinc-700/80 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition-all"
          />
          <div class="absolute right-2.5 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
            <button
              type="button"
              id="tag-search-clear"
              aria-label="Clear search"
              class="hidden h-6 w-6 items-center justify-center rounded-lg text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-200/60 dark:hover:bg-zinc-700/60 transition-colors cursor-pointer"
            >
              <X className="w-3.5 h-3.5" />
            </button>
            <kbd id="tag-search-kbd" class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono">
              /
            </kbd>
          </div>
        </div>

        <!-- Tag Type Filters -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs font-medium shrink-0">
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="tag-filter-btn active inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 transition-all cursor-pointer shadow-sm text-xs"
          >
            <Layers className="w-3 h-3" />
            <span>All</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-white/20 dark:bg-black/10 font-mono tabular-nums leading-none">
              {totalTagsCount}
            </span>
          </button>

          <button
            type="button"
            data-filter="article"
            aria-pressed="false"
            class="tag-filter-btn inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-zinc-200/90 dark:border-zinc-700/60 bg-white dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer text-xs"
          >
            <BookOpen className="w-3 h-3 text-blue-500" />
            <span>Articles</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono tabular-nums leading-none">
              {withArticlesCount}
            </span>
          </button>

          <button
            type="button"
            data-filter="video"
            aria-pressed="false"
            class="tag-filter-btn inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-zinc-200/90 dark:border-zinc-700/60 bg-white dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer text-xs"
          >
            <Play className="w-3 h-3 text-red-500" />
            <span>Videos</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-red-500/10 text-red-600 dark:text-red-400 font-mono tabular-nums leading-none">
              {withVideosCount}
            </span>
          </button>

          <button
            type="button"
            data-filter="software"
            aria-pressed="false"
            class="tag-filter-btn inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-zinc-200/90 dark:border-zinc-700/60 bg-white dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer text-xs"
          >
            <Cpu className="w-3 h-3 text-indigo-500" />
            <span>Software</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-mono tabular-nums leading-none">
              {withSoftwareCount}
            </span>
          </button>

          <button
            type="button"
            data-filter="tool"
            aria-pressed="false"
            class="tag-filter-btn inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-zinc-200/90 dark:border-zinc-700/60 bg-white dark:bg-zinc-800/60 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer text-xs"
          >
            <Wrench className="w-3 h-3 text-emerald-500" />
            <span>Tools</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono tabular-nums leading-none">
              {withToolsCount}
            </span>
          </button>
        </div>
      </div>

      <!-- TAGS GRID -->
      <div id="tags-container" class="flex flex-wrap gap-2">
        {allTags.map((tag, index) => (
          <button
            type="button"
            aria-pressed="false"
            class={`tag-cloud-chip group relative items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-zinc-200/90 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/70 hover:bg-white dark:hover:bg-zinc-800 hover:border-emerald-500/50 dark:hover:border-emerald-500/40 transition-all duration-150 active:scale-95 cursor-pointer text-left ${
              index >= INITIAL_VISIBLE_TAGS ? 'hidden' : 'inline-flex'
            }`}
            data-tag-index={index}
            data-tag-slug={tag.slug}
            data-tag-name={tag.name.toLowerCase()}
            data-has-article={tag.articleCount > 0 ? 'true' : 'false'}
            data-has-video={tag.videoCount > 0 ? 'true' : 'false'}
            data-has-software={tag.softwareCount > 0 ? 'true' : 'false'}
            data-has-tool={tag.toolCount > 0 ? 'true' : 'false'}
            title={`${tag.totalCount} items in #${tag.name}`}
          >
            <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400">#</span>
            <span class="tag-chip-label text-xs font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-emerald-700 dark:group-hover:text-emerald-300 transition-colors">
              {tag.name}
            </span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] font-mono tabular-nums font-medium bg-zinc-200/70 dark:bg-zinc-700/80 text-zinc-600 dark:text-zinc-400 group-hover:bg-emerald-500/15 group-hover:text-emerald-700 dark:group-hover:text-emerald-300 transition-colors leading-none">
              {tag.totalCount}
            </span>
          </button>
        ))}
      </div>

      {totalTagsCount > INITIAL_VISIBLE_TAGS && (
        <div id="tags-toggle-wrap" class="mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800/60 flex justify-center">
          <button
            type="button"
            id="toggle-all-tags-btn"
            aria-expanded="false"
            class="inline-flex items-center gap-1.5 rounded-xl px-3.5 py-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white bg-zinc-100/80 hover:bg-zinc-200/70 dark:bg-zinc-800/70 dark:hover:bg-zinc-800 transition-all active:scale-95 cursor-pointer"
          >
            <span id="toggle-all-tags-label">Show all {totalTagsCount} tags</span>
            <ChevronDown id="toggle-all-tags-icon" className="w-3.5 h-3.5 transition-transform duration-200" />
          </button>
        </div>
      )}

      <div id="tag-empty-state" class="hidden text-center py-6">
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mb-3">
          No matching tags found. Try a different keyword or reset the type filter.
        </p>
        <button
          type="button"
          id="reset-tag-search-btn"
          class="inline-flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-medium bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 transition-colors cursor-pointer"
        >
          <RotateCcw className="w-3.5 h-3.5" />
          <span>Reset search</span>
        </button>
      </div>
    </section>

    <!-- ACTIVE FILTER NOTIFICATION / RESET BAR -->
    <div
      id="active-filter-bar"
      class="hidden items-center justify-between gap-3 px-4 py-3 mb-8 rounded-2xl bg-emerald-500/10 dark:bg-emerald-500/15 border border-emerald-500/25 text-xs sm:text-sm text-emerald-950 dark:text-emerald-100 shadow-sm"
    >
      <div class="flex items-center gap-2 min-w-0">
        <Sparkles className="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
        <span class="truncate">
          Filtered by:{' '}
          <strong id="active-filter-label" class="font-bold underline decoration-emerald-500/60 underline-offset-2"></strong>
        </span>
        <span id="active-filter-counts" class="hidden sm:inline font-mono tabular-nums text-xs opacity-75 shrink-0"></span>
      </div>

      <button
        type="button"
        id="clear-filter-btn"
        class="inline-flex items-center gap-1.5 shrink-0 px-3 py-1.5 rounded-xl bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 font-semibold shadow-xs hover:bg-zinc-50 dark:hover:bg-zinc-800 border border-zinc-200/90 dark:border-zinc-700 transition-all active:scale-95 cursor-pointer text-xs"
      >
        <X className="w-3.5 h-3.5" />
        <span>Clear</span>
      </button>
    </div>

    <!-- 1. CATEGORY SECTIONS CONTAINER (Default View) -->
    <div class="space-y-14" id="categories-container">
      {categories.map((cat) => (
        <section id={cat.slug} data-category-section={cat.slug} class="category-section scroll-mt-36">
          <!-- Category Title Header -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-zinc-200/70 dark:border-zinc-800 mb-6">
            <div class="flex items-center gap-3">
