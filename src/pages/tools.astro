---
import Base from "@layouts/Base.astro";
import {
  Wrench,
  Monitor,
  Sparkles,
  Layers,
  ArrowRight,
  ExternalLink,
  CheckCircle2,
  Cpu,
  Tv,
  QrCode,
  Zap,
} from "lucide-react";

const pageTitle = "Hardware & Embedded Web Tools — Robby roboter";
const pageDescription =
  "Interactive browser utilities, display simulators, and workshop helpers for electronics engineers and makers, including LCD Character Generator, SSD1306 OLED Simulator, and Component Label Generator.";

const tools = [
  {
    id: "lcd-character-generator",
    title: "LCD Custom Character Generator",
    tagline: "5x8 Pixel Matrix Designer for HD44780 Character Displays",
    shortDescription:
      "Interactive pixel matrix designer for 5x8 character LCD modules. Draw custom icons, symbols, and glyphs by clicking or dragging across pixels, and generate production-ready Arduino & C binary byte arrays in real-time.",
    category: "Embedded Displays",
    statusBadge: "Interactive Web Tool",
    statusColor: "emerald",
    platforms: ["Browser / Canvas", "Arduino & C/C++"],
    techStack: ["React", "HTML5 Canvas", "C/C++ CodeGen", "HD44780", "Arduino"],
    features: [
      "Interactive 5x8 pixel grid toggling with click-and-drag drawing",
      "Real-time Arduino byte customChar[8] code array generation",
      "Live preview rendered on a simulated 16x2 green LCD display",
      "One-click copy, clear, invert, and shift controls",
    ],
    toolUrl: "/tools/lcd-character-generator",
    previewImage: "/images/tools/lcd-generator.jpg",
    accentColor: "from-emerald-500 to-teal-500",
    buttonBg: "bg-emerald-600 hover:bg-emerald-500",
  },
  {
    id: "oled-simulator",
    title: "SSD1306 OLED Simulator",
    tagline: "128x64 Monochrome I2C/SPI OLED Simulator & Code Runner",
    shortDescription:
      "Simulate Adafruit SSD1306 and U8g2 commands directly in your browser. Render text, lines, geometric primitives, and bitmap graphics on a virtual 128x64 pixel display with live JavaScript execution.",
    category: "Display Emulation",
    statusBadge: "Live Emulator",
    statusColor: "sky",
    platforms: ["Browser Virtual Screen", "Adafruit_GFX / U8g2"],
    techStack: ["JavaScript", "Canvas 2D", "SSD1306", "I2C / SPI", "Adafruit_GFX"],
    features: [
      "Real-time 128x64 monochrome pixel buffer rendering with glow effect",
      "Text, line, circle, rectangle, and bitmap draw primitives",
      "Interactive code runner with built-in graphic demo presets",
      "Export rendered frame to C byte array (XBM / PROGMEM)",
    ],
    toolUrl: "/tools/oled-simulator",
    previewImage: "/images/tools/oled-simulator.jpg",
    accentColor: "from-sky-500 to-cyan-500",
    buttonBg: "bg-sky-600 hover:bg-sky-500",
  },
  {
    id: "label-generator",
    title: "Component Label Generator",
    tagline: "SMD & Through-Hole Drawer Labels with Dynamic QR Codes",
    shortDescription:
      "Design and export clean, printable storage labels for electronic component drawers and organizers. Generates dynamic QR codes linked to datasheets or inventory, package footprint previews, and high-DPI SVG export.",
    category: "Workshop & Lab",
    statusBadge: "Vector SVG Export",
    statusColor: "amber",
    platforms: ["Print Ready", "SVG Vector"],
    techStack: ["SVG Vector", "QRCode Generator", "Print Ready", "SMD / THT", "CSS Grid"],
    features: [
      "Dynamic QR code generation for part URLs and specs",
      "Preset dimensions for popular organizer drawers (Raaco, Akro-Mils)",
      "High-resolution SVG vector output for direct printing",
      "Customizable package outlines (0805, SOIC, TO-220, DIP)",
    ],
    toolUrl: "/tools/label-generator",
    previewImage: "/images/tools/label-generator.jpg",
    accentColor: "from-amber-500 to-orange-500",
    buttonBg: "bg-amber-600 hover:bg-amber-500",
  },
];
---

<Base
  title={pageTitle}
  meta_title={pageTitle}
  description={pageDescription}
  hideHero={true}
  hideVideos={true}
  fullWidth={false}
>
  <div class="py-4">
    {/* HEADER SECTION */}
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 mb-4 text-xs font-mono font-medium rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-sm backdrop-blur-sm">
        <Zap className="w-3.5 h-3.5" />
        <span>Interactive Electronics &amp; Embedded Utilities</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4 text-zinc-900 dark:text-white">
        Hardware &amp; Embedded Web Tools
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Interactive browser utilities, display simulators, and workshop helpers built for makers and electronics enthusiasts.
      </p>
    </div>

    {/* TOOLS CARDS LIST */}
    <div class="space-y-10 max-w-4xl mx-auto">
      {tools.map((tool) => (
        <article
          key={tool.id}
          class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col md:flex-row group"
        >
          {/* LEFT: PREVIEW IMAGE */}
          <div class="md:w-5/12 bg-zinc-950 relative overflow-hidden flex items-center justify-center min-h-[220px] md:min-h-[280px]">
            <a href={tool.toolUrl} class="block w-full h-full relative group/img overflow-hidden">
              <img
                src={tool.previewImage}
                alt={`${tool.title} interface preview`}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover/img:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent md:bg-gradient-to-r md:from-transparent md:to-zinc-900/40"></div>
              <div class="absolute bottom-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded bg-zinc-900/90 text-white text-[11px] font-mono backdrop-blur-md border border-white/10 opacity-0 group-hover/img:opacity-100 transition-opacity">
                <span>Launch Tool</span>
                <ArrowRight className="w-3 h-3" />
              </div>
            </a>
          </div>

          {/* RIGHT: DETAILS */}
          <div class="md:w-7/12 p-6 sm:p-8 flex flex-col justify-between">
            <div>
              {/* TOP TAGS */}
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                  {tool.category}
                </span>

                <span
                  class={`text-[11px] font-mono px-2.5 py-0.5 rounded-full font-medium ${
                    tool.statusColor === 'emerald'
                      ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20'
                      : tool.statusColor === 'sky'
                      ? 'bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20'
                      : 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20'
                  }`}
                >
                  {tool.statusBadge}
                </span>
              </div>

              {/* TITLE & TAGLINE */}
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                <a href={tool.toolUrl}>{tool.title}</a>
              </h2>

              <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-3">
                {tool.tagline}
              </p>

              {/* SHORT DESCRIPTION */}
              <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
                {tool.shortDescription}
              </p>

              {/* HIGHLIGHTED FEATURES */}
              <ul class="space-y-1.5 mb-5 text-xs text-zinc-600 dark:text-zinc-400">
                {tool.features.slice(0, 3).map((feat, idx) => (
                  <li key={idx} class="flex items-start gap-2">
                    <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 mt-0.5 flex-shrink-0" />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              {/* TECH PILLS */}
              <div class="flex flex-wrap gap-1.5 mb-6">
                {tool.techStack.map((tech) => (
                  <span
                    key={tech}
                    class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/60"
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            {/* ACTION BUTTONS */}
            <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-zinc-100 dark:border-zinc-800">
              <a
                href={tool.toolUrl}
                class={`px-4 py-2 rounded-lg text-xs font-semibold text-white shadow-md transition-all flex items-center gap-1.5 group/btn ${tool.buttonBg}`}
              >
                <span>Launch Tool</span>
                <ArrowRight className="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform" />
              </a>

              <span class="text-[11px] font-mono text-zinc-400 ml-auto">
                {tool.platforms.join(" • ")}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>