    function generateCCode() {
      const targetEl = document.getElementById('code-target-select');
      const outEl = document.getElementById('c-code-output');
      if (!targetEl || !outEl) return;
      const target = targetEl.value;
      const regs = state.computed.registers;

      const initSequence = [];
      initSequence.push([3, 0xFF, 'Disable all outputs']);
      for (let r = 16; r <= 23; r++) initSequence.push([r, 0x80, `Power down CLK${r - 16}`]);
      initSequence.push([183, regs[183], `XTAL_CL (${state.xtalCl === 1 ? '6pF' : state.xtalCl === 2 ? '8pF' : '10pF'})`]);
      initSequence.push([187, regs[187], 'Fanout Enable']);
      initSequence.push([15, regs[15], 'PLL Source = XTAL']);
      initSequence.push([24, regs[24], 'Disable State']);
      for (let r = 26; r <= 41; r++) initSequence.push([r, regs[r], getRegDescription(r)]);
      for (let r = 42; r <= 65; r++) initSequence.push([r, regs[r], getRegDescription(r)]);
      if (state.computed.pllA.ssEnabled) {
        for (let r = 149; r <= 161; r++) initSequence.push([r, regs[r], getRegDescription(r)]);
      } else {
        initSequence.push([149, 0x00, 'Spread Spectrum Off']);
      }
      for (let r = 165; r <= 167; r++) initSequence.push([r, regs[r], getRegDescription(r)]);
      initSequence.push([177, regs[177], 'Soft-Reset PLLA/B']);
      for (let r = 16; r <= 18; r++) initSequence.push([r, regs[r], getRegDescription(r)]);
      initSequence.push([3, regs[3], 'Enable active outputs']);

      const arrayEntries = initSequence.map(([r, v, comment]) =>
        `    { 0x${r.toString(16).toUpperCase().padStart(2, '0')}, 0x${v.toString(16).toUpperCase().padStart(2, '0')} }, // ${comment}`
      ).join('\n');

      const summaryHeader = `/* Si5351A Integer-Only Config | XTAL: ${state.computed.effectiveXtalHz.toFixed(0)} Hz (${state.xtalPpm} ppm)
 * PLLA: ${state.computed.pllA.active ? (state.computed.pllA.vcoHz / 1e6).toFixed(4) + ' MHz' : 'OFF'} | PLLB: ${state.computed.pllB.active ? (state.computed.pllB.vcoHz / 1e6).toFixed(4) + ' MHz' : 'OFF'}
 * CLK0: ${state.computed.ch[0]?.active ? formatFreqHz(state.computed.ch[0].actualHz) : 'OFF'} | CLK1: ${state.computed.ch[1]?.active ? formatFreqHz(state.computed.ch[1].actualHz) : 'OFF'} | CLK2: ${state.computed.ch[2]?.active ? formatFreqHz(state.computed.ch[2].actualHz) : 'OFF'} */`;

      let fullCode = '';
      // AN619 §3: after Reg 177 (PLL soft reset) give the PLLs ~1–2 ms to lock before
      // Reg 3 (OEB) enables the outputs, so no unlocked/glitchy clock reaches the pins.
      if (target === 'raw_array') {
        fullCode = `${summaryHeader}\n#include <stdint.h>\n#define SI5351_I2C_ADDR 0x60\n\n/* NOTE: wait ~2 ms after writing Reg 177 (PLL soft reset) before writing Reg 3 (enable outputs). */\nstatic const uint8_t si5351_reg_config[][2] = {\n${arrayEntries}\n};\n`;
      } else if (target === 'ch32v003') {
        fullCode = `${summaryHeader}\n#ifndef SI5351_CONFIG_H\n#define SI5351_CONFIG_H\n#include <stdint.h>\n#define SI5351_I2C_ADDR 0x60\n\n/* PLL lock wait after Reg 177 soft reset (~2 ms @ 48 MHz).\n * Override before including, e.g.: #define SI5351_PLL_LOCK_DELAY() Delay_Ms(2) */\n#ifndef SI5351_PLL_LOCK_DELAY\n#define SI5351_PLL_LOCK_DELAY() do { for (volatile uint32_t _d = 0; _d < 24000UL; _d++) { } } while (0)\n#endif\n\nstatic const uint8_t si5351_init_regs[][2] = {\n${arrayEntries}\n};\n\nextern void si5351_i2c_write_reg(uint8_t reg, uint8_t val);\nstatic inline void si5351_apply_preset(void) {\n    for (uint16_t i = 0; i < sizeof(si5351_init_regs)/2; i++) {\n        si5351_i2c_write_reg(si5351_init_regs[i][0], si5351_init_regs[i][1]);\n        if (si5351_init_regs[i][0] == 177) SI5351_PLL_LOCK_DELAY(); /* let PLLs lock before OEB */\n    }\n}\n#endif\n`;
      } else if (target === 'arduino') {
        fullCode = `${summaryHeader}\n#include <Wire.h>\n#define SI5351_I2C_ADDR 0x60\n\nstatic const uint8_t si5351_init_regs[][2] = {\n${arrayEntries}\n};\n\nvoid si5351_apply_preset() {\n    for (uint16_t i = 0; i < sizeof(si5351_init_regs)/2; i++) {\n        Wire.beginTransmission(SI5351_I2C_ADDR);\n        Wire.write(si5351_init_regs[i][0]);\n        Wire.write(si5351_init_regs[i][1]);\n        Wire.endTransmission();\n        if (si5351_init_regs[i][0] == 177) delay(2); // let PLLs lock before OEB (Reg 3)\n    }\n}\n`;
      } else if (target === 'stm32') {
        fullCode = `${summaryHeader}\n#include "main.h"\n#define SI5351_I2C_ADDR_8BIT (0x60 << 1)\n\nstatic const uint8_t si5351_init_regs[][2] = {\n${arrayEntries}\n};\n\nHAL_StatusTypeDef si5351_apply_preset(I2C_HandleTypeDef *hi2c) {\n    for (uint16_t i = 0; i < sizeof(si5351_init_regs)/2; i++) {\n        uint8_t val = si5351_init_regs[i][1];\n        if (HAL_I2C_Mem_Write(hi2c, SI5351_I2C_ADDR_8BIT, si5351_init_regs[i][0], 1, &val, 1, 10) != HAL_OK) return HAL_ERROR;\n        if (si5351_init_regs[i][0] == 177) HAL_Delay(2); /* let PLLs lock before OEB (Reg 3) */\n    }\n    return HAL_OK;\n}\n`;
      }

      outEl.textContent = fullCode;
    }

    function fallbackCopyText(text) {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.readOnly = true;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch (err) {
        ok = false;
      }
      document.body.removeChild(textarea);
      return ok;
    }

    async function copyCCode() {
      const codeText = document.getElementById('c-code-output')?.textContent || '';
      if (!codeText) {
        showToast('Nothing to copy yet.', 'warn');
        return;
      }
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(codeText);
          showToast('Copied C header to clipboard!', 'success');
          return;
        }
      } catch (err) {
        /* fall through to legacy execCommand */
      }
      if (fallbackCopyText(codeText)) {
        showToast('Copied C header to clipboard!', 'success');
      } else {
        showToast('Copy failed — select manually.', 'warn');
      }
    }

    function downloadCCode() {
      const codeText = document.getElementById('c-code-output')?.textContent || '';
      if (!codeText) {
        showToast('Nothing to download yet.', 'warn');
        return;
      }
      const blob = new Blob([codeText], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'si5351_config.h';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Downloaded si5351_config.h', 'success');
    }

