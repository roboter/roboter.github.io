  <script is:inline>
    (function () {
      if (!document.getElementById('channels-grid')) return;
      /***************************************************************************
       * Si5351A Compact Synthesizer & Register Calculation Engine
       ***************************************************************************/

    const FREQ_PRESETS = [
      { label: '8k', hz: 8000 },
      { label: '455k', hz: 455000 },
      { label: '10.7M', hz: 10700000 },
      { label: '14.2M', hz: 14200000 },
      { label: '27.185M', hz: 27185000 },
      { label: '145M', hz: 145000000 }
    ];

    const OPERATING_MODES = [
      { id: 'off', label: 'Off / Disabled' },
      { id: 'fractional', label: 'Fractional MultiSynth (Any Freq)' },
      { id: 'integer', label: 'Integer Low-Jitter Mode' },
      { id: 'quadrature', label: 'Quadrature I/Q 90° (CLK0+1)' },
      { id: 'phase', label: 'Custom Phase Offset (0°–360°)' },
      { id: 'differential', label: 'Differential Pair (180° Inv)' },
      { id: 'spread', label: 'Spread Spectrum (PLLA EMI)' },
      { id: 'bypass', label: 'Direct XTAL Bypass (25 MHz)' }
    ];

    const STEP_SIZES = [
      { label: '10', hz: 10 },
      { label: '100', hz: 100 },
      { label: '1k', hz: 1000 },
      { label: '10k', hz: 10000 },
      { label: '100k', hz: 100000 },
      { label: '1M', hz: 1000000 }
    ];

    const R_DIV_OPTIONS = ['Auto', '/1', '/2', '/4', '/8', '/16', '/32', '/64', '/128'];
    const R_DIV_VALUES = [1, 1, 2, 4, 8, 16, 32, 64, 128];

    const LOG_MIN_HZ = 8000;
    const LOG_MAX_HZ = 160000000;

    function hzToLogSlider(hz) {
      const clamped = Math.max(LOG_MIN_HZ, Math.min(LOG_MAX_HZ, hz));
      const norm = Math.log(clamped / LOG_MIN_HZ) / Math.log(LOG_MAX_HZ / LOG_MIN_HZ);
      return Math.round(norm * 1000);
    }

    function logSliderToHz(pos) {
      const norm = Math.max(0, Math.min(1000, pos)) / 1000;
      const raw = LOG_MIN_HZ * Math.pow(LOG_MAX_HZ / LOG_MIN_HZ, norm);
      if (raw < 100000) return Math.round(raw / 10) * 10;
      if (raw < 1000000) return Math.round(raw / 100) * 100;
      if (raw < 20000000) return Math.round(raw / 1000) * 1000;
      return Math.round(raw / 10000) * 10000;
    }

    function formatFreqHz(hz) {
      if (!Number.isFinite(hz) || hz <= 0) return '0.000000 Hz';
      if (hz >= 1e6) return (hz / 1e6).toFixed(6) + ' MHz';
      if (hz >= 1e3) return (hz / 1e3).toFixed(4) + ' kHz';
      return hz.toFixed(2) + ' Hz';
    }

    function formatShortFreq(hz) {
      if (!Number.isFinite(hz) || hz <= 0) return '0Hz';
      if (hz >= 1e6) return (hz / 1e6).toFixed(3) + 'M';
      if (hz >= 1e3) return (hz / 1e3).toFixed(2) + 'k';
      return Math.round(hz) + 'Hz';
    }

    const state = {
      activeTab: 'diagram',
      xtalBaseHz: 25000000,
      xtalPpm: 0,
      xtalCl: 3,
      fanoutXo: true,
      fanoutMs: true,
      fanoutClkin: false,
      scopePaused: false,
      scopePhase: 0,
      scopeTimebase: 'auto',
      scopeTriggered: false,
      channels: [
        {
          id: 0, name: 'CLK0', label: 'CH0 / CLK0', accent: 'cyan', mode: 'fractional',
          baseHz: 14200000, fineTrimHz: 0, stepHz: 1000, pll: 'A',
          drive: 3, rDivOverride: 0, invert: false, disableState: 0,
          phaseDegTarget: 0, phaseReg: 0, ssPercent: 1.0, ssCenter: false
        },
        {
          id: 1, name: 'CLK1', label: 'CH1 / CLK1', accent: 'amber', mode: 'fractional',
          baseHz: 10700000, fineTrimHz: 0, stepHz: 1000, pll: 'B',
          drive: 2, rDivOverride: 0, invert: false, disableState: 0,
          phaseDegTarget: 0, phaseReg: 0, ssPercent: 1.0, ssCenter: false
        },
        {
          id: 2, name: 'CLK2', label: 'CH2 / CLK2', accent: 'purple', mode: 'off',
          baseHz: 8000, fineTrimHz: 0, stepHz: 100, pll: 'B',
          drive: 1, rDivOverride: 0, invert: false, disableState: 2,
          phaseDegTarget: 0, phaseReg: 0, ssPercent: 1.0, ssCenter: false
        }
      ],
      computed: {
        effectiveXtalHz: 25000000,
        pllA: { active: true, vcoHz: 800000000, a: 32, b: 0, c: 1, isInt: true, inSpec: true, ssEnabled: false, users: ['CLK0'] },
        pllB: { active: true, vcoHz: 800000000, a: 32, b: 0, c: 1, isInt: true, inSpec: true, ssEnabled: false, users: ['CLK1'] },
        ch: [null, null, null],
        registers: new Uint8Array(256),
        modifiedRegs: new Set()
      }
    };

    const ACCENT_STYLES = {
      cyan: {
        border: 'border-cyan-500/40',
        dot: 'bg-cyan-400',
        text: 'text-cyan-400',
        btnActive: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/50',
        sliderAccent: '#06b6d4',
        sliderGlow: 'rgba(6, 182, 212, 0.55)'
      },
      amber: {
        border: 'border-amber-500/40',
        dot: 'bg-amber-400',
        text: 'text-amber-400',
        btnActive: 'bg-amber-500/20 text-amber-300 border-amber-500/50',
        sliderAccent: '#f59e0b',
        sliderGlow: 'rgba(245, 158, 11, 0.55)'
      },
      purple: {
        border: 'border-purple-500/40',
        dot: 'bg-purple-400',
        text: 'text-purple-400',
        btnActive: 'bg-purple-500/20 text-purple-300 border-purple-500/50',
        sliderAccent: '#a855f7',
        sliderGlow: 'rgba(168, 85, 247, 0.55)'
      }
    };

    /***************************************************************************
     * Toast & Workspace Navigation Helpers
     ***************************************************************************/
    function showToast(msg, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const el = document.createElement('div');
      const palette = type === 'success'
        ? 'bg-emerald-950/95 border-emerald-500/50 text-emerald-200'
        : type === 'warn'
          ? 'bg-amber-950/95 border-amber-500/50 text-amber-200'
          : 'bg-slate-900/95 border-cyan-500/50 text-cyan-200';
      el.className = `px-3 py-1.5 rounded border text-[11px] font-mono shadow-lg backdrop-blur transition-opacity duration-300 ${palette}`;
      el.textContent = msg;
      container.appendChild(el);
      setTimeout(() => {
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 300);
      }, 2200);
    }

    function switchWorkspaceTab(tab) {
      state.activeTab = tab;
      ['diagram', 'regs', 'code', 'docs', 'wch'].forEach(t => {
        const btn = document.getElementById(`tab-btn-${t}`);
        const pane = document.getElementById(`tab-pane-${t}`);
        const tools = document.getElementById(`tab-tools-${t}`);
        const isActive = t === tab;
        if (btn) {
          btn.className = isActive
            ? 'px-2.5 py-1 text-[11px] font-medium rounded bg-cyan-600 text-white transition'
            : 'px-2.5 py-1 text-[11px] font-medium rounded text-slate-400 hover:text-slate-200 transition';
        }
        if (pane) pane.classList.toggle('hidden', !isActive);
        if (tools) tools.classList.toggle('hidden', !isActive);
      });
    }

    /***************************************************************************
     * Global XTAL, Calibration PPM & Fanout Controls
     ***************************************************************************/
    function onXtalSelectChange() {
      const sel = document.getElementById('xtal-select');
      const customWrap = document.getElementById('xtal-custom-wrap');
      if (sel.value === 'custom') {
        customWrap.classList.remove('hidden');
        const customVal = parseFloat(document.getElementById('xtal-custom-hz').value);
        if (Number.isFinite(customVal) && customVal >= 10000000 && customVal <= 40000000) {
          state.xtalBaseHz = customVal;
        }
      } else {
        customWrap.classList.add('hidden');
        state.xtalBaseHz = parseFloat(sel.value) || 25000000;
      }
      recalculateAll();
    }

    function onXtalCustomInput(val) {
      const hz = parseFloat(val);
      if (Number.isFinite(hz) && hz >= 10000000 && hz <= 40000000) {
        state.xtalBaseHz = hz;
        recalculateAll();
      }
    }

    function onXtalClChange(val) {
      state.xtalCl = parseInt(val, 10) || 3;
      recalculateAll();
    }

    function syncPpmFromSlider(val) {
      const ppm = Math.max(-500, Math.min(500, parseInt(val, 10) || 0));
      state.xtalPpm = ppm;
      const inp = document.getElementById('xtal-ppm');
      if (inp) inp.value = ppm;
      recalculateAll();
    }

    function syncPpmFromInput(val) {
      const parsed = parseFloat(val);
      if (!Number.isFinite(parsed)) return;
      const ppm = Math.max(-500, Math.min(500, Math.round(parsed)));
      state.xtalPpm = ppm;
      const sld = document.getElementById('xtal-ppm-slider');
      if (sld) sld.value = ppm;
      recalculateAll();
    }

    function adjustPpm(delta) {
      setPpm(state.xtalPpm + delta);
    }

    function setPpm(val) {
      const ppm = Math.max(-500, Math.min(500, Math.round(val)));
      state.xtalPpm = ppm;
      const inp = document.getElementById('xtal-ppm');
      const sld = document.getElementById('xtal-ppm-slider');
      if (inp) inp.value = ppm;
      if (sld) sld.value = ppm;
      recalculateAll();
    }

    function onFanoutChange() {
      state.fanoutXo = document.getElementById('fanout-xo').checked;
      state.fanoutMs = document.getElementById('fanout-ms').checked;
      state.fanoutClkin = document.getElementById('fanout-clkin').checked;
      recalculateAll();
    }

    /***************************************************************************
     * Channel Control Handlers & Coupling Synchronization
     ***************************************************************************/
    function getChannelTotalHz(ch) {
      return Math.max(1000, Math.min(225000000, Math.round(ch.baseHz + ch.fineTrimHz)));
    }

    function syncChannelFrequencyUI(idx) {
      const ch = state.channels[idx];
      const totalHz = getChannelTotalHz(ch);
      const directEl = document.getElementById(`ch-${idx}-direct-hz`);
      const logEl = document.getElementById(`ch-${idx}-log-slider`);
      const trimEl = document.getElementById(`ch-${idx}-trim-slider`);
      const trimValEl = document.getElementById(`ch-${idx}-trim-val`);
      if (directEl && document.activeElement !== directEl) directEl.value = totalHz;
      if (logEl) logEl.value = hzToLogSlider(ch.baseHz);
      if (trimEl) trimEl.value = ch.fineTrimHz;
      if (trimValEl) {
        trimValEl.textContent = `${ch.fineTrimHz >= 0 ? '+' : ''}${ch.fineTrimHz.toLocaleString()} Hz`;
      }
    }

    function enforceCouplingRules(changedIdx) {
      const ch0 = state.channels[0];
      const ch1 = state.channels[1];

      // Quadrature I/Q 90° Mode: couple CLK0 & CLK1 on PLLA with equal freq and 90° phase offset
      if (ch0.mode === 'quadrature' || ch1.mode === 'quadrature') {
        const master = changedIdx === 1 ? ch1 : ch0;
        ch0.mode = 'quadrature';
        ch1.mode = 'quadrature';
        ch0.pll = 'A';
        ch1.pll = 'A';
        ch0.baseHz = master.baseHz;
        ch0.fineTrimHz = master.fineTrimHz;
        ch1.baseHz = master.baseHz;
        ch1.fineTrimHz = master.fineTrimHz;
        ch0.phaseDegTarget = 0;
        ch1.phaseDegTarget = 90;
      } else if (ch0.mode === 'differential' || ch1.mode === 'differential') {
        // Differential 180° Mode: couple CLK0 & CLK1 on PLLA with equal freq and CLK1 inverted
        const master = changedIdx === 1 ? ch1 : ch0;
        ch0.mode = 'differential';
        ch1.mode = 'differential';
        ch0.pll = 'A';
        ch1.pll = 'A';
        ch0.baseHz = master.baseHz;
        ch0.fineTrimHz = master.fineTrimHz;
        ch1.baseHz = master.baseHz;
        ch1.fineTrimHz = master.fineTrimHz;
        ch0.phaseDegTarget = 0;
        ch1.phaseDegTarget = 0;
        ch0.invert = false;
        ch1.invert = true;
      }

      // Spread spectrum is only supported by hardware on PLLA
      state.channels.forEach(ch => {
        if (ch.mode === 'spread') {
          ch.pll = 'A';
        }
      });
    }

    function updateChannelField(idx, field, value) {
      const ch = state.channels[idx];
      if (!ch) return;

      const prevMode = ch.mode;
      ch[field] = value;

      // If switching INTO quadrature, start with non-inverted I/Q outputs
      if (field === 'mode' && value === 'quadrature' && prevMode !== 'quadrature') {
        state.channels[0].invert = false;
        state.channels[1].invert = false;
      }

      // If switching OUT of a coupled mode on CH0 or CH1, uncouple the partner cleanly
      if (field === 'mode' && (idx === 0 || idx === 1)) {
        const partnerIdx = idx === 0 ? 1 : 0;
        const partner = state.channels[partnerIdx];
        if ((prevMode === 'quadrature' || prevMode === 'differential') &&
            value !== 'quadrature' && value !== 'differential') {
          if (partner.mode === prevMode) {
            partner.mode = 'fractional';
            partner.invert = false;
            partner.phaseDegTarget = 0;
          }
          ch.invert = false;
          ch.phaseDegTarget = 0;
        }
      }

      enforceCouplingRules(idx);

      if (field === 'mode' || field === 'pll' || field === 'stepHz') {
        renderChannelCards();
      }
      recalculateAll();
    }

    function applyChannelPreset(idx, hz) {
      const ch = state.channels[idx];
      if (!ch || ch.mode === 'off' || ch.mode === 'bypass') return;
      ch.baseHz = hz;
      ch.fineTrimHz = 0;
      enforceCouplingRules(idx);
      syncChannelFrequencyUI(idx);
      if (ch.mode === 'quadrature' || ch.mode === 'differential') {
        syncChannelFrequencyUI(0);
        syncChannelFrequencyUI(1);
      }
      recalculateAll();
    }

    function setChannelStep(idx, stepHz) {
      const ch = state.channels[idx];
      if (!ch) return;
      ch.stepHz = stepHz;
      renderChannelCards();
      recalculateAll();
    }

    function nudgeChannelFreq(idx, dir) {
      const ch = state.channels[idx];
      if (!ch || ch.mode === 'off' || ch.mode === 'bypass') return;
      const current = getChannelTotalHz(ch);
      const next = Math.max(1000, Math.min(225000000, current + dir * ch.stepHz));
      ch.baseHz = next;
      ch.fineTrimHz = 0;
      enforceCouplingRules(idx);
      syncChannelFrequencyUI(idx);
      if (ch.mode === 'quadrature' || ch.mode === 'differential') {
        syncChannelFrequencyUI(0);
        syncChannelFrequencyUI(1);
      }
      recalculateAll();
    }

    function onChannelDirectHzInput(idx, rawVal) {
      const ch = state.channels[idx];
      if (!ch) return;
      const hz = parseFloat(rawVal);
      if (!Number.isFinite(hz) || hz < 1000 || hz > 225000000) return;
      ch.baseHz = Math.round(hz);
      ch.fineTrimHz = 0;
      enforceCouplingRules(idx);
      const logEl = document.getElementById(`ch-${idx}-log-slider`);
      const trimEl = document.getElementById(`ch-${idx}-trim-slider`);
      const trimValEl = document.getElementById(`ch-${idx}-trim-val`);
      if (logEl) logEl.value = hzToLogSlider(ch.baseHz);
      if (trimEl) trimEl.value = 0;
      if (trimValEl) trimValEl.textContent = '+0 Hz';
      if (ch.mode === 'quadrature' || ch.mode === 'differential') {
        syncChannelFrequencyUI(0);
        syncChannelFrequencyUI(1);
      }
      recalculateAll();
    }

    function onChannelLogSlider(idx, sliderPos) {
      const ch = state.channels[idx];
      if (!ch) return;
      ch.baseHz = logSliderToHz(parseInt(sliderPos, 10));
      enforceCouplingRules(idx);
      syncChannelFrequencyUI(idx);
      if (ch.mode === 'quadrature' || ch.mode === 'differential') {
        syncChannelFrequencyUI(0);
        syncChannelFrequencyUI(1);
      }
      recalculateAll();
    }

    function onChannelFineTrimSlider(idx, trimVal) {
      const ch = state.channels[idx];
      if (!ch) return;
      ch.fineTrimHz = parseInt(trimVal, 10) || 0;
      enforceCouplingRules(idx);
      syncChannelFrequencyUI(idx);
      if (ch.mode === 'quadrature' || ch.mode === 'differential') {
        syncChannelFrequencyUI(0);
        syncChannelFrequencyUI(1);
      }
      recalculateAll();
    }

    function onChannelPhaseDegSlider(idx, degVal) {
      const ch = state.channels[idx];
      if (!ch) return;
      ch.phaseDegTarget = Math.max(0, Math.min(360, parseInt(degVal, 10) || 0));
      recalculateAll();
    }

    function applySystemPreset(presetId) {
      if (presetId === 'vfo_bfo') {
        state.channels[0] = {
          ...state.channels[0],
          mode: 'fractional', baseHz: 14200000, fineTrimHz: 0, pll: 'A',
          drive: 3, rDivOverride: 0, invert: false, phaseDegTarget: 0
        };
        state.channels[1] = {
          ...state.channels[1],
          mode: 'fractional', baseHz: 10700000, fineTrimHz: 0, pll: 'B',
          drive: 2, rDivOverride: 0, invert: false, phaseDegTarget: 0
        };
        state.channels[2] = {
          ...state.channels[2],
          mode: 'off', baseHz: 8000, fineTrimHz: 0, pll: 'B',
          drive: 1, rDivOverride: 0, invert: false, phaseDegTarget: 0
        };
        showToast('Loaded HF VFO (14.2MHz) + BFO (10.7MHz)', 'info');
      } else if (presetId === 'iq_sdr') {
        state.channels[0] = {
          ...state.channels[0],
          mode: 'quadrature', baseHz: 7074000, fineTrimHz: 0, pll: 'A',
          drive: 3, rDivOverride: 0, invert: false, phaseDegTarget: 0
        };
        state.channels[1] = {
          ...state.channels[1],
          mode: 'quadrature', baseHz: 7074000, fineTrimHz: 0, pll: 'A',
          drive: 3, rDivOverride: 0, invert: false, phaseDegTarget: 90
        };
        state.channels[2] = {
          ...state.channels[2],
          mode: 'off', invert: false, phaseDegTarget: 0
        };
        showToast('Loaded Quadrature I/Q 90° SDR LO (7.074 MHz)', 'info');
      } else if (presetId === 'vhf_beacon') {
        state.channels[0] = {
          ...state.channels[0],
          mode: 'fractional', baseHz: 145000000, fineTrimHz: 0, pll: 'A',
          drive: 3, rDivOverride: 0, invert: false, phaseDegTarget: 0
        };
        state.channels[1] = {
          ...state.channels[1],
          mode: 'fractional', baseHz: 10700000, fineTrimHz: 0, pll: 'B',
          drive: 2, rDivOverride: 0, invert: false, phaseDegTarget: 0
        };
        state.channels[2] = {
          ...state.channels[2],
          mode: 'integer', baseHz: 25000000, fineTrimHz: 0, pll: 'B',
          drive: 2, rDivOverride: 0, invert: false, phaseDegTarget: 0
        };
        showToast('Loaded 2m VHF (145MHz) + 10.7MHz IF + 25MHz Ref', 'info');
      } else if (presetId === 'diff_clock') {
        state.channels[0] = {
          ...state.channels[0],
          mode: 'differential', baseHz: 27000000, fineTrimHz: 0, pll: 'A',
          drive: 3, rDivOverride: 0, invert: false, phaseDegTarget: 0
        };
        state.channels[1] = {
          ...state.channels[1],
          mode: 'differential', baseHz: 27000000, fineTrimHz: 0, pll: 'A',
          drive: 3, rDivOverride: 0, invert: true, phaseDegTarget: 0
        };
        state.channels[2] = {
          ...state.channels[2],
          mode: 'off', invert: false, phaseDegTarget: 0
        };
        showToast('Loaded Differential 180° Clock Pair (27 MHz)', 'info');
      } else if (presetId === 'spread_emi') {
        state.channels[0] = {
          ...state.channels[0],
          mode: 'spread', baseHz: 48000000, fineTrimHz: 0, pll: 'A',
          drive: 2, rDivOverride: 0, invert: false, phaseDegTarget: 0, ssPercent: 1.5, ssCenter: true
        };
        state.channels[1] = {
          ...state.channels[1],
          mode: 'off', invert: false, phaseDegTarget: 0
        };
        state.channels[2] = {
          ...state.channels[2],
          mode: 'off', invert: false, phaseDegTarget: 0
        };
        showToast('Loaded Spread Spectrum EMI Reduction (48 MHz ±1.5%)', 'info');
      }

      enforceCouplingRules(0);
      renderChannelCards();
      recalculateAll();
    }

    /***************************************************************************
     * Hardware-Accurate Si5351A Synthesizer & Register Calculator (AN619)
     ***************************************************************************/
    function gcd(a, b) {
      a = Math.abs(Math.round(a));
      b = Math.abs(Math.round(b));
      while (b !== 0) {
        const t = b;
        b = a % b;
        a = t;
      }
      return a || 1;
    }

    /**
     * Exact rational approximation using continued fractions for denominator <= maxDenom (1048575)
     */
    function rationalApprox(frac, maxDenom = 1048575) {
      if (frac <= 1e-12) return { b: 0, c: 1 };
      if (frac >= 1 - 1e-12) return { b: 1, c: 1 };

      let h0 = 0, h1 = 1;
      let k0 = 1, k1 = 0;
      let x = frac;

      for (let iter = 0; iter < 32; iter++) {
        const a = Math.floor(x);
        const h2 = a * h1 + h0;
        const k2 = a * k1 + k0;
        if (k2 > maxDenom) {
          const kMax = Math.floor((maxDenom - k0) / k1);
          const hAlt = kMax * h1 + h0;
          const kAlt = kMax * k1 + k0;
          const err1 = Math.abs(frac - h1 / k1);
          const errAlt = kAlt > 0 ? Math.abs(frac - hAlt / kAlt) : Infinity;
          if (errAlt < err1 && kAlt > 0) {
            const g = gcd(hAlt, kAlt);
            return { b: Math.round(hAlt / g), c: Math.round(kAlt / g) };
          }
          const g = gcd(h1, k1);
          return { b: Math.round(h1 / g), c: Math.round(k1 / g) };
        }
        h0 = h1; h1 = h2;
        k0 = k1; k1 = k2;
        const rem = x - a;
        if (rem < 1e-13) break;
        x = 1 / rem;
      }

      const g = gcd(h1, k1);
      return { b: Math.round(h1 / g), c: Math.round(k1 / g) };
    }

    /**
     * Pack Si5351A AN619 8-byte parameter block:
     * P1 = 128 * a + floor(128 * b / c) - 512
     * P2 = 128 * b - c * floor(128 * b / c)
     * P3 = c
     */
    function packSynthParams(a, b, c, rDivCode = 0, divBy4 = false) {
      const aBig = BigInt(Math.max(0, Math.round(a)));
      const bBig = BigInt(Math.max(0, Math.round(b)));
      const cBig = BigInt(Math.max(1, Math.min(1048575, Math.round(c))));

      const floorTerm = (128n * bBig) / cBig;
      let p1 = Number(128n * aBig + floorTerm - 512n);
      let p2 = Number(128n * bBig - cBig * floorTerm);
      const p3 = Number(cBig);

      if (divBy4) {
        p1 = 0;
        p2 = 0;
      }
      p1 = Math.max(0, Math.min(0x3FFFF, p1));
      p2 = Math.max(0, Math.min(0xFFFFF, p2));

      const div4Bits = divBy4 ? 0x0C : 0x00; // bits [3:2] = 11b
      const rBits = (rDivCode & 0x07) << 4;  // bits [6:4]

      return [
        (p3 >> 8) & 0xFF,                                   // Byte 0: MSx_P3[15:8]
        p3 & 0xFF,                                          // Byte 1: MSx_P3[7:0]
        rBits | div4Bits | ((p1 >> 16) & 0x03),             // Byte 2: R_DIV[6:4] | DIVBY4[3:2] | MSx_P1[17:16]
        (p1 >> 8) & 0xFF,                                   // Byte 3: MSx_P1[15:8]
        p1 & 0xFF,                                          // Byte 4: MSx_P1[7:0]
        (((p3 >> 16) & 0x0F) << 4) | ((p2 >> 16) & 0x0F),   // Byte 5: MSx_P3[19:16] | MSx_P2[19:16]
        (p2 >> 8) & 0xFF,                                   // Byte 6: MSx_P2[15:8]
        p2 & 0xFF                                           // Byte 7: MSx_P2[7:0]
      ];
    }

    function solveSynthDivider(vcoHz, targetMsInHz, forceInteger = false) {
      const rawRatio = vcoHz / Math.max(1, targetMsInHz);
      const maxDiv = forceInteger ? 2048 : 1800;
      let clamped = null;
      let ratio = rawRatio;

      if (ratio > maxDiv) {
        ratio = maxDiv;
        clamped = 'max';
      } else if (ratio < 6) {
        ratio = 6;
        clamped = 'min';
      }

      if (forceInteger) {
        let a = Math.max(6, Math.min(2048, Math.round(ratio)));
        if (a % 2 !== 0) a = Math.min(2048, a + 1);
        return { a, b: 0, c: 1, actualDiv: a, isInt: true, clamped };
      }

      // AN619 §4.1.1: Between 6 and 8 only integer 6 is valid; fractional starts at 8.0
      if (ratio < 8) {
        const useSix = Math.abs(ratio - 6) < Math.abs(ratio - 8);
        const a = useSix ? 6 : 8;
        return { a, b: 0, c: 1, actualDiv: a, isInt: true, clamped: clamped || 'gap6_8' };
      }

      const a = Math.floor(ratio);
      const frac = ratio - a;
      if (frac < 1e-11) {
        return { a, b: 0, c: 1, actualDiv: a, isInt: a % 2 === 0, clamped };
      }
      const { b, c } = rationalApprox(frac, 1048575);
      if (b === c) {
        return { a: a + 1, b: 0, c: 1, actualDiv: a + 1, isInt: (a + 1) % 2 === 0, clamped };
      }
      return { a, b, c, actualDiv: a + b / c, isInt: b === 0 && (a % 2 === 0), clamped };
    }

    function selectOptimalVco(xtalHz, channelsForPll) {
      if (channelsForPll.length === 0) {
        const mult = Math.max(15, Math.min(90, Math.round(800000000 / xtalHz)));
        return { active: false, vcoHz: xtalHz * mult, a: mult, b: 0, c: 1, isInt: true, inSpec: true };
      }

      // DIVBY4 channels (> 150 MHz) have a fixed MS=÷4, so the VCO MUST be chosen for them;
      // other channels on the same PLL can then adapt with a fractional MultiSynth.
      const primary = channelsForPll.find(c => c.msOutHz > 150000000) || channelsForPll[0];
      const fMs = primary.msOutHz;

      // High-speed > 150 MHz uses DIVBY4 (MS divider = 4) -> VCO = 4 * fMs (clamped to 900 MHz hardware VCO max)
      if (fMs > 150000000) {
        const maxVco = Math.min(900000000, xtalHz * 90);
        const minVco = Math.max(600000000, xtalHz * 15);
        const vcoTarget = Math.max(minVco, Math.min(maxVco, fMs * 4));
        const multRatio = Math.max(15, Math.min(90, vcoTarget / xtalHz));
        const a = Math.floor(multRatio);
        const { b, c } = rationalApprox(multRatio - a, 1048575);
        const vcoActual = xtalHz * (a + b / c);
        return {
          active: true,
          vcoHz: vcoActual,
          a, b, c,
          isInt: b === 0,
          inSpec: vcoActual >= 600000000 && vcoActual <= 900000000
        };
      }

      // Try finding an even integer MultiSynth divider k in [6..2048] that puts VCO in [600..900] MHz
      let bestCandidate = null;
      const kMin = Math.max(6, Math.ceil(600000000 / fMs));
      const kMax = Math.min(2048, Math.floor(900000000 / fMs));

      for (let k = kMin; k <= kMax; k++) {
        if (k % 2 !== 0 && primary.forceInt) continue;
        const vcoCandidate = fMs * k;
        const multRatio = vcoCandidate / xtalHz;
        const a = Math.floor(multRatio);
        const frac = multRatio - a;
        // Prefer integer PLL multiplier if exact, otherwise clean even MS divider around 750-800 MHz
        if (frac < 1e-10) {
          bestCandidate = {
            active: true,
            vcoHz: xtalHz * a,
            a, b: 0, c: 1,
            isInt: true,
            inSpec: true
          };
          break;
        }
        if (!bestCandidate && (k % 2 === 0)) {
          const { b, c } = rationalApprox(frac, 1048575);
          bestCandidate = {
            active: true,
            vcoHz: xtalHz * (a + b / c),
            a, b, c,
            isInt: b === 0,
            inSpec: true
          };
        }
      }

      if (bestCandidate) return bestCandidate;

      // Fallback fixed VCO (~800 MHz integer multiple of XTAL)
      const mult = Math.max(15, Math.min(90, Math.round(800000000 / xtalHz)));
      const vcoHz = xtalHz * mult;
      return {
        active: true,
        vcoHz,
        a: mult,
        b: 0,
        c: 1,
        isInt: true,
        inSpec: vcoHz >= 600000000 && vcoHz <= 900000000
      };
    }

    function recalculateAll() {
      const effectiveXtalHz = state.xtalBaseHz * (1 + state.xtalPpm / 1e6);
      state.computed.effectiveXtalHz = effectiveXtalHz;

      // Update Global XTAL & Calib Readouts
      const xtalReadoutEl = document.getElementById('effective-xtal-readout');
      const calibBadgeEl = document.getElementById('calib-hz-badge');
      if (xtalReadoutEl) {
        xtalReadoutEl.textContent = `${Math.round(effectiveXtalHz).toLocaleString()} Hz`;
      }
      if (calibBadgeEl) {
        const driftHz = effectiveXtalHz - state.xtalBaseHz;
        calibBadgeEl.textContent = `${driftHz >= 0 ? '+' : ''}${driftHz.toFixed(1)} Hz`;
      }

      // First pass: determine R-divider and MS output frequency for each active channel
      const preChannels = state.channels.map((ch) => {
        if (ch.mode === 'off') {
          return { active: false };
        }
        const targetHz = getChannelTotalHz(ch);
        if (ch.mode === 'bypass') {
          return { active: true, bypass: true, targetHz, rDivCode: 0, rDiv: 1, msOutHz: effectiveXtalHz };
        }

        let rDivCode = 0;
        if (ch.rDivOverride > 0) {
          rDivCode = ch.rDivOverride - 1;
        } else {
          // Lowest MS output reachable with R=/1:
          //  - Fractional: 900 MHz / 1800 = 500 kHz
          //  - Integer:    600 MHz / 2048 ≈ 293 kHz (even integer MS up to 2048)
          // Only scale down via R-divider when the target is below that floor.
          const msFloorHz = ch.mode === 'integer' ? Math.ceil(600000000 / 2048) : 500000;
          while ((targetHz * (1 << rDivCode)) < msFloorHz && rDivCode < 7) {
            rDivCode++;
          }
        }
        const rDiv = 1 << rDivCode;
        const msOutHz = targetHz * rDiv;
        return {
          active: true,
          bypass: false,
          targetHz,
          rDivCode,
          rDiv,
          msOutHz,
          forceInt: ch.mode === 'integer'
        };
      });

      // Group active non-bypass channels by PLL
      const pllAChannels = [];
      const pllBChannels = [];
      state.channels.forEach((ch, idx) => {
        const pre = preChannels[idx];
        if (!pre.active || pre.bypass) return;
        if (ch.pll === 'A') pllAChannels.push(pre);
        else pllBChannels.push(pre);
      });

      const pllA = selectOptimalVco(effectiveXtalHz, pllAChannels);
      const pllB = selectOptimalVco(effectiveXtalHz, pllBChannels);
      pllA.users = state.channels.filter((c, i) => preChannels[i].active && !preChannels[i].bypass && c.pll === 'A').map(c => c.name);
      pllB.users = state.channels.filter((c, i) => preChannels[i].active && !preChannels[i].bypass && c.pll === 'B').map(c => c.name);
      pllA.ssEnabled = state.channels.some((c, i) => preChannels[i].active && c.mode === 'spread');
      pllB.ssEnabled = false;

      state.computed.pllA = pllA;
      state.computed.pllB = pllB;

      // Update PLL Telemetry Cards
      updatePllTelemetryUI('plla', pllA);
      updatePllTelemetryUI('pllb', pllB);

      // Initialize default register array (AN619 reset defaults)
      const regs = new Uint8Array(256);
      regs[3] = 0xFF; // All outputs disabled by default
      for (let r = 16; r <= 23; r++) regs[r] = 0x80; // All CLKx powered down
      regs[183] = ((state.xtalCl & 0x03) << 6) | 0x12; // XTAL load capacitance + fixed reserved bits [4,1]
      regs[187] = (state.fanoutClkin ? 0x80 : 0x00) |
                  (state.fanoutXo ? 0x40 : 0x00) |
                  (state.fanoutMs ? 0x10 : 0x00);

      // Pack MSNA (Regs 26..33) & MSNB (Regs 34..41)
      const msnaBytes = packSynthParams(pllA.a, pllA.b, pllA.c, 0, false);
      for (let i = 0; i < 8; i++) regs[26 + i] = msnaBytes[i];
      const msnbBytes = packSynthParams(pllB.a, pllB.b, pllB.c, 0, false);
      for (let i = 0; i < 8; i++) regs[34 + i] = msnbBytes[i];

      // Spread Spectrum Registers (Regs 149..161 on PLLA)
      if (pllA.ssEnabled) {
        const ssCh = state.channels.find(c => c.mode === 'spread') || state.channels[0];
        const depth = Math.max(0.001, Math.min(0.025, ssCh.ssPercent / 100));
        const ssudp = Math.max(1, Math.min(4095, Math.round(effectiveXtalHz / (4 * 31500))));
        const ssdnVal = Math.max(1, Math.min(32767, Math.round((pllA.a * depth * 128) / ssudp)));
        const ssupVal = ssCh.ssCenter ? ssdnVal : 0;

        regs[149] = 0x80 | ((ssdnVal >> 8) & 0x7F); // SSC_EN=1 | SSDN_P2[14:8]
        regs[150] = ssdnVal & 0xFF;               // SSDN_P2[7:0]
        regs[151] = (ssCh.ssCenter ? 0x80 : 0x00) | ((ssupVal >> 8) & 0x7F); // SSC_MODE | SSUP_P2[14:8]
        regs[152] = ssupVal & 0xFF;               // SSUP_P2[7:0]
        regs[153] = 0x01;                         // SSDN_P3[7:0]
        regs[154] = ((ssudp >> 8) & 0x0F) << 4;   // SSUDP[11:8]
        regs[155] = ssudp & 0xFF;                 // SSUDP[7:0]
      }

      // Reg 24: CLK3_0 Disable States
      let reg24 = 0;
      state.channels.forEach((ch, idx) => {
        reg24 |= ((ch.disableState & 0x03) << (idx * 2));
      });
      regs[24] = reg24;

      // Reg 177: Soft Reset PLLA & PLLB
      regs[177] = (pllA.active ? 0x20 : 0x00) | (pllB.active ? 0x80 : 0x00);

      // Compute each channel's MultiSynth, Phase Offset, and Control Register
      let reg3EnableMask = 0xFF; // 0 = enabled, 1 = disabled

      state.channels.forEach((ch, idx) => {
        const pre = preChannels[idx];
        const warnings = [];

        if (!pre.active) {
          regs[16 + idx] = 0x80; // CLKx_PDN = 1
          ch._effectiveInvert = Boolean(ch.invert);
          state.computed.ch[idx] = {
            active: false,
            actualHz: 0,
            errorHz: 0,
            errorPpm: 0,
            phaseDeg: 0,
            invert: false,
            warnings: []
          };
          return;
        }

        reg3EnableMask &= ~(1 << idx); // Clear disable bit to enable output

        const effInvert = (ch.mode === 'differential' && idx === 1) ? true : Boolean(ch.invert);
        ch._effectiveInvert = effInvert;

        if (pre.bypass) {
          // Direct XTAL bypass: CLKx_SRC = 00 (XTAL)
          regs[16 + idx] = (effInvert ? 0x10 : 0x00) | (0x00 << 2) | (ch.drive & 0x03);
          regs[165 + idx] = 0;
          ch.phaseReg = 0;
          const actualHz = effectiveXtalHz;
          const errorHz = actualHz - pre.targetHz;
          state.computed.ch[idx] = {
            active: true,
            bypass: true,
            divBy4: false,
            actualHz,
            errorHz,
            errorPpm: (errorHz / pre.targetHz) * 1e6,
            msA: 1, msB: 0, msC: 1,
            rDiv: 1,
            phaseDeg: 0,
            invert: effInvert,
            warnings: []
          };
          return;
        }

        const pllObj = ch.pll === 'A' ? pllA : pllB;
        const divBy4 = pre.msOutHz > 150000000;
        let msParams;

        if (divBy4) {
          msParams = { a: 4, b: 0, c: 1, actualDiv: 4, isInt: true };
        } else {
          msParams = solveSynthDivider(pllObj.vcoHz, pre.msOutHz, ch.mode === 'integer');
        }

        const actualHz = pllObj.vcoHz / (msParams.actualDiv * pre.rDiv);
        const errorHz = actualHz - pre.targetHz;
        const errorPpm = pre.targetHz > 0 ? (errorHz / pre.targetHz) * 1e6 : 0;

        // Calculate 7-bit CLKx_PHOFF (Regs 165..167):
        // Step resolution = T_VCO / 4 = 1 / (4 * f_VCO)
        // PHOFF = round((phaseDeg / 360) * 4 * (f_VCO / f_out))
        let targetDeg = ch.phaseDegTarget;
        if (ch.mode === 'quadrature') {
          targetDeg = idx === 1 ? 90 : 0;
        }
        const maxStepsPerCycle = 4 * (pllObj.vcoHz / actualHz);
        let phoff = Math.round((targetDeg / 360) * maxStepsPerCycle);
        if (phoff > 127) {
          warnings.push(`Phase ${targetDeg}° exceeds 7-bit PHOFF max (127); clamped`);
          phoff = 127;
        }
        phoff = Math.max(0, phoff);
        ch.phaseReg = phoff;
        regs[165 + idx] = phoff & 0x7F;

        const achievedPhaseDeg = maxStepsPerCycle > 0 ? (phoff / maxStepsPerCycle) * 360 : 0;

        // Pack MSx parameters into Regs 42..49 (MS0), 50..57 (MS1), 58..65 (MS2)
        const msBytes = packSynthParams(msParams.a, msParams.b, msParams.c, pre.rDivCode, divBy4);
        const baseReg = 42 + idx * 8;
        for (let i = 0; i < 8; i++) {
          regs[baseReg + i] = msBytes[i];
        }

        // Reg 16/17/18: CLKx Control
        // [7]=0 (Power Up), [6]=MSx_INT, [5]=MSx_SRC (0=PLLA, 1=PLLB), [4]=CLKx_INV, [3:2]=11 (MultiSynth), [1:0]=CLKx_IDRV
        const msIntBit = msParams.isInt ? 0x40 : 0x00;
        const msSrcBit = ch.pll === 'B' ? 0x20 : 0x00;
        const invBit = effInvert ? 0x10 : 0x00;
        regs[16 + idx] = msIntBit | msSrcBit | invBit | 0x0C | (ch.drive & 0x03);

        if (pre.msOutHz > 225000000) {
          warnings.push(`R-Div /${pre.rDiv} caps output at ${formatShortFreq(actualHz)} (MS max 225 MHz) — lower R-Div`);
        }
        if (msParams.clamped === 'max') {
          warnings.push(`MS${idx} hit max ÷${msParams.a} — increase R-Div to reach ${formatShortFreq(pre.targetHz)}`);
        } else if (msParams.clamped === 'gap6_8') {
          warnings.push(`AN619: MS${idx} fractional 6..8 invalid — snapped to ÷${msParams.a}`);
        }
        if (actualHz > 160000000 && actualHz <= 225000000) {
          warnings.push('Overclocked >160 MHz (valid on most Si5351A silicon up to 225 MHz)');
        }
        if (!pllObj.inSpec) {
          warnings.push(`PLL${ch.pll} VCO ${(pllObj.vcoHz / 1e6).toFixed(1)} MHz outside 600–900 MHz spec`);
        }
        if (divBy4) {
          // DIVBY4 hard-locks MS=÷4 → f_out = VCO / 4. Another channel on the same PLL with a
          // different MS frequency can't share that VCO unless it can adapt (≤150 MHz, fractional).
          const conflict = state.channels.some((other, j) => {
            if (j === idx || other.pll !== ch.pll) return false;
            const op = preChannels[j];
            return op && op.active && !op.bypass && op.msOutHz > 150000000 && Math.abs(op.msOutHz - pre.msOutHz) > 1;
          });
          if (conflict) {
            warnings.push(`DIVBY4 conflict: two different >150 MHz outputs on PLL${ch.pll} — move one to PLL${ch.pll === 'A' ? 'B' : 'A'}`);
          } else if (Math.abs(actualHz - pre.targetHz) > 1 && (ch.pll === 'A' ? pllAChannels : pllBChannels).length > 1) {
            warnings.push(`DIVBY4 (÷4) locked to shared PLL${ch.pll} VCO — use a dedicated PLL for exact ${formatShortFreq(pre.targetHz)}`);
          }
        }

        state.computed.ch[idx] = {
          active: true,
          bypass: false,
          divBy4,
          actualHz,
          errorHz,
          errorPpm,
          msA: msParams.a,
          msB: msParams.b,
          msC: msParams.c,
          rDiv: pre.rDiv,
          phaseDeg: achievedPhaseDeg,
          invert: effInvert,
          warnings
        };
      });

      regs[3] = reg3EnableMask;

      // Track modified registers compared to datasheet reset defaults
      const modified = new Set();
      for (let addr = 0; addr <= 187; addr++) {
        const defVal = getRegDefaultValue(addr);
        if (regs[addr] !== defVal) modified.add(addr);
      }

      state.computed.registers = regs;
      state.computed.modifiedRegs = modified;

      const fanoutHexEl = document.getElementById('fanout-reg-hex');
      if (fanoutHexEl) fanoutHexEl.textContent = '0x' + regs[187].toString(16).toUpperCase().padStart(2, '0');

      updateChannelReadoutsUI();
      renderBlockDiagram();
      renderRegisterTable();
      generateCCode();
      renderDatasheetDocs();
      renderHelpRegisterMap();
    }

    function updatePllTelemetryUI(prefix, pll) {
      const vcoEl = document.getElementById(`${prefix}-vco-freq`);
      const multEl = document.getElementById(`${prefix}-mult-str`);
      const usersEl = document.getElementById(`${prefix}-users-str`);
      const badgeEl = document.getElementById(`${prefix}-status-badge`);
      const ssBadgeEl = document.getElementById('plla-ss-badge');

      if (vcoEl) vcoEl.textContent = pll.active ? `${(pll.vcoHz / 1e6).toFixed(6)} MHz` : 'STANDBY';
      if (multEl) multEl.textContent = pll.isInt ? `${pll.a} (Int)` : `${pll.a} + ${pll.b}/${pll.c}`;
      if (usersEl) usersEl.textContent = pll.users.length ? pll.users.join(', ') : 'None';
      if (badgeEl) {
        if (!pll.active) {
          badgeEl.textContent = 'IDLE';
          badgeEl.className = 'px-1.5 py-0.2 text-[9px] font-mono rounded bg-slate-700/40 text-slate-400 border border-slate-600/40';
        } else if (pll.inSpec) {
          badgeEl.textContent = 'IN SPEC';
          badgeEl.className = 'px-1.5 py-0.2 text-[9px] font-mono rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        } else {
          badgeEl.textContent = 'OUT OF SPEC';
          badgeEl.className = 'px-1.5 py-0.2 text-[9px] font-mono rounded bg-rose-500/20 text-rose-300 border border-rose-500/30';
        }
      }
      if (prefix === 'plla' && ssBadgeEl) {
        ssBadgeEl.classList.toggle('hidden', !pll.ssEnabled);
      }
    }

    function getRegDefaultValue(addr) {
      if (addr === 3) return 0xFF;
      if (addr >= 16 && addr <= 23) return 0x80;
      if (addr === 183) return 0xD2;
      if (addr === 187) return 0x00;
      return 0x00;
    }

    function getRegDescription(addr) {
      if (addr === 3) return 'Output Enable Control (0=Enabled, 1=Disabled)';
      if (addr === 15) return 'PLL Input Source (0=XTAL)';
      if (addr >= 16 && addr <= 23) return `CLK${addr - 16} Control (PDN, MS_INT, SRC, INV, IDRV)`;
      if (addr === 24) return 'CLK3–CLK0 Disable State';
      if (addr >= 26 && addr <= 33) return `MSNA (PLLA) Feedback Divider Byte ${addr - 26}`;
      if (addr >= 34 && addr <= 41) return `MSNB (PLLB) Feedback Divider Byte ${addr - 34}`;
      if (addr >= 42 && addr <= 49) return `MultiSynth0 (CLK0) Divider / R-Div Byte ${addr - 42}`;
      if (addr >= 50 && addr <= 57) return `MultiSynth1 (CLK1) Divider / R-Div Byte ${addr - 50}`;
      if (addr >= 58 && addr <= 65) return `MultiSynth2 (CLK2) Divider / R-Div Byte ${addr - 58}`;
      if (addr >= 149 && addr <= 161) return `Spread Spectrum Parameter (Reg ${addr})`;
      if (addr >= 165 && addr <= 167) return `CLK${addr - 165} Initial Phase Offset (7-bit PHOFF)`;
      if (addr === 177) return 'PLL Soft Reset (PLLB_RST[7], PLLA_RST[5])';
      if (addr === 183) return 'Crystal Internal Load Capacitance (XTAL_CL[7:6])';
      if (addr === 187) return 'Fanout Enable (CLKIN, XO, MS0/MS4)';
      return `Reserved / General Register ${addr}`;
    }

    /***************************************************************************
     * Dynamic Channel Cards Rendering
     ***************************************************************************/
    function renderChannelCards() {
      const grid = document.getElementById('channels-grid');
      if (!grid) return;
      grid.innerHTML = '';

      const driveLabels = ['2mA', '4mA', '6mA', '8mA'];
      const modeHints = {
        off: 'Reg 3[b_i]=1, Reg 16+i[7]=1 (PDN): Output disabled & powered down.',
        fractional: 'MSi_INT=0 (Reg 16+i[6]): Fractional a+b/c divider (4..1800) for any Hz.',
        integer: 'MSi_INT=1 (Reg 16+i[6]): Even integer MultiSynth + int PLL for lowest jitter.',
        quadrature: 'Couples CLK0+1 on PLLA; writes Reg 166 PHOFF = round(f_VCO / 4f) + Reg 177 RST.',
        phase: 'Writes Reg 165+i CLKi_PHOFF[6:0] in T_VCO/4 steps + Reg 177 PLL reset.',
        differential: 'Couples CLK0+1 at equal freq; sets Reg 17[4] CLK1_INV=1 for 180° complement.',
        spread: 'PLLA SSC_EN=1 (Reg 149–161): Dithers VCO to reduce peak EMI (PLLA only).',
        bypass: 'CLKi_SRC=00 (Reg 16+i[3:2]): Routes XTAL directly to output; needs Reg 187[6].'
      };

      state.channels.forEach((ch, idx) => {
        const st = ACCENT_STYLES[ch.accent];
        const isOff = ch.mode === 'off';
        const isBypass = ch.mode === 'bypass';
        const freqLocked = isOff || isBypass || (idx === 1 && (ch.mode === 'quadrature' || ch.mode === 'differential'));
        const phaseEnabled = !isOff && !isBypass && ch.mode !== 'quadrature' && ch.mode !== 'differential';
        const totalHz = getChannelTotalHz(ch);
        const logPos = hzToLogSlider(ch.baseHz);
        const ctrlReg = 16 + idx;
        const msBaseReg = 42 + idx * 8;
        const rdivReg = 44 + idx * 8;
        const phoffReg = 165 + idx;
        const disBits = `${idx * 2 + 1}:${idx * 2}`;

        const modeOptionsHtml = OPERATING_MODES.map(m =>
          `<option value="${m.id}" ${ch.mode === m.id ? 'selected' : ''}>${m.label}</option>`
        ).join('');

        const presetBtnsHtml = FREQ_PRESETS.map(p =>
          `<button onclick="applyChannelPreset(${idx}, ${p.hz})" ${freqLocked ? 'disabled' : ''} title="Quick Frequency Preset: Jump CH${idx} directly to ${p.hz.toLocaleString()} Hz and reset Fine Trim to 0." class="px-1.5 py-0.2 text-[9px] font-mono rounded bg-lab-bg hover:bg-slate-800 border border-lab-border text-slate-300 disabled:opacity-40 transition">${p.label}</button>`
        ).join('');

        const stepBtnsHtml = STEP_SIZES.map(s => {
          const active = ch.stepHz === s.hz;
          return `<button onclick="setChannelStep(${idx}, ${s.hz})" title="Nudge Step Size (${s.hz.toLocaleString()} Hz): Sets the frequency increment for the - / + buttons and keyboard arrow keys in the Hz input." class="px-1 py-0 text-[9px] font-mono rounded border ${active ? st.btnActive : 'bg-lab-bg border-lab-border text-slate-400 hover:text-slate-200'}">${s.label}</button>`;
        }).join('');

        const card = document.createElement('div');
        card.className = `bg-lab-panel border ${isOff ? 'border-lab-border/70' : st.border} rounded-lg p-2.5 flex flex-col justify-between transition`;
        card.style.setProperty('--slider-accent', st.sliderAccent);
        card.style.setProperty('--slider-glow', st.sliderGlow);

        card.innerHTML = `
          <div class="space-y-2">
            <!-- Header Row: CLK Name + Mode Select + PLL Select -->
            <div class="flex items-center gap-1.5 pb-1.5 border-b border-lab-border/70">
              <span class="w-2 h-2 rounded-full ${isOff ? 'bg-slate-600' : st.dot} shrink-0"></span>
              <span class="text-xs font-bold font-mono text-white shrink-0">CH${idx} <span class="text-[10px] font-normal ${st.text}">(${ch.name})</span></span>
              <select id="ch-${idx}-mode" onchange="updateChannelField(${idx}, 'mode', this.value)" title="Selects synthesis mode: sets CLKx_PDN (Reg ${ctrlReg}[7]), MSx_INT (Reg ${ctrlReg}[6]), CLKx_SRC (Reg ${ctrlReg}[3:2]), PHOFF (Reg ${phoffReg}), or SSC (Reg 149–161)." class="flex-1 min-w-0 bg-lab-card border border-lab-border rounded px-1.5 py-0.5 text-[11px] font-medium text-white focus:outline-none focus:border-cyan-500">
                ${modeOptionsHtml}
              </select>
              <select id="ch-${idx}-pll" onchange="updateChannelField(${idx}, 'pll', this.value)" ${isOff || isBypass || ch.mode === 'spread' || ch.mode === 'quadrature' || ch.mode === 'differential' ? 'disabled' : ''} title="Reg ${ctrlReg} [bit 5] MS${idx}_SRC: 0 = PLLA (MSNA), 1 = PLLB (MSNB). Selects which VCO feeds MultiSynth ${idx}." class="w-16 bg-lab-bg border border-lab-border rounded px-1 py-0.5 text-[11px] font-mono text-white disabled:opacity-40">
                <option value="A" ${ch.pll === 'A' ? 'selected' : ''}>PLLA</option>
                <option value="B" ${ch.pll === 'B' ? 'selected' : ''}>PLLB</option>
              </select>
            </div>
            <div id="ch-${idx}-mode-desc" class="text-[9.5px] font-mono text-slate-400 bg-lab-bg/60 border border-lab-border/50 rounded px-1.5 py-0.5 truncate" title="${modeHints[ch.mode] || ''}">
              ${modeHints[ch.mode] || ''}
            </div>

            <!-- Frequency Tuning Strip -->
            <div class="bg-lab-card/80 border border-lab-border rounded p-2 ${isOff ? 'opacity-40 pointer-events-none' : ''}" title="Target output frequency f_out = f_VCO / ((a + b/c) * R). Writes MS${idx}_P1/P2/P3 into Reg ${msBaseReg}–${msBaseReg + 7} (AN619 §4.1).">
              <div class="flex items-center justify-between gap-1 mb-1">
                <div class="flex flex-wrap gap-0.5">${presetBtnsHtml}</div>
                <div class="flex items-center gap-0.5 shrink-0">
                  <button onclick="nudgeChannelFreq(${idx}, -1)" ${freqLocked ? 'disabled' : ''} title="Step Down: Decrease CH${idx} frequency by ${ch.stepHz.toLocaleString()} Hz." class="px-1.5 py-0.2 text-[11px] font-mono font-bold bg-lab-bg hover:bg-slate-800 border border-lab-border rounded ${st.text} disabled:opacity-40">-</button>
                  <input type="number" id="ch-${idx}-direct-hz" value="${totalHz}" step="${ch.stepHz}" min="1000" max="225000000" ${freqLocked ? 'disabled' : ''} oninput="onChannelDirectHzInput(${idx}, this.value)" title="Direct Frequency Input (Hz): Type any frequency from 1,000 Hz to 225,000,000 Hz. Automatically computes MS${idx} (Reg ${msBaseReg}–${msBaseReg + 7}) and R-Div." class="w-24 bg-lab-bg border border-lab-border rounded px-1.5 py-0.2 text-[11px] font-mono font-semibold text-right text-white focus:outline-none focus:border-cyan-500 disabled:opacity-60">
                  <button onclick="nudgeChannelFreq(${idx}, 1)" ${freqLocked ? 'disabled' : ''} title="Step Up: Increase CH${idx} frequency by ${ch.stepHz.toLocaleString()} Hz." class="px-1.5 py-0.2 text-[11px] font-mono font-bold bg-lab-bg hover:bg-slate-800 border border-lab-border rounded ${st.text} disabled:opacity-40">+</button>
                </div>
              </div>

              <!-- Coarse Log Slider -->
              <div class="mt-1.5" title="Logarithmic Band Sweep (8 kHz – 160 MHz): Smoothly sweeps across the entire Si5351A datasheet frequency range on a logarithmic scale.">
                <div class="flex justify-between text-[9px] font-mono text-slate-400">
                  <span>Band Sweep (8k–160M)</span>
                  <span class="flex items-center gap-0.5">Step: ${stepBtnsHtml}</span>
                </div>
                <input type="range" id="ch-${idx}-log-slider" min="0" max="1000" step="1" value="${logPos}" ${freqLocked ? 'disabled' : ''} oninput="onChannelLogSlider(${idx}, this.value)" class="w-full rf-slider mt-1">
              </div>

              <!-- Fine Trim Slider -->
              <div class="mt-1.5" title="Fine Frequency Trim (±50 kHz in 10 Hz steps): Adds a fine offset to the base frequency for VFO clarifier / RIT tuning and live divider updates in Reg ${msBaseReg}–${msBaseReg + 7}.">
                <div class="flex justify-between text-[9px] font-mono">
                  <span class="text-slate-400">Fine Trim (&plusmn;50 kHz)</span>
                  <span id="ch-${idx}-trim-val" class="${st.text}">${ch.fineTrimHz >= 0 ? '+' : ''}${ch.fineTrimHz.toLocaleString()} Hz</span>
                </div>
                <input type="range" id="ch-${idx}-trim-slider" min="-50000" max="50000" step="10" value="${ch.fineTrimHz}" ${freqLocked ? 'disabled' : ''} oninput="onChannelFineTrimSlider(${idx}, this.value)" class="w-full rf-slider mt-0.5">
              </div>
            </div>

            <!-- Conditional Spread Spectrum Mini-Bar -->
            <div id="ch-${idx}-ss-panel" class="${ch.mode === 'spread' ? '' : 'hidden'} bg-rose-950/25 border border-rose-500/30 rounded px-2 py-1.5" title="Spread Spectrum (Reg 149–161): Sets SSC_EN=1 (Reg 149[7]) on PLLA to dither the VCO by 0.1%–2.5% and spread EMI energy. Check Center to set SSC_MODE=1 (Reg 151[7]).">
              <div class="flex items-center justify-between gap-2 text-[10px]">
                <span class="font-semibold text-rose-300 shrink-0">SS Depth <span class="font-mono text-[9px] text-rose-400/80">(R149–161)</span>: <span id="ch-${idx}-ss-val" class="font-mono text-rose-200">${ch.ssPercent.toFixed(1)}%</span></span>
                <input type="range" min="0.1" max="2.5" step="0.1" value="${ch.ssPercent}" oninput="updateChannelField(${idx}, 'ssPercent', parseFloat(this.value))" class="flex-1 rf-slider" style="--slider-accent: #f43f5e; --slider-glow: rgba(244,63,94,0.5);">
                <label class="flex items-center gap-1 text-slate-300 cursor-pointer shrink-0" title="SSC_MODE (Reg 151[7]): Unchecked = Down-spread only (-depth%). Checked = Center-spread (±depth% around center frequency).">
                  <input type="checkbox" ${ch.ssCenter ? 'checked' : ''} onchange="updateChannelField(${idx}, 'ssCenter', this.checked)" class="w-3 h-3 rounded"> Center
                </label>
              </div>
            </div>

            <!-- Compact 3-Column Slider Matrix: Phase | Drive | R-Div -->
            <div class="grid grid-cols-3 gap-1.5">
              <div class="bg-lab-card border border-lab-border rounded p-1.5 ${phaseEnabled ? '' : 'opacity-45'}" title="Reg ${phoffReg} (0x${phoffReg.toString(16).toUpperCase()}) CLK${idx}_PHOFF[6:0]: Initial phase offset in T_VCO/4 steps (0..127). Requires PLL soft reset (Reg 177) to apply.">
                <div class="flex justify-between text-[9px] font-mono mb-0.5">
                  <span class="text-slate-400">Phase <span class="text-slate-500">R${phoffReg}</span></span>
                  <span id="ch-${idx}-phase-readout" class="${st.text}">${ch.phaseDegTarget}°</span>
                </div>
                <input type="range" id="ch-${idx}-phase-slider" min="0" max="360" step="1" value="${ch.phaseDegTarget}" ${phaseEnabled ? '' : 'disabled'} oninput="onChannelPhaseDegSlider(${idx}, this.value)" class="w-full rf-slider">
              </div>

              <div class="bg-lab-card border border-lab-border rounded p-1.5" title="Reg ${ctrlReg} [1:0] CLK${idx}_IDRV: Output buffer drive strength (00=2mA, 01=4mA, 10=6mA, 11=8mA into 50Ω/CMOS load).">
                <div class="flex justify-between text-[9px] font-mono mb-0.5">
                  <span class="text-slate-400">Drive <span class="text-slate-500">R${ctrlReg}[1:0]</span></span>
                  <span id="ch-${idx}-drive-val" class="${st.text}">${driveLabels[ch.drive]}</span>
                </div>
                <input type="range" min="0" max="3" step="1" value="${ch.drive}" oninput="updateChannelField(${idx}, 'drive', parseInt(this.value, 10))" class="w-full rf-slider">
              </div>

              <div class="bg-lab-card border border-lab-border rounded p-1.5" title="Reg ${rdivReg} [6:4] R${idx}_DIV[2:0]: Post-MultiSynth power-of-2 divider (/1 to /128). Required for f_out &lt; 500 kHz down to 8 kHz.">
                <div class="flex justify-between text-[9px] font-mono mb-0.5">
                  <span class="text-slate-400">R-Div <span class="text-slate-500">R${rdivReg}[6:4]</span></span>
                  <span id="ch-${idx}-rdiv-val" class="${st.text}">${R_DIV_OPTIONS[ch.rDivOverride]}</span>
                </div>
                <input type="range" min="0" max="8" step="1" value="${ch.rDivOverride}" ${isOff || isBypass ? 'disabled' : ''} oninput="updateChannelField(${idx}, 'rDivOverride', parseInt(this.value, 10))" class="w-full rf-slider">
              </div>
            </div>

            <!-- Compact Footer Controls: Disable State + Polarity Invert -->
            <div class="flex items-center justify-between gap-2 bg-lab-card/60 border border-lab-border rounded px-2 py-1 text-[10px]">
              <div class="flex items-center gap-1" title="Reg 24 [${disBits}] CLK${idx}_DIS_STATE: Pin state when disabled via Reg 3 (OEB): 00=Low, 01=High, 10=High-Z, 11=Never.">
                <span class="text-slate-400">Dis <span class="font-mono text-[9px] text-slate-500">R24[${disBits}]</span>:</span>
                <select onchange="updateChannelField(${idx}, 'disableState', parseInt(this.value, 10))" class="bg-lab-bg border border-lab-border rounded px-1 py-0.2 font-mono text-slate-200">
                  <option value="0" ${ch.disableState === 0 ? 'selected' : ''}>Low (0V)</option>
                  <option value="1" ${ch.disableState === 1 ? 'selected' : ''}>High (3.3V)</option>
                  <option value="2" ${ch.disableState === 2 ? 'selected' : ''}>High-Z</option>
                  <option value="3" ${ch.disableState === 3 ? 'selected' : ''}>Never</option>
                </select>
              </div>
              <label class="flex items-center gap-1.5 ${isOff || ch.mode === 'differential' ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer'}" title="Reg ${ctrlReg} [bit 4] CLK${idx}_INV: Hardware 180° waveform inversion at the output buffer.">
                <span id="ch-${idx}-inv-lbl" class="font-mono text-slate-300">${ch.invert ? 'INV 180°' : 'Normal 0°'}</span>
                <span class="font-mono text-[9px] text-slate-500">R${ctrlReg}[4]</span>
                <input type="checkbox" id="ch-${idx}-inv-chk" ${ch.invert ? 'checked' : ''} ${isOff || ch.mode === 'differential' ? 'disabled' : ''} onchange="updateChannelField(${idx}, 'invert', this.checked)" class="w-3 h-3 rounded border-slate-600 bg-lab-bg text-cyan-500 focus:ring-0">
              </label>
            </div>
          </div>

          <!-- Compact Real-time Output Readout Bar -->
          <div class="mt-2 bg-lab-bg border border-lab-border rounded px-2 py-1.5 font-mono" title="Live Hardware Readout: Shows actual synthesized output frequency, quantization error in Hz/ppb, active MultiSynth divider (MS${idx}) + R-Div, and live I2C register values (Reg 3, Reg ${ctrlReg}, Reg ${msBaseReg}–${msBaseReg + 7}, Reg ${phoffReg}).">
            <div class="flex items-baseline justify-between gap-1">
              <span id="ch-${idx}-actual-freq" class="text-sm font-bold ${isOff ? 'text-slate-500' : st.text}">14.200000 MHz</span>
              <span id="ch-${idx}-error-readout" class="text-[10px] text-emerald-400">Exact</span>
            </div>
            <div id="ch-${idx}-ms-params" class="text-[10px] text-slate-400 truncate">MS0: 56 (Int) | R=/1</div>
            <div id="ch-${idx}-reg-summary" class="text-[9px] text-cyan-400/80 truncate mt-0.5">R3[b0]=0 | R16=0x4F | R42..49 | R165=0x00</div>
            <div id="ch-${idx}-warnings" class="mt-0.5 space-y-0.5"></div>
          </div>
        `;

        grid.appendChild(card);
      });
    }

    function updateChannelReadoutsUI() {
      const driveLabels = ['2mA', '4mA', '6mA', '8mA'];
      state.channels.forEach((ch, idx) => {
        const comp = state.computed.ch[idx];
        if (!comp) return;

        const actualEl = document.getElementById(`ch-${idx}-actual-freq`);
        const errorEl = document.getElementById(`ch-${idx}-error-readout`);
        const msEl = document.getElementById(`ch-${idx}-ms-params`);
        const rdivValEl = document.getElementById(`ch-${idx}-rdiv-val`);
        const driveValEl = document.getElementById(`ch-${idx}-drive-val`);
        const phaseReadoutEl = document.getElementById(`ch-${idx}-phase-readout`);
        const phaseSliderEl = document.getElementById(`ch-${idx}-phase-slider`);
        const invLblEl = document.getElementById(`ch-${idx}-inv-lbl`);
        const warnEl = document.getElementById(`ch-${idx}-warnings`);
        const ssValEl = document.getElementById(`ch-${idx}-ss-val`);
        const regSummaryEl = document.getElementById(`ch-${idx}-reg-summary`);
        const regs = state.computed.registers;
        const ctrlReg = 16 + idx;
        const phoffReg = 165 + idx;
        const msBase = 42 + idx * 8;
        const hex = (v) => '0x' + (v || 0).toString(16).toUpperCase().padStart(2, '0');
        const oebBit = (regs[3] >> idx) & 1;

        if (ssValEl) ssValEl.textContent = `${ch.ssPercent.toFixed(1)}%`;
        if (driveValEl) driveValEl.textContent = driveLabels[ch.drive];
        if (rdivValEl) {
          rdivValEl.textContent = ch.rDivOverride === 0 ? `Auto(/${comp.rDiv || 1})` : R_DIV_OPTIONS[ch.rDivOverride];
        }
        if (invLblEl) {
          const effInv = ch._effectiveInvert !== undefined ? ch._effectiveInvert : ch.invert;
          invLblEl.textContent = effInv ? 'INV 180°' : 'Normal 0°';
        }
        if (phaseSliderEl) phaseSliderEl.value = ch.phaseDegTarget;
        if (phaseReadoutEl) {
          phaseReadoutEl.textContent = `${comp.phaseDeg.toFixed(0)}° (P${ch.phaseReg})`;
        }

        if (!comp.active) {
          const disNames = ['Low (0V)', 'High (3.3V)', 'High-Z', 'Never (PDN=1)'];
          actualEl.textContent = 'DISABLED';
          errorEl.textContent = disNames[ch.disableState] || 'Low (0V)';
          errorEl.className = 'text-[10px] text-slate-500';
          msEl.textContent = 'Powered Down (PDN=1)';
          if (regSummaryEl) {
            regSummaryEl.textContent = `R3[b${idx}]=${oebBit} (OEB) | R${ctrlReg}=${hex(regs[ctrlReg])} (PDN=1) | R24=${hex(regs[24])}`;
          }
          warnEl.innerHTML = '';
          return;
        }

        if (regSummaryEl) {
          const srcLabel = comp.bypass ? 'SRC=XTAL' : `PLL${ch.pll}`;
          const msRange = comp.bypass ? 'MS bypassed' : `R${msBase}..${msBase + 7}`;
          regSummaryEl.textContent = `R3[b${idx}]=${oebBit} | R${ctrlReg}=${hex(regs[ctrlReg])} (${srcLabel}) | ${msRange} | R${phoffReg}=${hex(regs[phoffReg])}`;
        }

        actualEl.textContent = formatFreqHz(comp.actualHz);
        const ppb = Math.round(comp.errorPpm * 1000);
        const absErr = Math.abs(comp.errorHz);
        errorEl.textContent = absErr < 0.001 ? 'Exact (0 Hz)' : `${comp.errorHz >= 0 ? '+' : ''}${comp.errorHz.toFixed(2)}Hz (${ppb}ppb)`;
        errorEl.className = absErr < 1.0 ? 'text-[10px] text-emerald-400' : 'text-[10px] text-amber-400';

        if (comp.bypass) {
          msEl.textContent = 'Direct XTAL Bypass (CLKx_SRC=00)';
        } else if (comp.divBy4) {
          msEl.textContent = `MS${idx}: ÷4 High-Speed (>150 MHz)`;
        } else {
          const fracStr = comp.msB === 0 ? `${comp.msA} (Int)` : `${comp.msA}+${comp.msB}/${comp.msC}`;
          msEl.textContent = `MS${idx}: ${fracStr} | R=/${comp.rDiv}`;
        }

        warnEl.innerHTML = comp.warnings.map(w =>
          `<div class="text-[9px] text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded px-1 py-0.2">&#9888; ${w}</div>`
        ).join('');
      });

      for (let i = 0; i < 3; i++) {
        const lbl = document.getElementById(`scope-lbl-${i}`);
        const comp = state.computed.ch[i];
        if (lbl) lbl.textContent = comp && comp.active ? `${formatShortFreq(comp.actualHz)}@${comp.phaseDeg.toFixed(0)}°${comp.invert ? ' INV' : ''}` : 'OFF';
      }
    }

