        <text x="250" y="174" fill="#fbbf24" font-size="11" font-weight="bold" font-family="JetBrains Mono" text-anchor="middle">PLLB (MSNB)</text>
        <text x="250" y="193" fill="#ffffff" font-size="12" font-weight="bold" font-family="JetBrains Mono" text-anchor="middle">${pllB.active ? (pllB.vcoHz / 1e6).toFixed(2) + ' MHz' : 'STANDBY'}</text>
        <text x="250" y="211" fill="#94a3b8" font-size="10" font-family="JetBrains Mono" text-anchor="middle">${pllB.isInt ? 'INT x' + pllB.a : 'FRAC MULT'}</text>
