          <button onclick="filterHelpTutorial('dis_inv')" data-help-cat="dis_inv" class="help-pill px-2 py-0.5 text-[10px] font-mono rounded bg-lab-card text-slate-300 hover:text-white border border-lab-border transition">Dis R24 &amp; Invert</button>
