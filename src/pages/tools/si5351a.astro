    function renderRegisterTable() {
      const tbody = document.getElementById('register-table-body');
      const filterCheckbox = document.getElementById('reg-filter-modified');
      if (!tbody || !filterCheckbox) return;
      const filterMod = filterCheckbox.checked;
      const regs = state.computed.registers;
      const mod = state.computed.modifiedRegs;

      const countEl = document.getElementById('modified-reg-count');
      if (countEl) countEl.textContent = mod.size;

      let rowsHtml = '';
      for (let addr = 0; addr <= 187; addr++) {
        const isMod = mod.has(addr);
        if (filterMod && !isMod) continue;

        const val = regs[addr];
        const hexAddr = '0x' + addr.toString(16).toUpperCase().padStart(2, '0');
        const hexVal = '0x' + val.toString(16).toUpperCase().padStart(2, '0');
        const binVal = val.toString(2).padStart(8, '0');
        const desc = getRegDescription(addr);

        rowsHtml += `
          <tr class="${isMod ? 'bg-cyan-950/25 text-slate-100' : 'text-slate-500'} hover:bg-slate-800/50 transition">
            <td class="py-1 px-2">${addr}</td>
            <td class="py-1 px-2 ${isMod ? 'text-cyan-400 font-semibold' : ''}">${hexAddr}</td>
            <td class="py-1 px-2 ${isMod ? 'text-emerald-400 font-bold' : ''}">${hexVal}</td>
            <td class="py-1 px-2 text-[10px] tracking-wider">${binVal}</td>
            <td class="py-1 px-2 font-sans text-[10px] ${isMod ? 'text-slate-300' : 'text-slate-500'}">${desc}</td>
          </tr>
        `;
      }
      tbody.innerHTML = rowsHtml;
    }

