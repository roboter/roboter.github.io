---
import Base from '@layouts/Base.astro';
---

<Base
  title="Si5351A Interactive Configurator & Register Calculator"
  meta_title="Si5351A Interactive Configurator & Register Calculator"
  description="Interactive workbench for the Silicon Labs Si5351A (CJMCU-5351) 3-channel I2C clock generator. Configure XTAL load capacitance, PPM calibration, fractional PLL A/B and MultiSynth dividers, phase offsets, and export ready-to-compile C register headers."
  image="/images/tools/si5351a.svg"
  hideHero={true}
  hideVideos={true}
  fullWidth={true}
>
  <style is:global>
    #si5351a-workbench h1,
    #si5351a-workbench h2,
    #si5351a-workbench h3 {
      color: #f8fafc !important;
    }
    #si5351a-workbench ::-webkit-scrollbar { width: 5px; height: 5px; }
    #si5351a-workbench ::-webkit-scrollbar-track { background: #090d16; }
    #si5351a-workbench ::-webkit-scrollbar-thumb { background: #23304a; border-radius: 3px; }
    #si5351a-workbench ::-webkit-scrollbar-thumb:hover { background: #38bdf8; }
    #si5351a-workbench input[type="number"]::-webkit-inner-spin-button,
    #si5351a-workbench input[type="number"]::-webkit-outer-spin-button { opacity: 0.5; }
    #si5351a-workbench input[type="range"].rf-slider {
      -webkit-appearance: none;
      appearance: none;
      height: 4px;
      border-radius: 999px;
      background: #1e293b;
      outline: none;
      border: 1px solid #334155;
      cursor: pointer;
    }
    #si5351a-workbench input[type="range"].rf-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--slider-accent, #06b6d4);
      border: 1.5px solid #090d16;
      box-shadow: 0 0 6px var(--slider-glow, rgba(6, 182, 212, 0.6));
      cursor: pointer;
      transition: transform 0.08s ease;
    }
    #si5351a-workbench input[type="range"].rf-slider::-webkit-slider-thumb:hover { transform: scale(1.18); }
    #si5351a-workbench input[type="range"].rf-slider::-moz-range-thumb {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--slider-accent, #06b6d4);
      border: 1.5px solid #090d16;
      box-shadow: 0 0 6px var(--slider-glow, rgba(6, 182, 212, 0.6));
      cursor: pointer;
    }
    #si5351a-workbench input[type="range"].rf-slider:disabled { opacity: 0.3; cursor: not-allowed; }
    #si-tooltip {
      position: fixed;
      z-index: 9999;
      pointer-events: none;
      max-width: 360px;
      min-width: 190px;
      padding: 10px 13px;
      border-radius: 10px;
      background: rgba(9, 15, 28, 0.97);
      border: 1px solid rgba(34, 211, 238, 0.45);
      box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(15, 23, 42, 0.8), 0 0 18px rgba(6, 182, 212, 0.16);
      backdrop-filter: blur(10px);
      color: #e2e8f0;
      font-size: 12.5px;
      line-height: 1.48;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 0.12s ease, transform 0.12s ease;
    }
    #si-tooltip.visible {
      opacity: 1;
      transform: translateY(0);
    }
    #si-tooltip .si-tip-title {
      font-size: 13px;
      font-weight: 700;
      color: #38bdf8;
      margin-bottom: 4px;
      letter-spacing: 0.01em;
    }
    #si-tooltip .si-tip-body {
      color: #cbd5e1;
      font-size: 12.5px;
    }
    #si-tooltip code.si-tip-code {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      font-size: 11.5px;
      color: #fcd34d;
      background: rgba(251, 191, 36, 0.12);
      border: 1px solid rgba(251, 191, 36, 0.25);
      border-radius: 4px;
      padding: 0 4px;
      white-space: nowrap;
    }
  </style>

  <div id="si5351a-workbench" class="bg-lab-bg text-slate-200 font-sans antialiased text-xs min-h-[calc(100vh-4rem)] selection:bg-cyan-500/30 selection:text-cyan-200">

  <!-- Rich Floating Tooltip -->
  <div id="si-tooltip" role="tooltip" aria-hidden="true"></div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed bottom-3 right-3 z-50 flex flex-col gap-1.5 pointer-events-none"></div>

  <!-- Compact Top Header Bar -->
  <header class="sticky top-0 z-30 bg-lab-panel/95 backdrop-blur border-b border-lab-border px-3 py-1.5">
    <div class="max-w-[1680px] mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <a href="/tools" class="px-2 py-0.5 text-[11px] font-mono rounded bg-lab-card hover:bg-slate-800 border border-lab-border text-slate-300 hover:text-cyan-300 transition shrink-0" title="Back to Tools">&larr; Tools</a>
        <a href="/blog/20261120-embeetle-wch-ch32v003-si5351a-ssd1306-signal-generator" class="px-2 py-0.5 text-[11px] font-mono rounded bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 text-amber-300 transition shrink-0" title="Hardware Tutorial: Step-by-step Embeetle + WCH CH32V003 + Si5351A + SSD1306 OLED Signal Generator guide.">CH32V003 + Embeetle Tutorial &rarr;</a>
        <button onclick="openHelpTutorial('all')" class="px-2 py-0.5 text-[11px] font-mono rounded bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-500/40 text-cyan-300 transition shrink-0" title="Controls & Settings Help Tutorial: Jump to the complete plain-English guide explaining Dis R24 (Low/High/High-Z/Never), Invert, Drive, R-Div, Modes, PLLs, and Scope controls.">? Help Guide</button>
        <div class="w-6 h-6 rounded bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center border border-cyan-400/40 shrink-0">
          <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
          </svg>
        </div>
        <div class="flex items-center gap-1.5 flex-wrap">
          <h1 class="text-sm font-bold tracking-tight text-white">Si5351A Workbench</h1>
          <span class="px-1.5 py-0.2 text-[10px] font-mono font-semibold bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 rounded" title="CJMCU-5351 Breakout: Common 3-output Si5351A module with 25 MHz crystal, onboard 3.3V LDO, and I2C level shifters.">CJMCU-5351</span>
          <span class="hidden sm:inline-block px-1.5 py-0.2 text-[10px] font-mono bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 rounded" title="I2C Address 0x60: Standard 7-bit I2C slave address for Si5351A (0xC0 write / 0xC1 read in 8-bit form). Supports up to 400 kHz Fast Mode.">I²C 0x60</span>
          <span class="hidden md:inline-block text-[10px] text-slate-400 font-mono" title="Frequency Range: Guaranteed 8 kHz to 160 MHz per Si5351A datasheet; up to 225 MHz overclocked using DIVBY4 (900 MHz VCO / 4).">8kHz–160MHz (225MHz OC)</span>
        </div>
      </div>

      <!-- Compact System Presets -->
      <div class="flex flex-wrap items-center gap-1">
        <span class="text-[10px] font-mono text-slate-500 mr-0.5">PRESETS:</span>
        <button onclick="applySystemPreset('vfo_bfo')" title="HF VFO + BFO Preset: Sets CH0 = 14.200 MHz (PLLA) as 20m VFO and CH1 = 10.700 MHz (PLLB) as BFO/IF carrier for superheterodyne receivers." class="px-2 py-0.5 text-[11px] font-medium rounded bg-lab-card hover:bg-slate-800 border border-lab-border text-cyan-300 transition">HF VFO+BFO</button>
        <button onclick="applySystemPreset('iq_sdr')" title="Quadrature I/Q 90° Preset: Couples CH0 and CH1 on PLLA at 7.074 MHz and programs Reg 166 (CLK1_PHOFF) for an exact 90° quadrature SDR local oscillator." class="px-2 py-0.5 text-[11px] font-medium rounded bg-lab-card hover:bg-slate-800 border border-lab-border text-purple-300 transition">I/Q 90°</button>
        <button onclick="applySystemPreset('vhf_beacon')" title="2m VHF + IF + Ref Preset: Sets CH0 = 145.000 MHz (PLLA), CH1 = 10.700 MHz IF (PLLB), and CH2 = 25.000 MHz Integer low-jitter reference (PLLB)." class="px-2 py-0.5 text-[11px] font-medium rounded bg-lab-card hover:bg-slate-800 border border-lab-border text-amber-300 transition">2m VHF+IF</button>
        <button onclick="applySystemPreset('diff_clock')" title="Differential 180° Clock Preset: Couples CH0 and CH1 on PLLA at 27.000 MHz and sets Reg 17[4] (CLK1_INV=1) for a zero-jitter 180° inverted differential pair." class="px-2 py-0.5 text-[11px] font-medium rounded bg-lab-card hover:bg-slate-800 border border-lab-border text-emerald-300 transition">Diff 180°</button>
        <button onclick="applySystemPreset('spread_emi')" title="Spread Spectrum EMI Preset: Enables PLLA Spread Spectrum in Reg 149–161 (SSC_EN=1, Center-spread ±1.5%) at 48.000 MHz to reduce peak clock harmonics." class="px-2 py-0.5 text-[11px] font-medium rounded bg-lab-card hover:bg-slate-800 border border-lab-border text-rose-300 transition">SpreadSpec</button>
      </div>
    </div>
  </header>

  <main class="max-w-[1680px] mx-auto p-2.5 space-y-2.5">

    <!-- COMPACT TOP RIBBON: Global Reference + PLL A/B Status -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-2.5">
      
      <!-- Global Crystal & Fanout Ribbon -->
      <section class="xl:col-span-7 bg-lab-panel border border-lab-border rounded-lg p-2.5">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-center">
          
          <!-- XTAL Frequency + Load Cap -->
          <div class="sm:col-span-5 bg-lab-card border border-lab-border rounded p-2" title="Si5351A Datasheet §4.1 / AN619 Reg 183: Crystal oscillator reference (25 or 27 MHz nominal; 10–40 MHz range) and internal on-chip load capacitance (XTAL_CL[7:6]).">
            <div class="flex items-center justify-between gap-1 mb-1">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">XTAL &amp; Load Cap <span class="font-mono text-[9px] text-cyan-500/80">Reg 183</span></span>
              <span id="effective-xtal-readout" class="text-[10px] font-mono text-emerald-400">25,000,000 Hz</span>
            </div>
            <div class="flex items-center gap-1">
              <select id="xtal-select" onchange="onXtalSelectChange()" title="Nominal external crystal frequency (f_XTAL). Feeds PLLA/PLLB (Reg 15) and Direct Bypass (CLKx_SRC=00)." class="flex-1 bg-lab-bg border border-lab-border rounded px-1.5 py-1 text-[11px] font-mono text-white focus:outline-none focus:border-cyan-500">
                <option value="25000000" selected>25.000 MHz</option>
                <option value="27000000">27.000 MHz</option>
                <option value="custom">Custom Hz...</option>
              </select>
              <select id="xtal-cl" onchange="onXtalClChange(this.value)" title="Reg 183 (0xB7) bits [7:6] XTAL_CL: Internal crystal load capacitance (01=6pF, 10=8pF, 11=10pF). Bits [5:0] fixed to 0x12 per AN619." class="w-16 bg-lab-bg border border-lab-border rounded px-1 py-1 text-[11px] font-mono text-cyan-300 focus:outline-none focus:border-cyan-500">
                <option value="1">6pF</option>
                <option value="2">8pF</option>
                <option value="3" selected>10pF</option>
              </select>
            </div>
            <div id="xtal-custom-wrap" class="mt-1 hidden flex items-center gap-1">
              <input type="number" id="xtal-custom-hz" value="25000000" step="100" min="10000000" max="40000000" oninput="onXtalCustomInput(this.value)" class="w-full bg-lab-bg border border-lab-border rounded px-1.5 py-0.5 text-[11px] font-mono text-cyan-300">
              <span class="text-[10px] font-mono text-slate-400">Hz</span>
            </div>
          </div>

          <!-- PPM Calibration Slider -->
          <div class="sm:col-span-4 bg-lab-card border border-lab-border rounded p-2" title="Software crystal frequency trim: f_XTAL_eff = f_XTAL * (1 + ppm / 1e6). Compensates crystal tolerance &amp; stray capacitance by adjusting PLLA/PLLB (Reg 26–41) and MS0–2 (Reg 42–65) dividers.">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Calib Trim <span class="font-mono text-[9px] text-cyan-500/80">SW f_XTAL</span></span>
              <span id="calib-hz-badge" class="text-[10px] font-mono text-cyan-400">0.0 Hz</span>
            </div>
            <div class="flex items-center gap-1 mb-1">
              <button onclick="adjustPpm(-1)" class="px-1.5 py-0.2 text-[11px] font-mono bg-lab-bg hover:bg-slate-800 border border-lab-border rounded text-cyan-300">-</button>
              <input type="number" id="xtal-ppm" value="0" step="1" min="-500" max="500" oninput="syncPpmFromInput(this.value)" class="w-full bg-lab-bg border border-lab-border rounded px-1 py-0.2 text-[11px] font-mono text-center text-white focus:outline-none focus:border-cyan-500">
              <span class="text-[10px] font-mono text-slate-400">ppm</span>
              <button onclick="adjustPpm(1)" class="px-1.5 py-0.2 text-[11px] font-mono bg-lab-bg hover:bg-slate-800 border border-lab-border rounded text-cyan-300">+</button>
              <button onclick="setPpm(0)" title="Reset to 0 ppm" class="px-1 py-0.2 text-[10px] font-mono bg-lab-bg hover:bg-slate-800 border border-lab-border rounded text-slate-400">0</button>
            </div>
            <input type="range" id="xtal-ppm-slider" min="-500" max="500" step="1" value="0" oninput="syncPpmFromSlider(this.value)" class="w-full rf-slider" style="--slider-accent: #06b6d4; --slider-glow: rgba(6,182,212,0.5);">
          </div>

          <!-- Reg 187 Fanout Toggles -->
          <div class="sm:col-span-3 bg-lab-card border border-lab-border rounded p-2" title="AN619 Reg 187 (0xBB) Fanout Enable: Controls internal clock distribution buffers to save power when unused.">
            <div class="flex items-center justify-between text-[10px] font-semibold uppercase tracking-wider text-slate-400 mb-1">
              <span>Fanout (Reg 187)</span>
              <span id="fanout-reg-hex" class="font-mono text-[9px] text-cyan-400">0x50</span>
            </div>
            <div class="flex sm:flex-col justify-between gap-0.5 text-[11px]">
              <label class="flex items-center justify-between cursor-pointer" title="Reg 187 [bit 6] XO_FANOUT_EN (0x40): Routes XTAL oscillator to MultiSynth &amp; CLKx_SRC=00 bypass mux. Required for Direct XTAL Bypass mode.">
                <span class="text-slate-300">XO <span class="text-[9px] font-mono text-slate-500">[b6]</span></span>
                <input type="checkbox" id="fanout-xo" checked onchange="onFanoutChange()" class="w-3 h-3 rounded border-slate-600 bg-lab-bg text-cyan-500 focus:ring-0">
              </label>
              <label class="flex items-center justify-between cursor-pointer" title="Reg 187 [bit 4] MS_FANOUT_EN (0x10): Enables MultiSynth 0 &amp; 4 to fan out to other output stages (CLKx_SRC=10).">
                <span class="text-slate-300">MS0/4 <span class="text-[9px] font-mono text-slate-500">[b4]</span></span>
                <input type="checkbox" id="fanout-ms" checked onchange="onFanoutChange()" class="w-3 h-3 rounded border-slate-600 bg-lab-bg text-cyan-500 focus:ring-0">
              </label>
              <label class="flex items-center justify-between cursor-pointer" title="Reg 187 [bit 7] CLKIN_FANOUT_EN (0x80): Enables external CLKIN pin fanout (Si5351C only; unused on 10-MSOP Si5351A).">
                <span class="text-slate-300">CLKIN <span class="text-[9px] font-mono text-slate-500">[b7]</span></span>
                <input type="checkbox" id="fanout-clkin" onchange="onFanoutChange()" class="w-3 h-3 rounded border-slate-600 bg-lab-bg text-cyan-500 focus:ring-0">
              </label>
            </div>
          </div>

        </div>
      </section>

      <!-- Compact PLLA & PLLB VCO Telemetry Cards -->
      <section class="xl:col-span-5 bg-lab-panel border border-lab-border rounded-lg p-2.5 grid grid-cols-1 sm:grid-cols-2 gap-2">
        <!-- PLLA -->
        <div class="bg-lab-card border border-lab-border rounded p-2 flex flex-col justify-between" title="PLLA (MSNA): Reg 26–33 (0x1A–0x21). Multiplies f_XTAL by (a + b/c) to 600–900 MHz VCO. Reset via Reg 177 [bit 5] PLLA_RST.">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold text-cyan-400 flex items-center gap-1">
              PLLA (MSNA) <span class="text-[9px] font-mono font-normal text-slate-500">R26–33</span>
              <span id="plla-ss-badge" class="hidden px-1 py-0 text-[9px] bg-rose-500/20 text-rose-300 border border-rose-500/40 rounded">SS</span>
            </span>
            <span id="plla-status-badge" class="px-1.5 py-0.2 text-[9px] font-mono rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">IN SPEC</span>
          </div>
          <div id="plla-vco-freq" class="text-sm font-mono font-bold text-white my-0.5">800.000000 MHz</div>
          <div class="flex items-center justify-between text-[10px] font-mono text-slate-400">
            <span id="plla-mult-str" class="truncate">32 (Int)</span>
            <span id="plla-users-str" class="text-cyan-300 font-semibold">CLK0</span>
          </div>
        </div>

        <!-- PLLB -->
        <div class="bg-lab-card border border-lab-border rounded p-2 flex flex-col justify-between" title="PLLB (MSNB): Reg 34–41 (0x22–0x29). Multiplies f_XTAL by (a + b/c) to 600–900 MHz VCO. Reset via Reg 177 [bit 7] PLLB_RST.">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold text-amber-400 flex items-center gap-1">
              PLLB (MSNB) <span class="text-[9px] font-mono font-normal text-slate-500">R34–41</span>
            </span>
            <span id="pllb-status-badge" class="px-1.5 py-0.2 text-[9px] font-mono rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">IN SPEC</span>
          </div>
          <div id="pllb-vco-freq" class="text-sm font-mono font-bold text-white my-0.5">800.000000 MHz</div>
          <div class="flex items-center justify-between text-[10px] font-mono text-slate-400">
            <span id="pllb-mult-str" class="truncate">32 (Int)</span>
            <span id="pllb-users-str" class="text-amber-300 font-semibold">CLK1</span>
          </div>
        </div>
      </section>
    </div>

    <!-- COMPACT 3-CHANNEL GRID: CLK0, CLK1, CLK2 -->
    <section id="channels-grid" class="grid grid-cols-1 lg:grid-cols-3 gap-2.5">
      <!-- Rendered dynamically by JS -->
    </section>

    <!-- COMPACT BOTTOM WORKSPACE: Scope + Tabbed Diagram / Register Map / C-Code Export -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-2.5">
      
      <!-- Left: Compact Live Oscilloscope Preview (5 cols) -->
      <section class="xl:col-span-5 bg-lab-panel border border-lab-border rounded-lg p-2.5 flex flex-col">
        <div class="flex flex-wrap items-center justify-between gap-1.5 mb-1.5">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            <h2 class="text-[11px] font-semibold uppercase tracking-wider text-slate-200">Output Phase &amp; Waveform Scope</h2>
          </div>
          <div class="flex items-center gap-1">
            <span id="scope-tb-badge" class="px-1.5 py-0.2 text-[10px] font-mono bg-purple-500/15 text-purple-300 border border-purple-500/30 rounded" title="Active horizontal timebase across 10 grid divisions">Auto</span>
            <select id="scope-timebase-select" onchange="onScopeTimebaseChange(this.value)" oninput="onScopeTimebaseChange(this.value)" title="Horizontal Timebase (Time/Div): Real timebase shows exact frequency ratios across channels; zoom in/out like a real oscilloscope." class="bg-lab-card border border-lab-border rounded px-1 py-0.2 text-[10px] font-mono text-slate-200 focus:outline-none focus:border-cyan-500">
              <option value="auto" selected>Auto (Real)</option>
              <option value="1e-9">1 ns/div</option>
              <option value="2e-9">2 ns/div</option>
              <option value="5e-9">5 ns/div</option>
              <option value="10e-9">10 ns/div</option>
              <option value="20e-9">20 ns/div</option>
              <option value="50e-9">50 ns/div</option>
              <option value="100e-9">100 ns/div</option>
              <option value="200e-9">200 ns/div</option>
              <option value="500e-9">500 ns/div</option>
              <option value="1e-6">1 &mu;s/div</option>
              <option value="2e-6">2 &mu;s/div</option>
              <option value="5e-6">5 &mu;s/div</option>
              <option value="10e-6">10 &mu;s/div</option>
              <option value="20e-6">20 &mu;s/div</option>
              <option value="50e-6">50 &mu;s/div</option>
              <option value="100e-6">100 &mu;s/div</option>
              <option value="log">Log (Demo)</option>
            </select>
            <button id="scope-trig-btn" onclick="toggleScopeTrigger()" title="Oscilloscope Trigger Mode: Free-Run scrolling (default) vs Rising-Edge Trigger locked at Division 1. Tip: switch to Trig while tuning to measure period, pulse width and phase precisely — in Free mode the waveform keeps scrolling." class="px-1.5 py-0.2 text-[10px] font-mono bg-lab-card hover:bg-slate-800 border border-lab-border rounded text-slate-300">Free</button>
            <button id="scope-pause-btn" onclick="toggleScopePause()" title="Pause / Resume Scope: Freeze the live oscilloscope waveform to inspect edges, phase relationships, and cycle counts." class="px-2 py-0.2 text-[10px] font-mono bg-lab-card hover:bg-slate-800 border border-lab-border rounded text-slate-300">Pause</button>
          </div>
        </div>
        <div class="relative flex-1 min-h-[210px] bg-lab-bg border border-lab-border/80 rounded overflow-hidden">
          <canvas id="scope-canvas" class="w-full h-full block"></canvas>
          <div class="absolute bottom-1.5 left-1.5 right-1.5 flex flex-wrap items-center justify-between gap-1.5 text-[10px] font-mono bg-lab-panel/90 backdrop-blur px-2 py-0.5 rounded border border-lab-border/70">
            <span class="text-cyan-400">&#9632; CH0 (CLK0): <span id="scope-lbl-0">14.20M</span></span>
            <span class="text-amber-400">&#9632; CH1 (CLK1): <span id="scope-lbl-1">10.70M</span></span>
            <span class="text-purple-400">&#9632; CH2 (CLK2): <span id="scope-lbl-2">OFF</span></span>
          </div>
        </div>
      </section>

      <!-- Right: Tabbed Utility Panel (Block Diagram | Register Map | C Code Export) (7 cols) -->
      <section class="xl:col-span-7 bg-lab-panel border border-lab-border rounded-lg p-2.5 flex flex-col">
        <div class="flex flex-wrap items-center justify-between gap-2 pb-2 mb-2 border-b border-lab-border/80">
          <!-- Workspace Tabs -->
