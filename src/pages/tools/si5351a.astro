          { addr: '15 (0x0F)', name: 'PLL Input Source', bits: '[3] PLLB_SRC | [2] PLLA_SRC (0=XTAL, 1=CLKIN)', val: `${hex(regs[15])} (${bin(regs[15])})` },
          { addr: '16–18 (0x10–0x12)', name: 'CLK0..2 Control', bits: '[7] PDN | [6] MS_INT | [5] MS_SRC(0=A,1=B) | [4] INV | [3:2] SRC | [1:0] IDRV', val: `C0=${hex(regs[16])} C1=${hex(regs[17])} C2=${hex(regs[18])}` },
          { addr: '24 (0x18)', name: 'Disable State (Dis)', bits: '[5:4] CLK2 | [3:2] CLK1 | [1:0] CLK0 (00=Low, 01=High, 10=Hi-Z, 11=Never)', val: `${hex(regs[24])} (${bin(regs[24])})` },
          { addr: '26–33 (0x1A–0x21)', name: 'MSNA (PLLA VCO)', bits: '8-byte AN619 block: P3[15:0], P1[17:0], P3[19:16]|P2[19:16], P2[15:0]', val: `${(state.computed.pllA.vcoHz / 1e6).toFixed(2)} MHz (a=${state.computed.pllA.a})` },
          { addr: '34–41 (0x22–0x29)', name: 'MSNB (PLLB VCO)', bits: '8-byte AN619 block: P3[15:0], P1[17:0], P3[19:16]|P2[19:16], P2[15:0]', val: `${(state.computed.pllB.vcoHz / 1e6).toFixed(2)} MHz (a=${state.computed.pllB.a})` },
          { addr: '42–65 (0x2A–0x41)', name: 'MultiSynth MS0..2', bits: '3×8-byte blocks; Byte 2 (R44/52/60) = [6:4] R_DIV | [3:2] DIVBY4 | [1:0] P1[17:16]', val: `R44=${hex(regs[44])} R52=${hex(regs[52])} R60=${hex(regs[60])}` },
          { addr: '149–161 (0x95–0xA1)', name: 'Spread Spectrum', bits: 'R149[7] SSC_EN | R151[7] SSC_MODE (0=Down,1=Center) | SSDN/SSUP/SSUDP', val: `R149=${hex(regs[149])} R151=${hex(regs[151])}` },
          { addr: '165–167 (0xA5–0xA7)', name: 'Phase Offset (PHOFF)', bits: '[6:0] CLKx_PHOFF (0..127 in T_VCO/4 steps; latches on Reg 177 reset)', val: `C0=${hex(regs[165])} C1=${hex(regs[166])} C2=${hex(regs[167])}` },
          { addr: '177 (0xB1)', name: 'PLL Soft Reset', bits: '[7] PLLB_RST | [5] PLLA_RST (self-clearing reset strobe)', val: `${hex(regs[177])} (${bin(regs[177])})` },
          { addr: '183 (0xB7)', name: 'XTAL Load Cap (CL)', bits: '[7:6] XTAL_CL (01=6pF, 10=8pF, 11=10pF) | [5:0]=0x12 (AN619 fixed)', val: `${hex(regs[183])} (${bin(regs[183])})` },
          { addr: '187 (0xBB)', name: 'Fanout Enable', bits: '[7] CLKIN_FANOUT_EN | [6] XO_FANOUT_EN | [4] MS_FANOUT_EN', val: `${hex(regs[187])} (${bin(regs[187])})` }
        ];
        bfBody.innerHTML = keyRows.map(r => `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="py-1 px-2 text-cyan-400 font-semibold whitespace-nowrap">${r.addr}</td>
            <td class="py-1 px-2 text-white font-sans font-medium whitespace-nowrap">${r.name}</td>
            <td class="py-1 px-2 text-slate-300 text-[10px]">${r.bits}</td>
            <td class="py-1 px-2 text-emerald-400 font-semibold whitespace-nowrap">${r.val}</td>
          </tr>
        `).join('');
      }

      if (mapBody) {
        const filterMod = filterEl ? filterEl.checked : true;
        let html = '';
        for (let addr = 0; addr <= 187; addr++) {
          const isMod = mod.has(addr);
          if (filterMod && !isMod) continue;
          const val = regs[addr];
          html += `
            <tr class="${isMod ? 'bg-cyan-950/25 text-slate-100' : 'text-slate-500'} hover:bg-slate-800/50 transition">
              <td class="py-1 px-2">${addr}</td>
              <td class="py-1 px-2 ${isMod ? 'text-cyan-400 font-semibold' : ''}">${hex(addr)}</td>
              <td class="py-1 px-2 ${isMod ? 'text-emerald-400 font-bold' : ''}">${hex(val)}</td>
              <td class="py-1 px-2 text-[10px] tracking-wider">${bin(val)}</td>
              <td class="py-1 px-2 font-sans text-[10.5px] ${isMod ? 'text-slate-300' : 'text-slate-500'}">${getRegDescription(addr)}</td>
            </tr>
          `;
        }
        mapBody.innerHTML = html;
      }
    }

    function filterHelpTutorial(cat) {
      const grid = document.getElementById('help-tutorial-grid');
      if (grid && grid.children) {
        Array.from(grid.children).forEach(card => {
          const group = card.getAttribute && card.getAttribute('data-help-group');
          const show = cat === 'all' || group === cat;
          if (card.classList) card.classList.toggle('hidden', !show);
        });
      }
      const pillsWrap = document.getElementById('help-cat-pills');
      if (pillsWrap && pillsWrap.children) {
        Array.from(pillsWrap.children).forEach(btn => {
          const isActive = (btn.getAttribute && btn.getAttribute('data-help-cat')) === cat;
          btn.className = isActive
            ? 'help-pill px-2 py-0.5 text-[10px] font-mono rounded bg-cyan-600 text-white border border-cyan-500 transition'
            : 'help-pill px-2 py-0.5 text-[10px] font-mono rounded bg-lab-card text-slate-300 hover:text-white border border-lab-border transition';
        });
      }
    }

    function openHelpTutorial(cat = 'all') {
      filterHelpTutorial(cat);
      const sec = document.getElementById('workbench-help-tutorial');
      if (sec && typeof sec.scrollIntoView === 'function') {
        sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    Object.assign(window, {
      switchWorkspaceTab,
      filterHelpTutorial,
      openHelpTutorial,
      onXtalSelectChange,
      onXtalCustomInput,
      onXtalClChange,
      syncPpmFromSlider,
      syncPpmFromInput,
      adjustPpm,
      setPpm,
      onFanoutChange,
      updateChannelField,
      applyChannelPreset,
      setChannelStep,
      nudgeChannelFreq,
      onChannelDirectHzInput,
      onChannelLogSlider,
      onChannelFineTrimSlider,
      onChannelPhaseDegSlider,
      applySystemPreset,
      onScopeTimebaseChange,
      toggleScopeTrigger,
      toggleScopePause,
      renderRegisterTable,
      renderDatasheetDocs,
      renderHelpRegisterMap,
      generateCCode,
      copyCCode,
      downloadCCode,
    });

    function initRichTooltips() {
      const root = document.getElementById('si5351a-workbench');
      const tipEl = document.getElementById('si-tooltip');
      if (!root || !tipEl || typeof root.addEventListener !== 'function') return;

      let activeTarget = null;
      let pointerDown = false;

      const esc = (s) => String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      function highlightCodes(text) {
        return esc(text).replace(
          /\b(Reg\s+\d+(?:[–-]\d+)?(?:\s*\[[^\]]+\])?|R\d+(?:[–-]\d+)?(?:\[[^\]]+\])?|0x[0-9A-Fa-f]+|AN619(?:\s*§[\d.]+)?|CLK\d?_[A-Z0-9_]+|MS\d?_[A-Z0-9_]+|XTAL_CL\[[^\]]+\]|SSC_[A-Z0-9_]+|DIVBY4)\b/g,
          '<code class="si-tip-code">$1</code>'
        );
      }

      function renderTipContent(raw) {
        const colonIdx = raw.indexOf(': ');
        if (colonIdx > 0 && colonIdx < 48) {
          const title = raw.slice(0, colonIdx);
          const body = raw.slice(colonIdx + 2);
          tipEl.innerHTML = `<div class="si-tip-title">${esc(title)}</div><div class="si-tip-body">${highlightCodes(body)}</div>`;
        } else {
          tipEl.innerHTML = `<div class="si-tip-body">${highlightCodes(raw)}</div>`;
        }
      }

      function positionTip(clientX, clientY, targetRect) {
        const pad = 12;
        const vw = window.innerWidth || 1280;
        const vh = window.innerHeight || 800;
        const tw = tipEl.offsetWidth || 280;
        const th = tipEl.offsetHeight || 64;

        let x = (clientX !== null ? clientX + 14 : targetRect.left);
        let y = (clientY !== null ? clientY + 18 : targetRect.bottom + 8);

        if (x + tw + pad > vw) x = Math.max(pad, vw - tw - pad);
        if (x < pad) x = pad;

        if (y + th + pad > vh) {
          y = (clientY !== null ? clientY - th - 14 : targetRect.top - th - 8);
        }
        if (y < pad) y = pad;

        tipEl.style.left = `${Math.round(x)}px`;
        tipEl.style.top = `${Math.round(y)}px`;
      }

      function extractTip(el) {
        if (!el) return '';
        const t = el.getAttribute('title');
        if (t) {
          el.setAttribute('data-tip', t);
          el.removeAttribute('title');
          return t;
        }
        return el.getAttribute('data-tip') || '';
      }

      function showFor(el, clientX, clientY) {
        if (pointerDown) return;
        const text = extractTip(el);
        if (!text) return hideTip();
        activeTarget = el;
        renderTipContent(text);
        tipEl.classList.add('visible');
        tipEl.setAttribute('aria-hidden', 'false');
        positionTip(clientX, clientY, el.getBoundingClientRect());
      }

      function hideTip() {
        activeTarget = null;
        tipEl.classList.remove('visible');
        tipEl.setAttribute('aria-hidden', 'true');
      }

      root.addEventListener('mouseover', (e) => {
        const el = e.target && e.target.closest ? e.target.closest('[data-tip], [title]') : null;
        if (!el) {
          hideTip();
          return;
        }
        if (el !== activeTarget) {
          showFor(el, e.clientX, e.clientY);
        }
      });

      root.addEventListener('mousemove', (e) => {
        if (!activeTarget || pointerDown) return;
        const el = e.target && e.target.closest ? e.target.closest('[data-tip], [title]') : null;
        if (el && el !== activeTarget) {
          showFor(el, e.clientX, e.clientY);
        } else if (activeTarget) {
          positionTip(e.clientX, e.clientY, activeTarget.getBoundingClientRect());
        }
      });

      root.addEventListener('mouseout', (e) => {
        if (!activeTarget) return;
        const rel = e.relatedTarget;
        if (!rel || !root.contains(rel)) {
          hideTip();
          return;
        }
        const nextEl = rel.closest ? rel.closest('[data-tip], [title]') : null;
        if (!nextEl) hideTip();
      });

      root.addEventListener('focusin', (e) => {
        const el = e.target && e.target.closest ? e.target.closest('[data-tip], [title]') : null;
        if (el) showFor(el, null, null);
      });

      root.addEventListener('focusout', () => hideTip());
      root.addEventListener('mousedown', () => { pointerDown = true; hideTip(); });
      window.addEventListener('mouseup', () => { pointerDown = false; });
      window.addEventListener('scroll', hideTip, true);
    }

    renderChannelCards();
    recalculateAll();
    initScopeLoop();
    initRichTooltips();
    })();
  </script>
  </div>
</Base>