          <text x="442" y="${y + 12}" fill="#cbd5e1" font-size="10" font-family="JetBrains Mono" text-anchor="middle">${!active ? 'OFF' : (comp.bypass ? 'XTAL' : '÷' + (comp.msA + comp.msB / comp.msC).toFixed(2))}</text>

