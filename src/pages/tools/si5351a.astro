          <button onclick="filterHelpTutorial('sliders')" data-help-cat="sliders" class="help-pill px-2 py-0.5 text-[10px] font-mono rounded bg-lab-card text-slate-300 hover:text-white border border-lab-border transition">Phase / Drive / R-Div</button>
          <button onclick="filterHelpTutorial('global')" data-help-cat="global" class="help-pill px-2 py-0.5 text-[10px] font-mono rounded bg-lab-card text-slate-300 hover:text-white border border-lab-border transition">XTAL, Calib &amp; PLLs</button>
          <button onclick="filterHelpTutorial('scope')" data-help-cat="scope" class="help-pill px-2 py-0.5 text-[10px] font-mono rounded bg-lab-card text-slate-300 hover:text-white border border-lab-border transition">Scope &amp; Tabs</button>
          <button onclick="filterHelpTutorial('regs')" data-help-cat="regs" class="help-pill px-2 py-0.5 text-[10px] font-mono rounded bg-lab-card text-amber-300 hover:text-amber-200 border border-amber-500/40 transition">Registers &amp; Map</button>
