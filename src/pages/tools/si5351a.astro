    function formatPeriodSec(sec) {
      if (!Number.isFinite(sec) || sec <= 0) return '--';
      if (sec >= 1e-3) return (sec * 1e3).toFixed(2) + 'ms';
      if (sec >= 1e-6) return (sec * 1e6).toFixed(sec * 1e6 >= 100 ? 1 : 2) + 'µs';
      return (sec * 1e9).toFixed(sec * 1e9 >= 100 ? 1 : 2) + 'ns';
    }

    function formatTimeDiv(sec) {
      if (sec >= 1e-3) return Math.round(sec * 1e3) + 'ms/div';
      if (sec >= 1e-6) return Math.round(sec * 1e6) + 'µs/div';
      return Math.round(sec * 1e9) + 'ns/div';
    }

    function formatCyclesCount(n) {
      if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
      if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
      if (n >= 10) return n.toFixed(0);
      if (n >= 0.1) return n.toFixed(2);
      return '<0.1';
    }

    const SCOPE_TB_STEPS = [
      1e-9, 2e-9, 5e-9, 10e-9, 20e-9, 50e-9, 100e-9, 200e-9, 500e-9,
      1e-6, 2e-6, 5e-6, 10e-6, 20e-6, 50e-6, 100e-6
    ];

    function pickAutoSecPerDiv(activeFreqs) {
      if (!activeFreqs.length) return 50e-9;
      // Anchor timebase to the lowest active frequency (~4 cycles across 10 divs)
      // so slow channels remain legible while high-frequency channels visibly pack into dense RF bands
      const refFreq = Math.min(...activeFreqs);
      const targetSecPerDiv = 4 / (10 * Math.max(1000, refFreq));
      let best = SCOPE_TB_STEPS[SCOPE_TB_STEPS.length - 1];
      for (let i = 0; i < SCOPE_TB_STEPS.length; i++) {
        if (SCOPE_TB_STEPS[i] >= targetSecPerDiv) {
          best = SCOPE_TB_STEPS[i];
          break;
        }
      }
      return best;
    }

    function initScopeLoop() {
      const canvas = document.getElementById('scope-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      function draw() {
        if (!canvas.isConnected) return;
        const rect = canvas.parentElement.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const cssW = Math.max(200, Math.floor(rect.width));
        const cssH = Math.max(180, Math.floor(rect.height));

        if (canvas.width !== Math.floor(cssW * dpr) || canvas.height !== Math.floor(cssH * dpr)) {
          canvas.width = Math.floor(cssW * dpr);
          canvas.height = Math.floor(cssH * dpr);
        }

        ctx.save();
        ctx.scale(dpr, dpr);
        const w = cssW;
        const h = cssH;
        ctx.clearRect(0, 0, w, h);

        const startX = 68;
        const drawW = Math.max(60, w - 76);

        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 1;
        for (let c = 0; c <= 10; c++) {
          const x = startX + (drawW / 10) * c;
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
        }
        for (let r = 1; r < 6; r++) {
          const y = (h / 6) * r;
          ctx.beginPath(); ctx.moveTo(startX, y); ctx.lineTo(startX + drawW, y); ctx.stroke();
        }

        const laneHeight = (h - 30) / 3;
        const colors = ['#22d3ee', '#fbbf24', '#c084fc'];
        const fillColors = ['rgba(34, 211, 238, 0.24)', 'rgba(251, 191, 36, 0.24)', 'rgba(192, 132, 252, 0.24)'];

        const activeFreqs = [];
        for (let i = 0; i < 3; i++) {
          const c = state.computed.ch[i];
          if (c && c.active && c.actualHz > 0) activeFreqs.push(c.actualHz);
        }

        const tbSelectEl = document.getElementById('scope-timebase-select');
        const activeTimebase = tbSelectEl ? tbSelectEl.value : state.scopeTimebase;
        state.scopeTimebase = activeTimebase;

        const isLogMode = activeTimebase === 'log';
        let secPerDiv = 50e-9;
        if (!isLogMode) {
          secPerDiv = activeTimebase === 'auto'
            ? pickAutoSecPerDiv(activeFreqs)
            : (parseFloat(activeTimebase) || 50e-9);
        }
        const windowSec = secPerDiv * 10;

        // Draw subtle rising-edge trigger marker at Division 1 (t = 0)
        const trigNormX = 0.1;
        if (!isLogMode && state.scopeTriggered) {
          const trigX = startX + drawW * trigNormX;
          ctx.save();
          ctx.strokeStyle = 'rgba(16, 185, 129, 0.45)';
          ctx.setLineDash([3, 3]);
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(trigX, 0);
          ctx.lineTo(trigX, h - 22);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = '#34d399';
          ctx.font = '600 8px "JetBrains Mono", monospace';
          ctx.fillText('T', trigX + 2, 9);
          ctx.restore();
        }

        const tbBadge = document.getElementById('scope-tb-badge');
        if (tbBadge) {
          tbBadge.textContent = isLogMode ? 'LOG SCALE' : formatTimeDiv(secPerDiv);
        }

        const ch0 = state.channels[0];
        const ch1 = state.channels[1];
        const comp0 = state.computed.ch[0];
        const comp1 = state.computed.ch[1];
        const isPairCoupled = (
          comp0 && comp0.active && comp1 && comp1.active &&
          (ch0.mode === 'quadrature' || ch0.mode === 'differential' ||
           Math.abs(comp0.actualHz - comp1.actualHz) < 1)
        );

        const driveScales = [0.52, 0.68, 0.84, 1.0];
        const driveLabels = ['2mA', '4mA', '6mA', '8mA'];

        for (let i = 0; i < 3; i++) {
          const comp = state.computed.ch[i];
          const ch = state.channels[i];
          const centerY = 10 + laneHeight * (i + 0.5);
          const maxAmp = laneHeight * 0.34;
          const amp = maxAmp * (driveScales[ch.drive] ?? 1.0);

          ctx.fillStyle = colors[i];
          ctx.font = '600 10px "JetBrains Mono", monospace';
          ctx.fillText(`CH${i}/CLK${i}`, 6, centerY - maxAmp + 7);

          if (!comp || !comp.active) {
            const disLabels = ['OFF (0V)', 'OFF (3.3V)', 'OFF (Hi-Z)', 'OFF (Never)'];
            ctx.fillStyle = '#64748b';
            ctx.font = '400 8.5px "JetBrains Mono", monospace';
            ctx.fillText(disLabels[ch.disableState] || 'OFF (0V)', 6, centerY + 6);
            const flatY = ch.disableState === 1
              ? centerY - maxAmp
              : (ch.disableState === 2 || ch.disableState === 3 ? centerY : centerY + maxAmp);
            ctx.strokeStyle = ch.disableState === 1 ? '#64748b' : '#334155';
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(startX, flatY);
            ctx.lineTo(startX + drawW, flatY);
            ctx.stroke();
            ctx.setLineDash([]);
            continue;
          }

          // Display real signal period T = 1/f and Drive/R-Div/Invert under channel label
          ctx.fillStyle = '#94a3b8';
          ctx.font = '400 8.5px "JetBrains Mono", monospace';
          ctx.fillText(`T=${formatPeriodSec(1 / comp.actualHz)}`, 6, centerY + 3);
          ctx.fillStyle = comp.invert ? '#fb7185' : colors[i];
          ctx.fillText(`${driveLabels[ch.drive] || '8mA'}/R${comp.rDiv || 1}${comp.invert ? ' INV' : ''}`, 6, centerY + 13);

          const totalPhaseDeg = comp.phaseDeg + (comp.invert ? 180 : 0);
          const phaseRad = (totalPhaseDeg * Math.PI) / 180;

          let cyclesAcrossScreen;
          let scrollPhaseOffset;
          if (isLogMode) {
            if (isPairCoupled && (i === 0 || i === 1)) {
              cyclesAcrossScreen = 3.0;
              scrollPhaseOffset = state.scopePhase;
            } else {
              const logNorm = Math.max(0, Math.min(1, Math.log10(Math.max(1000, comp.actualHz) / 8000) / Math.log10(160000000 / 8000)));
              cyclesAcrossScreen = 1.5 + logNorm * 10.5;
              scrollPhaseOffset = state.scopePhase * (0.5 + logNorm * 2.5);
            }
          } else {
            cyclesAcrossScreen = comp.actualHz * windowSec;
            if (state.scopeTriggered) {
              // Rising-edge trigger locked at Division 1 (t = 0) so every frequency change
              // immediately shows exact pulse width and edge positions even at 1–2 ns/div
              scrollPhaseOffset = 0;
            } else {
              // Shared physical time shift in Free-Run mode (exact relative channel speeds)
              const tShiftSec = (state.scopePhase / (2 * Math.PI)) * (windowSec / 4);
              scrollPhaseOffset = 2 * Math.PI * comp.actualHz * tShiftSec;
            }
          }

          // Peak-detect RF Band rendering when cycles exceed pixel Nyquist resolution
          if (!isLogMode && cyclesAcrossScreen > drawW * 0.42) {
            const topY = centerY - amp;
            const botY = centerY + amp;
            ctx.fillStyle = fillColors[i];
            ctx.fillRect(startX, topY, drawW, amp * 2);

            // Subtle high-frequency vertical carrier shimmer
            ctx.strokeStyle = colors[i];
            ctx.globalAlpha = 0.35;
            ctx.lineWidth = 1;
            const shimmerOffset = (state.scopePhase * 12) % 3;
            ctx.beginPath();
            for (let px = shimmerOffset; px <= drawW; px += 3) {
              ctx.moveTo(startX + px, topY);
              ctx.lineTo(startX + px, botY);
            }
            ctx.stroke();
            ctx.globalAlpha = 1.0;

            // Crisp top & bottom peak-detect envelope rails
            ctx.lineWidth = 1.6;
            ctx.beginPath();
            ctx.moveTo(startX, topY); ctx.lineTo(startX + drawW, topY);
            ctx.moveTo(startX, botY); ctx.lineTo(startX + drawW, botY);
            ctx.stroke();

            // Readable RF density badge
            const badgeText = `HF BAND: ${formatCyclesCount(cyclesAcrossScreen)} cyc (zoom Time/Div)`;
            ctx.font = '600 9px "JetBrains Mono", monospace';
            const tw = ctx.measureText(badgeText).width + 10;
            const bx = startX + (drawW - tw) / 2;
            const by = centerY - 7;
            ctx.fillStyle = 'rgba(9, 13, 22, 0.85)';
            ctx.fillRect(bx, by, tw, 14);
            ctx.strokeStyle = colors[i];
            ctx.lineWidth = 0.8;
            ctx.strokeRect(bx, by, tw, 14);
            ctx.fillStyle = colors[i];
            ctx.fillText(badgeText, bx + 5, centerY + 3);
            continue;
          }

          ctx.strokeStyle = colors[i];
          ctx.lineWidth = 1.8;
          ctx.beginPath();

          let prevHigh = null;
          const stepPx = cyclesAcrossScreen > 25 ? 0.5 : 1;
          for (let px = 0; px <= drawW; px += stepPx) {
            const normX = px / drawW;
            const xRel = (!isLogMode && state.scopeTriggered) ? (normX - trigNormX) : normX;
            const ssJitter = (ch.mode === 'spread') ? Math.sin(normX * Math.PI * 2 + state.scopePhase * 0.35) * 0.35 * Math.abs(xRel) * 3 : 0;
            const angle = (xRel * cyclesAcrossScreen * 2 * Math.PI) - scrollPhaseOffset - phaseRad + ssJitter;
            const isHigh = Math.sin(angle) >= 0;
            const y = isHigh ? (centerY - amp) : (centerY + amp);

            if (px === 0) ctx.moveTo(startX + px, y);
            else {
              if (isHigh !== prevHigh) ctx.lineTo(startX + px, prevHigh ? (centerY - amp) : (centerY + amp));
              ctx.lineTo(startX + px, y);
            }
            prevHigh = isHigh;
          }
          ctx.stroke();

          // Subtle cycle count / slow-signal indicator on right edge
          if (!isLogMode) {
            const cycLabel = cyclesAcrossScreen < 0.08
              ? `${formatCyclesCount(cyclesAcrossScreen)} cyc (zoom out)`
              : `${formatCyclesCount(cyclesAcrossScreen)} cyc`;
            ctx.font = '400 9px "JetBrains Mono", monospace';
            const tw = ctx.measureText(cycLabel).width + 6;
            ctx.fillStyle = 'rgba(9, 13, 22, 0.72)';
            ctx.fillRect(startX + drawW - tw - 2, centerY - amp + 1, tw, 12);
            ctx.fillStyle = '#94a3b8';
            ctx.fillText(cycLabel, startX + drawW - tw + 1, centerY - amp + 10);
          }
        }

        ctx.restore();
        if (!state.scopePaused) state.scopePhase += 0.045;
        requestAnimationFrame(draw);
      }

      requestAnimationFrame(draw);
    }

    function onScopeTimebaseChange(val) {
      state.scopeTimebase = val;
    }

    function toggleScopeTrigger() {
      state.scopeTriggered = !state.scopeTriggered;
