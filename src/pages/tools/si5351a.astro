          : 'px-1.5 py-0.2 text-[10px] font-mono bg-lab-card hover:bg-slate-800 border border-lab-border rounded text-slate-300';
      }
    }

    function toggleScopePause() {
      state.scopePaused = !state.scopePaused;
      document.getElementById('scope-pause-btn').textContent = state.scopePaused ? 'Resume' : 'Pause';
