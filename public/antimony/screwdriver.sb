            ],
            "name": "c0",
            "script": [
                "# Neil Gershenfeld 1/24/15\r",
                "# Matt Keeter 6/11/18\r",
                "\r",
                "import fab\r",
                "import math\r",
                "\r",
                "title('Circle (center)')\r",
                "\r",
                "input('x0',float)\r",
                "input('y0',float)\r",
                "input('r',float)\r",
                "input('_a',float)\r",
                "\r",
                "output('shape', fab.shapes.circle(x0, y0, r))\r",
                "\r",
                "def drag_r(this,x,y,z):\r",
                "    dx = x - this.x0\r",
                "    dy = y - this.y0\r",
                "    this.r = math.sqrt(dx**2 + dy**2)\r",
                "    this._a = math.atan2(dy, dx)\r",
                "\r",
                "# UI\r",
                "sb.ui.wireframe([\r",
                "    (math.cos(i/36. * 2*math.pi) * r + x0,\r",
                "     math.sin(i/36. * 2*math.pi) * r + y0, 0)\r",
                "    for i in range(36)], close=True)\r",
                "sb.ui.point(x0,y0)\r",
                "sb.ui.point(x0 + r*math.cos(_a),\r",
                "             y0 + r*math.sin(_a),\r",
                "             drag=drag_r, relative=False)\r",
                "\r",
                ""
            ],
            "uid": 0
        },
