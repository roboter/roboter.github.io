            ],
            "inspector": [
                356.57673790948854,
                103.2746716450182
            ],
            "name": "r2",
            "script": [
                "import fab\r",
                "import math\r",
                "\r",
                "title('Rotate (X)')\r",
                "\r",
                "input('_x', float)\r",
                "input('y', float)\r",
                "input('z', float)\r",
                "input('a', float)\r",
                "\r",
                "input('shape', fab.types.Shape)\r",
                "output('rotated', fab.shapes.rotate_x(shape, a, y, z))\r",
                "\r",
                "# UI\r",
                "rad = math.radians(a)\r",
                "sb.ui.wireframe([(_x, y + math.cos(rad), z + math.sin(rad)),\r",
                "                  (_x, y, z),\r",
                "                  (_x, y + 1, z)], color=sb.color.teal)\r",
                "\r",
                "# Draw a semi-circular arc showing the rotation\r",
                "if int(a) % 360 != 0:\r",
                "    sb.ui.wireframe([\r",
                "        (_x, y + math.cos(math.radians(a_)) * 0.3,\r",
                "             z + math.sin(math.radians(a_)) * 0.3)\r",
                "        for a_ in range(int(a) % 360)], color=sb.color.teal)\r",
                "\r",
                "sb.ui.point(_x, y, z, color=sb.color.teal)\r",
                "\r",
                "def drag_pt(this, x, y, z):\r",
                "    this.a = math.degrees(math.atan2(z - this.z, y - this.y))\r",
                "sb.ui.point(_x, y + math.cos(rad), z + math.sin(rad),\r",
                "             color=sb.color.teal, drag=drag_pt, relative=False)\r",
                "\r",
                ""
            ],
            "uid": 6
        }
